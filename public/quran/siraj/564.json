[[0,1,2,"رَأَوْهُ زُلْفَةً","رَأَوْا عَذَابَ اللهِ قَرِيبًا."],[0,3,1,"سِيئَتْ","ذَلَّتْ، وَاسْوَدَّتْ."],[0,12,1,"تَدَّعُونَ","تَطْلُبُونَ أَنْ يُعَجَّلَ لَكُمْ مِنَ العَذَابِ اسْتِهْزَاءً."],[1,10,1,"يُجِيرُ","يَحْمِي."],[3,1,1,"أَرَأَيْتُمْ","أَخْبِرُونِي."],[3,5,1,"غَوْرًا","ذَاهِبًا فِي الأَرْضِ لَا تَصِلُونَ إِلَيْهِ بِوَسِيلَةٍ."],[3,9,1,"مَّعِينٍ","جَارٍ عَلَى وَجْهِ الأَرْضِ، ظَاهِرٍ لِلْعُيُونِ."],[4,1,1,"وَالْقَلَمِ","قَسَمٌ بِالقَلَمِ الَّذِي تَكْتُبُ بِهِ المَلَائِكَةُ، وَالنَّاسُ."],[4,2,2,"وَمَا يَسْطُرُونَ","وَالَّذِي يَكْتُبُونَهُ بِالقَلَمِ."],[6,4,1,"مَمْنُونٍ","مَنْقُوصٍ، وَلَا مُنْقَطِعٍ."],[9,0,2,"بِأَييِّكُمُ الْمَفْتُونُ","فَي أَيِّ الفَرِيقَيْنِ الفِتْنَةُ، وَالجُنُونُ؟"],[12,2,1,"تُدْهِنُ","تُلَايِنُ، وَتُصَانِعُ."],[13,3,1,"حَلَّافٍ","كَثِيرِ الحَلِفِ."],[13,4,1,"مَّهِينٍ","كَذَّابٍ، حَقِيرٍ."],[14,0,1,"هَمَّازٍ","مُغْتَابٍ لِلنَّاسِ."],[14,1,2,"مَّشَّاءٍ بِنَمِيمٍ","يَمْشِي بِالنَّمِيمَةِ، وَهِيَ: نَقْلُ الحَدِيثِ بَيْنَ النَّاسِ عَلَى وَجْهِ الإِفْسَادِ."],[16,0,1,"عُتُلٍّ","فَاحِشٍ، لَئِيمٍ، غَلِيظٍ فيِ كُفْرِهِ."],[16,3,1,"زَنِيمٍ","مَنْسُوبٍ لِغَيْرِ أَبِيهِ."],[17,0,2,"أَن كَانَ","مِنْ أَجْلِ أَنَّهُ كَانَ."],[18,5,2,"أَسَاطِيرُ الْأَوَّلِينَ","أَبَاطِيلُهُمْ، وَخُرَافَاتُهُمْ."],[19,0,1,"سَنَسِمُهُ","سَنَجْعَلُ لَهُ عَلَامَةً لَا تُفَارِقُهُ."],[19,2,1,"الْخُرْطُومِ","أَنْفِهِ."]]