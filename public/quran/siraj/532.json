[[0,0,2,"مَرَجَ الْبَحْرَيْنِ","خَلَطَ مَاءَ البَحْرَيْنِ: العَذْبَ، وَالمَالِحَ."],[1,1,1,"بَرْزَخٌ","حَاجِزٌ."],[1,2,2,"لَّا يَبْغِيَانِ","لَا يَطْغَى أَحَدُهُمَا عَلَى الآخَرِ، وَيَذْهَبُ بِخَصَائِصِهِ."],[5,1,1,"الْجَوَارِ","السُّفُنُ الجَارِيَةُ الضَّخْمَةُ."],[5,2,1,"الْمُنشَآتُ","المَرْفُوعُاتُ الأَشْرِعَةِ."],[5,5,1,"كَالْأَعْلَامِ","كَالجِبَالِ فيِ عِظَمِهَا."],[7,3,1,"فَانٍ","هَالِكٌ."],[8,3,2,"ذُو الْجَلَالِ","صَاحِبُ العَظَمَةِ، وَالكِبْرِيَاءِ."],[8,5,1,"وَالْإِكْرَامِ","الفَضْلِ، وَالجُودِ."],[10,8,2,"فِي شَانٍ","أَيْ: أَمْرٍ فَيُعِزُّ وَيُذِلُّ، وَيُعْطِي وَيَمْنَعُ، وَيُحْيِي وَيُمِيتُ."],[14,6,1,"تَنفُذُوا","تَجِدُونَ مَنْفَذًا تَهْرُبُونَ مِنْهُ."],[14,8,1,"أَقْطَارِ","نَوَاحِي."],[14,11,1,"فَانفُذُوا","اهْرُبُوا (أَمْرَ تَعجِيزٍ)."],[14,15,1,"بِسُلْطَانٍ","بِقُوَّةٍ، وَكَمَالِ قُدْرَةٍ."],[16,2,1,"شُوَاظٌ","لَهَبٌ خَالِصٌ."],[16,5,1,"وَنُحَاسٌ","نُحَاسٌ مُذَابٌ، يُصَبُّ عَلَى رُؤُوسِكُمْ، أَوْ دُخَانٌ لَا لَهَبَ فِيهِ."],[16,6,2,"فَلَا تَنتَصِرَانِ","فَلا يَنْصُرُ بَعْضُكُمْ بَعْضًا."],[18,4,1,"وَرْدَةً","حَمْرَاءَ كَلَوْنِ الوَرْدِ."],[18,5,1,"كَالدِّهَانِ","كَالزَّيْتِ المَغْلِيِّ، أَوْ كَالجِلْدِ الأَحْمَرِ."],[22,2,1,"بِسِيمَاهُمْ","بِعَلَامَاتِهِمْ."],[22,3,2,"فَيُؤْخَذُ بِالنَّوَاصِي","تَاخُذُهُمْ مَلَائِكَةُ العَذَابِ بِمُقَدِّمَةِ رُؤُوسِهِمْ، وَأَقْدَامِهِمْ فَتَرْمِيهِمْ فِي النَّارِ."]]