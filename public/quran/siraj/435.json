[[1,6,2,"فَلَا تَغُرَّنَّكُمُ","لَا تَخْدَعَنَّكُمْ، وَلَا تُلْهِيَنَّكُمْ."],[1,13,1,"الْغَرُورُ","الشَّيْطَانُ."],[2,8,1,"حِزْبَهُ","أَتْبَاعَهُ."],[4,15,3,"فَلَا تَذْهَبْ نَفْسُكَ","فَلَا تُهْلِكْهَا."],[4,19,1,"حَسَرَاتٍ","حُزْنًا عَلَى كُفْرِ هَؤْلَاءِ الضَّالِّينَ."],[5,4,1,"فَتُثِيرُ","تُحَرِّكُ."],[5,9,1,"مَّيِّتٍ","مُجْدِبٍ."],[6,3,1,"الْعِزَّةَ","الشَّرَفَ، وَالمَنَعَةَ."],[6,9,2,"الْكَلِمُ الطَّيِّبُ","الكَلَامُ الحَسَنُ؛ وَهُوَ ذِكْرُ اللهِ."],[6,23,1,"يَبُورُ","يَفْسُدُ، وَيَبْطُلُ."],[7,9,1,"أَزْوَاجًا","ذُكُورًا وَإِنَاثًا."],[7,21,1,"مُّعَمَّرٍ","طَوِيلِ العُمُرِ."],[7,27,2,"فِي كِتَابٍ","هُوَ: اللَّوْحُ المَحْفُوظُ."]]