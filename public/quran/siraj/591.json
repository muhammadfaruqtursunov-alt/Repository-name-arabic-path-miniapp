[[0,1,1,"وَالطَّارِقِ","النَّجْمِ الَّذِي يَطْلُعُ لَيْلًا."],[2,1,1,"الثَّاقِبُ","المُضِيءُ المُتَوَهِّجُ."],[3,0,4,"إِنْ كُلُّ نَفْسٍ لَّمَّا","مَا كُلُّ نَفْسٍ إِلَّا."],[3,5,1,"حَافِظٌ","مَلَكٌ يَحْفَظُ أَعْمَالَهَا."],[5,3,1,"دَافِقٍ","مُنْصَبٍّ بِسُرْعَةٍ فِي الرَّحِمِ."],[6,3,1,"الصُّلْبِ","الظَّهْرِ."],[6,4,1,"وَالتَّرَائِبِ","عِظَامِ الصَّدْرِ."],[7,2,1,"رَجْعِهِ","رَدِّهِ حَيًّا بَعْدَ المَوْتِ."],[8,1,2,"تُبْلَى السَّرَائِرُ","تُخْتَبَرُ، وَتُكْشَفُ ضَمَائِرُ القُلُوبِ."],[10,1,2,"ذَاتِ الرَّجْعِ","صَاحِبَةِ المَطَرِ المُتَكَرِّرِ."],[11,1,2,"ذَاتِ الصَّدْعِ","ذَاتِ التَّشَقُّقِ بِالنَّبَاتِ."],[12,2,1,"فَصْلٌ","فَاصِلٌ بَيْنَ الحَقِّ، وَالبَاطِلِ."],[16,3,1,"رُوَيْدًا","قَلِيلًا."],[17,0,3,"سَبِّحِ اسْمَ رَبِّكَ","نَزِّهْ رَبَّكَ ذَاكِرًا اسْمَهُ بِلِسَانِكَ."],[17,3,1,"الْأَعْلَى","الَّذِي لَهُ عُلُوُّ الذَّاتِ، وَعُلُوَّ القَدْرِ، وَعُلُوُّ القَهْرِ."],[18,2,1,"فَسَوَّى","أَتْقَنَ خَلْقَهُ، وَأَحْسَنَهُ."],[19,2,1,"فَهَدَى","يَسَّرَ لَهُ مَا يُنَاسِبُهُ."],[20,2,1,"الْمَرْعَى","الكَلَأَ الأَخْضَرَ."],[21,1,1,"غُثَاءً","هَشِيمًا جَافًّا."],[21,2,1,"أَحْوَى","مُتَغَيِّرًا."],[23,0,4,"إِلَّا مَا شَاءَ اللَّهُ","إِلَّا مَا أَرادَ اللهُ أَنْ يَنْسَخَ تِلَاوَتَهُ وَحُكْمَهُ، وَيُنْسِيَكَ إِيَّاهُ."],[24,1,1,"لِلْيُسْرَى","لِلطَّرِيقَةِ المُيَسَّرَةِ فِي شَرِيعَتِكَ، وَحَيَاتِكَ."]]