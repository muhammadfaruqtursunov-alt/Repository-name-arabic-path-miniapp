[[0,1,3,"مِنْ حَيْثُ سَكَنتُم","قِبَلَ سُكْنَاكُمْ."],[0,4,2,"مِّن وُجْدِكُمْ","عَلَى قَدْرِ وُسْعِكُمْ، وَطَاقَتِكُمْ."],[0,12,1,"أُولَاتِ","ذَوَاتِ."],[0,24,1,"وَاتَمِرُوا","وَلْيَامُرْ بَعْضُكُمْ بَعْضًا."],[0,26,1,"بِمَعْرُوفٍ","بِمَا عُرِفَ مِنْ سَمَاحَةٍ، وَطِيبِ نَفْسٍ."],[0,28,1,"تَعَاسَرْتُمْ","تَشَاحَحْتُمْ فِي الإِرْضَاعِ فَامْتَنَعَ الأَبُ مِنَ الأُجْرَةِ، وَالأُمُّ مِنَ الرَّضَاعِ."],[1,6,1,"قُدِرَ","ضُيِّقَ."],[2,0,1,"وَكَأَيِّن","كَثِيرٌ."],[2,3,1,"عَتَتْ","عَصَتْ، وَتَجَبَّرَتْ."],[2,13,1,"نُّكْرًا","مُنْكَرًا عَظِيمًا."],[3,1,2,"وَبَالَ أَمْرِهَا","سُوءَ عَاقِبَةِ عُتُوِّهِمْ، وَكُفْرِهِمْ."]]