[[0,13,1,"يَسُومُونَكُمْ","يُذِيقُونَكُمْ."],[1,1,1,"تَأَذَّنَ","أَعْلَمَ إِعْلَامًا مُؤَكَّدًا."],[3,20,4,"فَرَدُّوا أَيْدِيَهُمْ فِي أَفْوَاهِهِمْ","عَضُّوا أَيْدِيَهُمْ؛ تَغَيُّظًا عَلَى الرُّسُلِ وَدِينِهِمْ."],[3,36,1,"مُرِيبٍ","مُوجِبٍ لِلرِّيبَةِ، وَالشَّكِّ."],[4,5,1,"فَاطِرِ","مُنْشِئِ ومُبْدِعِ."],[4,31,1,"بِسُلْطَانٍ","بِحُجَّةٍ، وَدَلِيلٍ."]]