[[0,3,1,"خُلُقُ","دِينُ، وَعَادَةُ."],[11,2,2,"طَلْعُهَا هَضِيمٌ","ثَمَرُهَا يَانِعٌ لَيِّنٌ نَضِيجٌ."],[12,4,1,"فَارِهِينَ","مَاهِرِينَ بِنَحْتِهَا أَشِرِينَ بَطِرِينَ."],[14,3,1,"الْمُسْرِفِينَ","المُتَمَادِينَ فيِ مَعْصِيَةِ اللهِ."],[16,4,1,"الْمُسَحَّرِينَ","المَغْلُوبِ عَلَى عُقُولِهِمْ بِكَثْرَةِ السِّحْرِ."],[18,4,1,"شِرْبُ","نَصِيبٌ مِنَ المَاءِ."],[20,0,1,"فَعَقَرُوهَا","نَحَرُوهَا."]]