[[2,2,2,"كِتَابَ الفُجَّارِ","كِتَابَ أَعْمَالِهِمْ، أَوْ مَصِيرَهُمِ."],[2,5,1,"سِجِّينٍ","سِجْنٍ، وَضِيقٍ."],[4,1,1,"مَّرْقُومٌ","مَكْتُوبٌ كَالرَّقْمِ فِي الثَّوْبِ لَا يُمْحَى."],[7,5,1,"مُعْتَدٍ","ظَالِمِ مُتَجَاوِزٍ لِلْحَدِّ."],[7,6,1,"أَثِيمٍ","كَثِيرِ الإِثْمِ."],[8,5,1,"أَسَاطِيرُ","أَبَاطِيلُ"],[9,2,1,"رَانَ","غَطَّى."],[10,5,1,"لَّمَحْجُوبُونَ","مَحْرُومُونَ مِنْ رُؤْيَةِ رَبِّهِمْ."],[11,2,2,"لَصَالُوا الْجَحِيمِ","لَدَاخِلُو النَّارِ يُقَاسُونَ حَرَّهَا."],[13,4,2,"لَفِي عِلِّيِّينَ","لَفِي مَرْتَبَةٍ، وَمَكَانٍ عَالٍ."],[18,1,1,"الْأَرَائِكِ","الأَسِرَّةِ المُزَيَّنَةِ بِالسُّتُورِ، وَالثِّيَابِ."],[19,3,1,"نَضْرَةَ","بَهْجَةَ."],[20,2,1,"رَّحِيقٍ","خَمْرٍ صَافِيَةٍ."],[21,0,2,"خِتَامُهُ مِسْكٌ","آخِرُهُ رَائِحَةُ المِسْكِ."],[22,0,1,"وَمِزَاجُهُ","خَلْطُهُ."],[22,2,1,"تَسْنِيمٍ","عَيْنٍ فيِ أَعْلَى الجَنَّةِ."],[23,1,2,"يَشْرَبُ بِهَا","يَشْرَبُونَ مُتَلَذِّذِينَ بِهَا."],[25,3,1,"يَتَغَامَزُونَ","يَغْمِزُ بَعْضُهُمْ بَعْضًا بِأَعْيُنِهِمُ اسْتِهْزَاءً."],[26,1,1,"انقَلَبُوا","رَجَعُوا."],[26,5,1,"فَكِهِينَ","مُتَلَذِّذِينَ بِسُخْرِيَتِهِمْ مِنَ المَؤْمِنِينَ."],[28,3,1,"حَافِظِينَ","رُقَبَاءَ يُحْصُونَ أَعْمَالَهُمْ."]]