[[0,1,1,"أَنقَضَ","أَثْقَلَ."],[4,1,1,"فَرَغْتَ","مِنْ أَشْغَالِ الدُّنْيَا."],[4,2,1,"فَانصَبْ","فَجِدَّ فيِ العِبَادَةِ."],[5,2,1,"فَارْغَبْ","فَتَوَجَّهْ، وَاطْلُبْ، وَتَضَرَّعْ."],[7,0,2,"وَطُورِ سِينِينَ","جَبَلِ طُورِ سَيْنَاءَ الَّذِي كَلَّمَ اللهُ عَلَيْهِ مُوسَى - عليه السلام -."],[8,0,2,"وَهَذَا الْبَلَدِ","مَكَّةَ."],[9,5,1,"تَقْوِيمٍ","صُورَةٍ."],[10,2,2,"أَسْفَلَ سَافِلِينَ","النَّارَ؛ إِنْ لَمْ يُطِعِ اللهَ."],[11,7,2,"غَيْرُ مَمْنُونٍ","غَيْرُ مَقْطُوعٍ، وَلَا مَنْقُوصٍ."],[12,3,1,"بِالدِّينِ","بِالبَعْثِ، وَالجَزَاءِ."],[15,3,1,"عَلَقٍ","قِطْعَةِ دَمٍ غَلِيظٍ."],[19,0,1,"كَلَّا","حَقًّا."],[19,3,1,"لَيَطْغَى","لَيَتَجَاوُزُ الحَدَّ فِي العِصْيَانِ، وَالكِبْرِ."],[20,0,3,"أَنْ رَّآهُ اسْتَغْنَى","بِسَبَبِ أَنْ رَأَى نَفْسَهُ مُسْتَغِنيًا بِمَالِهِ."],[21,3,1,"الرُّجْعَى","الرُّجُوعَ، وَالمَصِيرَ."],[22,0,1,"أَرَأَيْتَ","أَلَا تَعْجَبُ!!"]]