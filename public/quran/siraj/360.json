[[0,21,1,"نُشُورًا","بَعْثًا بَعْدَ المَوْتِ."],[1,6,2,"إِفْكٌ افْتَرَاهُ","كَذِبٌ اخْتَرَعَهُ مِنْ عِنْدِ نَفْسِهِ."],[1,15,1,"وَزُورًا","كَذِبًا شَنِيعًا."],[2,1,2,"أَسَاطِيرُ الْأَوَّلِينَ","أَحَادِيثُ الأُمَمِ القَدِيمَةِ المُسَطَّرَةُ فِي كُتُبِهِمْ."],[2,7,2,"بُكْرَةً وَأَصِيلًا","أَوَّلَ النَّهَارِ، وَآخِرَهُ."],[5,7,1,"جَنَّةٌ","بُسْتَانٌ مُثْمِرٌ."],[6,2,3,"ضَرَبُوا لَكَ الْأَمْثَالَ","قَالُوا فِي حَقِّكَ الأَقْوَالَ العَجِيبَةَ الَّتِي تُشْبِهُ لِغَرَابَتِهَا الأَمْثَالَ."],[8,7,1,"سَعِيرًا","نَارًا حَارَّةً تُسَعَّرُ بِهِمْ."]]