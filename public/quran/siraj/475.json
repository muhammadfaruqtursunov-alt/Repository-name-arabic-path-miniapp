[[0,10,1,"عَلَقَةٍ","الدَّمِ الغَلِيظِ؛ المُتَعَلِّقِ بِجِدَارِ الرَّحِمِ، وَهُوَ أَحَدُ أَطْوَارِ الجَنِينِ."],[0,15,2,"لِتَبْلُغُوا أَشُدَّكُمْ","لِتَتَكَامَلَ قُوَّتُكُمْ."],[0,26,2,"أَجَلًا مُّسَمًّى","مُدَّةً مُقَدَّرَةً تَنْتَهِي بِهَا أَعْمَارُكُمْ."],[2,8,2,"أَنَّى يُصْرَفُونَ","كَيْفَ يَعْدِلُونَ عَنْهَا مَعْ صِحَّتِهَا؟!"],[3,2,1,"بِالْكِتَابِ","بِالقُرْآنِ."],[4,4,1,"وَالسَّلَاسِلُ","القُيُودُ فِي الأَرْجُلِ."],[5,1,1,"الْحَمِيمِ","المَاءِ الَّذِي بَلَغَ غَايَةَ الحَرَارَةِ."],[5,5,1,"يُسْجَرُونَ","يُوقَدُ عَلَيْهِمْ."],[7,4,2,"ضَلُّوا عَنَّا","غَابُوا عَنْ عُيُونِنَا."],[8,10,1,"تَمْرَحُونَ","تَتَوَسَّعُونَ فيِ الفَرَحِ أَشَرًا وَبَطَرًا."],[9,6,1,"مَثْوَى","مَاوَى، وَمَسْكَنُ."]]