[[0,0,1,"فَقُتِلَ","غُلِبَ وَقُهِرَ."],[2,1,1,"نَظَرَ","تَأَمَّلَ فِيمَا هَيَّأَ مِنَ الطَّعْنِ."],[3,1,1,"عَبَسَ","قَطَّبُ وَجْهَهُ."],[3,2,1,"وَبَسَرَ","اشْتَدَّ فيِ العُبُوسِ لَمَّا ضَاقَتْ عَلَيْهِ الحِيَلُ فِي الطَّعْنِ."],[4,1,1,"أَدْبَرَ","رَجَعَ مُعْرِضًا عَنِ الحَقِّ."],[5,5,1,"يُؤْثَرُ","يُنْقَلُ عَنِ الأَوَّلِينَ."],[7,0,2,"سَأُصْلِيهِ سَقَرَ","سَأُدْخِلُهُ جَهَنَّمَ؛ كَيْ يَصْلَى حَرَّهَا."],[9,0,2,"لَا تُبْقِي","لَا تَتْرُكُ لَحْمًا."],[9,2,2,"وَلَا تَذَرُ","لَا تَتْرُكُ عَظْمًا."],[10,0,2,"لَوَّاحَةٌ لِّلْبَشَرِ","مُحْرِقَةٌ لِلْجُلُودِ، مُغَيِّرَةٌ لِلْبَشَرَةِ."],[12,10,1,"فِتْنَةً","اخْتِبَارًا لِلْكُفَّارِ."],[12,21,2,"وَلَا يَرْتَابَ","لَا يَشُكَّ."],[12,31,1,"مَّرَضٌ","نِفَاقٌ."],[12,48,2,"جُنُودَ رَبِّكَ","مَلَائِكَتَهُ."],[16,0,3,"إِنَّهَا لَإِحْدَى الْكُبَرِ","إِنَّ النَّارَ لَإِحْدَى العَظَائِمِ."],[19,4,1,"رَهِينَةٌ","مَحْبُوسَةٌ بِعَمَلِهَا."],[23,0,2,"مَا سَلَكَكُمْ","مَا أَدْخَلَكُمْ."],[26,1,1,"نَخُوضُ","نَتَحَدَّثُ بِالبَاطِلِ."],[28,2,1,"الْيَقِينُ","المُوْتُ."]]