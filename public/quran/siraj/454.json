[[0,7,2,"ذَا الْأَيْدِ","صَاحِبَ القَوَّةِ عَلَى الطَّاعَةِ، وَفِي الحَرْبِ."],[0,10,1,"أَوَّابٌ","كَثِيرُ الرُّجُوعِ إِلَى مَا يُرْضِي اللهَ."],[1,5,1,"بِالْعَشِيِّ","آخِرِ النَّهَارِ."],[1,6,1,"وَالْإِشْرَاقِ","أَوَّلِ النَّهَارِ."],[2,1,1,"مَحْشُورَةً","مَجْمُوعَةً."],[2,4,1,"أَوَّابٌ","مُطِيعٌ."],[3,0,2,"وَشَدَدْنَا مُلْكَهُ","قَوَّيْنَا مُلْكَهُ بِالهَيْبَةِ، وَالتَّمْكِينِ، وَالنَّصْرِ."],[3,3,1,"الْحِكْمَةَ","النُّبَّوةَ."],[3,4,2,"وَفَصْلَ الْخِطَابِ","البَيَانَ الشَّافِيَ وَالفَصْلَ فِي الكَلَامِ وَالحُكْمِ."],[4,2,1,"نَبَأُ","خَبَرُ."],[4,3,1,"الْخَصْمِ","المُتَخَاصِمِينَ."],[4,6,1,"الْمِحْرَابَ","مَكَانَ عِبَادَتِهِ."],[5,4,1,"فَفَزِعَ","ارْتَاعَ."],[5,17,2,"وَلَا تُشْطِطْ","لَا تَجُرْ فِي حُكْمِكَ، وَلَا تَظْلِمْ."],[5,21,2,"سَوَاءَ الصِّرَاطِ","وَسَطِ الطَّرِيقِ الصَّوَابِ."],[6,11,1,"أَكْفِلْنِيهَا","أَعْطِنِيهَا، وَانْزِلْ لِي عَنْهَا."],[6,12,3,"وَعَزَّنِي فِي الْخِطَابِ","غَلَبَنِي فيِ الكَلَامِ، وَاشْتَدَّ عَلَيَّ فِيهِ."],[7,10,1,"الْخُلَطَاءِ","الشُّرَكَاءِ."],[7,11,1,"لَيَبْغِي","لَيَعْتَدِي."],[7,23,1,"وَظَنَّ","أَيْقَنَ."],[7,26,1,"فَتَنَّاهُ","ابْتَلَيْنَاهُ، وَامْتَحَنَّاهُ."],[7,29,2,"وَخَرَّ رَاكِعًا","سَجَدَ لِلهِ تَعَالَى."],[7,31,1,"وَأَنَابَ","رَجَعَ، وَتَابَ."],[8,6,1,"لَزُلْفَى","لَقُرْبَى وَمَكَانَةً."],[8,8,1,"مَآبٍ","مَرْجِعٍ."]]