[[0,20,1,"مَثْوًى","مَاوًى، وَمسْكَنٌ."],[1,0,3,"وَكَأَيِّن مِّن قَرْيَةٍ","كَثِيرٌ مِنَ القُرَى."],[3,0,1,"مَثَلُ","صِفَةُ."],[3,9,2,"غَيْرِ آسِنٍ","غَيْرِ مُتَغَيِّرٍ، وَلَا مُنْتِنٍ."],[3,41,1,"حَمِيمًا","بَالِغَ الغَايَةِ فِي الحَرَارَةِ."],[4,0,1,"وَمِنْهُم","مِنَ المُنَافِقِينَ."],[4,15,1,"آنِفًا","الآنَ."],[6,1,1,"يَنظُرُونَ","يَنْتَظِرُونَ."],[6,6,1,"بَغْتَةً","فَجْأَةً."],[6,8,2,"جَاءَ أَشْرَاطُهَا","ظَهَرَتْ عَلَامَاتُهَا."],[6,10,1,"فَأَنَّى","مِنْ أَيْنَ لَهُمْ؟!"],[6,14,1,"ذِكْرَاهُمْ","تَذَكُّرُهُمْ."],[7,12,1,"مُتَقَلَّبَكُمْ","تَصَرُّفَكُمْ فِي يَقَظَتِكُمْ نَهَارًا."],[7,13,1,"وَمَثْوَاكُمْ","مُسْتَقَرَّكُمْ فيِ نَوْمِكُمْ لَيْلًا."]]