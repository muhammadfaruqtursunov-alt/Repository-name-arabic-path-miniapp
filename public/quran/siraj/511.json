[[0,3,2,"فَتْحًا مُّبِينًا","هُوَ: صُلْحُ الحُدَيْبِيَةِ عَامَ سِتٍّ مِنَ الهِجْرَةِ."],[1,13,2,"صِرَاطًا مُّسْتَقِيمًا","طَرِيقًّا، وَدِينًا لَا عِوَجَ فِيهِ."],[2,3,1,"عَزِيزًا","قَوِيًّا لَا ضَعْفَ فِيهِ."],[3,3,1,"السَّكِينَةَ","الطُّمَانِينَةَ، وَالثَّبَاتَ."],[4,10,1,"وَيُكَفِّرَ","يَمْحُوَ."],[5,7,2,"ظَنَّ السَّوْءِ","الظَّنَّ السَّيِّئَ؛ وَهُوَ: الظَّنُّ بِأَنْ لَنْ يَنْصُرَ اللهُ دِينَهُ."],[5,9,3,"عَلَيْهِمْ دَائِرَةُ السَّوْءِ","دُعَاءٌ عَلَيْهِمْ بِأَنْ تَدُورَ عَلَيْهِمْ دَائِرَةُ العَذَابِ، وَكُلُّ مَا يَسُوءُ."],[5,20,1,"مَصِيرًا","مَنْزِلًا يَصِيرُونَ إِلَيْهِ."],[8,3,1,"وَتُعَزِّرُوهُ","تَنْصُرُوا اللهَ."],[8,4,1,"وَتُوَقِّرُوهُ","تُعَظِّمُوا اللهَ."],[8,6,2,"بُكْرَةً وَأَصِيلًا","أَوَّلَ النَّهَارِ، وَآخِرَهُ."]]