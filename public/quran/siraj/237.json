[[0,3,1,"وَأَجْمَعُوا","عَزَمُوا وَصَمَّمُوا."],[2,4,1,"نَسْتَبِقُ","نَتَسَابَقُ فِي الجَرْيِ، وَالرَّمْيِ بِالسِّهَامِ."],[2,13,2,"بِمُؤْمِنٍ لِّنَا","بِمُقِرٍّ لَنَا، وَمُصَدِّقٍ لَنَا."],[3,7,1,"سَوَّلَتْ","زَيَّنَتْ."],[3,11,2,"فَصَبْرٌ جَمِيلٌ","احْتِمَالٌ لِلمُصِيبَةِ لَا شَكْوَى مَعَهُ لِأَحَدٍ مِنَ الخَلْقِ."],[4,1,1,"سَيَّارَةٌ","جَمَاعَةٌ مِنَ المُسَافِرِينَ."],[4,3,1,"وَارِدَهُمْ","مَنْ يَتَقَدَّمُهُمْ لِطَلَبِ المَاءِ."],[4,4,2,"فَأَدْلَى دَلْوَهُ","فَأَرْسَلَ دَلْوَهُ فِي البِئْرِ؛ لِيَمْلَأَهَا بِالمَاءِ."],[4,10,2,"وَأَسَرُّوهُ بِضَاعَةً","كَتَمَ إِخْوَةُ يُوسُفَ كَوْنَهُ أَخَاهُمْ لِيَبِيعُوهُ."],[5,0,1,"وَشَرَوْهُ","بَاعَهُ إِخْوَتُهُ."],[5,2,1,"بَخْسٍ","قَلِيلٍ."],[6,7,1,"مَثْوَاهُ","مَقَامَهُ."],[7,2,1,"أَشُدَّهُ","مُنْتَهَى قُوَّتِهِ فِي شَبَابِهِ."]]