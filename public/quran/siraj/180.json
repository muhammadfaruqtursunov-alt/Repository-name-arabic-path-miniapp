[[0,9,1,"يَتَخَطَّفَكُمُ","يَاخُذَكُمُ الْكُفَّارُ بِسُرْعَةٍ."],[0,11,1,"فَآوَاكُمْ","أَسْكَنَكُمُ الْمَدِينَةَ."],[2,4,1,"فِتْنَةٌ","اخْتِبَارٌ، وَابْتِلَاءٌ؛ أَتُطِيعُونَهُ، وَتَشْكُرُونَهُ، أَمْ تَنْشَغِلُوَن بِهَا عَنْهُ؟"],[3,8,1,"فُرْقَانًا","مَخْرَجًا، وَنَجَاةً، وَهِدَايَةً، وَنُورًا."],[3,9,1,"وَيُكَفِّرْ","يَمْحُ."],[3,12,1,"وَيَغْفِرْ","يَسْتُرْ فَلَا يُؤَاخِذْ."],[4,5,1,"لِيُثْبِتُوكَ","لِيَحْبِسُوكَ."],[5,15,1,"أَسَاطِيرُ","أَكَاذِيبُ، وَحِكَايَاتُ."]]