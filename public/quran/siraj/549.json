[[0,7,1,"أَوْلِيَاءَ","خُلَصَاءَ وَأَحِبَّاءَ."],[0,8,1,"تُلْقُونَ","تُفْضُونَ."],[0,20,2,"أَن تُؤْمِنُوا","لِأَجْلِ إِيمَانِكُمْ."],[0,45,3,"ضَلَّ سَوَاءَ السَّبِيلِ","أَخْطَأَ طَرِيقَ الهُدَى."],[1,1,1,"يَثْقَفُوكُمْ","يَظْفَرُوا بِكُمْ."],[1,5,1,"وَيَبْسُطُوا","يَمُدُّوا."],[2,7,2,"يَفْصِلُ بَيْنَكُمْ","يُفَرِّقُ بَيْنَ المُطِيعِينَ، وَالعَاصِينَ."],[3,3,1,"أُسْوَةٌ","قُدْوَةٌ."],[3,13,1,"بُرَءَاؤُا","بَرِيئُونَ."],[3,32,3,"إِلَّا قَوْلَ إِبْرَاهِيمَ","لَكِنْ لَا تَقْتَدُوا بِإِبْرَاهِيمَ حِينَ قَالَ."],[3,49,1,"أَنَبْنَا","رَجَعْنَا بِالتَّوْبَةِ، وَالطَّاعَةِ."],[3,51,1,"الْمَصِيرُ","المَرْجِعُ."],[4,3,3,"فِتْنَةً لِّلَّذِينَ كَفَرُوا","بِعَذَابِكَ لَنَا، أَوْ تَسْلِيطِ الكُفَّارِ عَلَيْنَا، فَيَقُولُونَ: لَوْ كَانَ هَؤُلَاءِ عَلَى حَقٍّ، مَا أَصَابَهُمُ العَذَابُ، فَيَزْدَادُوا كُفْرًا."]]