[[0,9,1,"عَرْشٌ","سَرِيرٌ."],[2,0,2,"أَلَّا يَسْجُدُوا","زَيَّنَ لَهُمُ الشَّيْطَانُ ذَلِكَ لِئَلَّا يَسْجُدُوا."],[2,5,1,"الْخَبْءَ","المَخْبُوءَ المَسْتُورَ عَنِ الأَعْيُنِ."],[5,6,2,"تَوَلَّ عَنْهُمْ","تَنَحَّ عَنْهُمْ قَرِيبًا مِنْهُمْ."],[5,8,1,"فَانظُرْ","تَأَمَّلْ، وَاسْمَعْ."],[5,9,2,"مَاذَا يَرْجِعُونَ","مَا يَتَرَدَّدُ بَيْنَهُمْ مِنَ الكَلَامِ."],[6,2,1,"المَلَأُ","أَشْرَافُ النَّاسِ."],[6,7,1,"كَرِيمٌ","جَلِيلُ القَدْرِ."],[8,1,2,"تَعْلُوا عَلَيَّ","تَتَكَبَّرُوا عَلَيَّ."],[9,3,1,"أَفْتُونِي","أَشِيرُوا عَلَيَّ."],[9,8,2,"قَاطِعَةً أَمْرًا","قَاضِيَةً حُكْمًا وَفَاصِلَةً فِيهِ."],[9,11,1,"تَشْهَدُونِ","تَحْضُرُونِي."],[10,2,1,"أُوْلُوا","أَصْحَابُ."],[12,4,1,"فَنَاظِرَةٌ","مُنْتَظِرَةٌ."]]