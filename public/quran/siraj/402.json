[[0,10,2,"ظَلَمُوا مِنْهُمْ","عَانَدُوا الحَقَّ، وَأَعْلَنُوا الحَرْبَ."],[0,24,1,"مُسْلِمُونَ","خَاضِعُونَ مُتَذَلِّلُونَ بِالطَّاعَةِ."],[1,9,2,"وَمِنْ هَؤُلَاءِ","العَرَبِ مِنْ قُرَيْشٍ."],[4,1,1,"لَوْلَا","هَلَّا."],[4,4,1,"آيَاتٌ","حُجَجٌ وَبَرَاهِينُ نُشَاهِدُهَا؛ كَنَاقَةِ صَالِحٍ - عليه السلام -."]]