[[1,0,2,"أَتَّخَذْنَاهُمْ سِخْرِيًّا","هَلْ تَحْقِيرُنَا لَهُمْ خَطَأٌ؟"],[1,3,1,"زَاغَتْ","مَالَتْ، فَلَمْ تَقَعْ عَلَيْهِمْ."],[2,3,1,"تَخَاصُمُ","جِدَالُ."],[5,2,2,"نَبَأٌ عَظِيمٌ","القُرْآنُ خَبَرٌ عَظِيمُ النَّفْعِ."],[7,5,2,"بِالْمَلَإِ الْأَعْلَى","المَلَائِكَةِ."],[7,8,1,"يَخْتَصِمُونَ","يَتَجَادَلُونَ فِي شَانِ خَلْقِ آدَمَ - عليه السلام -."],[10,1,1,"سَوَّيْتُهُ","خَلَقْتُ جَسَدَهُ كَامِلًا مُتَنَاسِقَ الأَعْضَاءِ."],[10,8,1,"سَاجِدِينَ","سُجُودَ تَحِيَّةٍ وَإِكْرَامٍ، لَا سُجُودَ عِبَادَةٍ وَتَعْظِيمٍ."],[15,4,1,"رَجِيمٌ","مَرْجُومٌ مَطْرُودٌ مِنْ رَحْمَةِ اللهِ."],[16,2,1,"لَعْنَتِي","طَرْدِي، وَإِبْعَادِي."],[17,2,1,"فَأَنظِرْنِي","أَخِّرْنِي."],[20,1,1,"فَبِعِزَّتِكَ","بِسُلْطَانِكَ، وَعَظَمَتِكَ."],[20,2,1,"لَأُغْوِيَنَّهُمْ","لَأُضِلَّنَّهُمْ."],[21,3,1,"الْمُخْلَصِينَ","الَّذِينَ أَخْلَصْتَهُمْ، وَاصْطَفَيْتَهُمْ لِعِبَادَتِكَ."]]