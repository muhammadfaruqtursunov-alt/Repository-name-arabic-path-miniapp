[[0,6,2,"مَا أَظُنُّ","لَا أَعْتَقِدُ."],[0,9,1,"تَبِيدَ","تَهْلِكَ."],[1,11,1,"مُنْقَلَبًا","مَرْجِعًا وَمَرَدًّا."],[3,0,1,"لَّكِنَّا","لَكنْ أَنَا."],[5,9,1,"حُسْبَانًا","عَذَابًا."],[5,13,2,"صَعِيدًا زَلَقًا","أَرْضًا مَلْسَاءَ جَرْدَاءَ لَا تَثْبُتُ عَلَيْهَا قَدَمٌ، وَلَا تُنْبِتُ شَيْئًا."],[6,3,1,"غَوْرًا","غَائِرًا ذَاهِبًا فِي عُمْقِ الأَرْضِ."],[7,0,2,"وَأُحِيطَ بِثَمَرِهِ","أُهْلِكَتْ أَمْوَالُهُ، وَحَدِيقَتُهُ."],[7,3,2,"يُقَلِّبُ كَفَّيْهِ","كِنَايَةٌ عَنِ النَّدَامَةِ وَالحَسْرَةِ."],[7,10,3,"خَاوِيَةٌ عَلَى عُرُوشِهَا","سَاقِطَةٌ بَعْضُهَا عَلَى بَعْضٍ."],[8,3,1,"فِئَةٌ","جَمَاعَةٌ."],[9,8,1,"عُقْبًا","عَاقِبَةً."],[10,14,1,"هَشِيمًا","يَابِسًا مُتَكَسِّرًا."],[10,15,1,"تَذْرُوهُ","تَنْسِفُهُ الرِّيَاحُ إِلَى كُلِّ جِهَةٍ."]]