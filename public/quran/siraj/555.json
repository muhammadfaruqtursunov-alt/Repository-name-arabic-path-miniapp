[[0,8,2,"لَوَّوْا رُؤُوسَهُمْ","عَطَفُوهَا إِعْرَاضًا، وِاسْتِهْزَاءً."],[0,11,1,"يَصُدُّونَ","يُعْرِضُونَ."],[2,11,1,"يَنفَضُّوا","يَتَفَرَّقُوا عَنْهُ."],[3,2,1,"رَّجَعْنَا","مِنْ غَزْوَةِ بَنِي المُصْطَلِقِ."],[3,6,1,"الْأَعَزُّ","الأَقْوَى؛ يَعْنُونَ: أَنْفُسَهُمْ."],[3,8,1,"الْأَذَلَّ","الأَضْعَفَ وَالأَهْوَنَ؛ يَعْنُونَ: رَسُولَ اللهِ - صلى الله عليه وسلم -، وَمَنْ مَعَهُ."],[3,10,1,"الْعِزَّةُ","القُوَّةُ، وَالغَلَبَةُ."],[4,3,2,"لَا تُلْهِكُمْ","لَا تَشْغَلْكُمْ."],[5,12,2,"لَوْلَا أَخَّرْتَنِي","هَلَّا أَمْهَلْتَنِي، وَأَخَّرْتَ أَجَلِي."],[6,6,1,"أَجَلُهَا","وَقْتُ مَوْتِهَا."]]