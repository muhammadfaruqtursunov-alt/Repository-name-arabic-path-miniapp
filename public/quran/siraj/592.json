[[1,1,2,"يَصْلَى النَّارَ","يَدْخُلُهَا، وَيُقَاسِي حَرَّهَا."],[3,1,1,"أَفْلَحَ","فَازَ، وَظَفِرَ بِالمَطْلُوبِ."],[3,3,1,"تَزَكَّى","طَهَّرَ نَفْسَهُ مِنَ المَعَاصِي، وَحَلَّاهَا بِالطَّاعَةِ."],[7,0,2,"إِنَّ هَذَا","أَيْ: مِنْ قَوْلِهِ: {قَدْ أَفْلَحَ مَن تَزَكَّى}."],[9,3,1,"الْغَاشِيَةِ","القِيَامَةِ تَغْشَى النَّاسَ بِأَهْوَالِهَا."],[10,2,1,"خَاشِعَةٌ","ذَلِيلَةٌ مُنْكَسِرَةٌ."],[11,0,2,"عَامِلَةٌ نَّاصِبَةٌ","مُجْهَدَةٌ بِالعَمَلِ وَالتَّعَبِ فِي النَّارِ."],[12,0,2,"تَصْلَى نَارًا","تَدْخُلُ نَارًا، وَتُقَاسِي حَرَّهَا."],[12,2,1,"حَامِيَةً","شَدِيدَةَ التَّوَهُّجِ."],[13,3,1,"آنِيَةٍ","شَدِيدَةِ الحَرَارَةِ."],[14,5,1,"ضَرِيعٍ","نَبْتٍ خَبِيثٍ ذِي شَوْكٍ، لَا تَرْعَاهُ الدَّوَابُّ."],[17,0,1,"لِسَعْيِهَا","لِعَمَلِهَا بِالطَّاعَةِ فِي الدُّنْيَا."],[19,3,1,"لَاغِيَةً","لَا كَلِمَةَ لَغْوٍ وَاحِدَةً، وَلَا نَفْسًا تَلْغُو وَتَهْذِي."],[20,2,1,"جَارِيَةٌ","مُتَدَفِّقَةٌ بِالمَاءِ."],[22,1,1,"مَّوْضُوعَةٌ","مُعَدَّةٌ لِلشَّارِبِينَ."],[23,0,1,"وَنَمَارِقُ","وَسَائِدُ."],[24,0,2,"وَزَرَابِيُّ مَبْثُوثَةٌ","بُسُطٌ كَثِيرَةٌ مَفْرُوشَةٌ."],[28,3,1,"سُطِحَتْ","بُسِطَتْ، وَمُهِّدَتْ."],[30,2,1,"بِمُصَيْطِرٍ","بِمُتَسَلِّطٍ تُكْرِهُهُمْ عَلَى الإِيمَانِ."]]