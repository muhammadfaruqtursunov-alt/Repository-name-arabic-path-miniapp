[[0,3,2,"حَمَلْنَا ذُرِّيَّتَهُمْ","حَمَلْنَا مَنْ نَجَا مِنْ وَلَدِ آدَمَ - عليه السلام - فيِ سَفِينَةِ نُوحٍ - عليه السلام -."],[2,3,2,"فَلَا صَرِيخَ","فَلَا مُغِيثَ."],[8,0,2,"مَا يَنظُرُونَ","مَا يَنْتَظِرُونَ."],[8,3,2,"صَيْحَةً وَاحِدَةً","هِيَ: نَفْخَةُ الفَزَعِ عِنْدَ قِيَامِ السَّاعَةِ."],[8,7,1,"يَخِصِّمُونَ","يَخْتَصِمُونَ فِي شُؤُونِ حَيَاتِهِمْ."],[10,2,1,"الصُّورِ","القَرْنِ الَّذِي يَنْفُخُ فِيهِ إِسْرَافِيلُ - عليه السلام -."],[10,6,1,"الْأَجْدَاثِ","القُبُورِ."],[10,9,1,"يَنسِلُونَ","يُسْرِعُونَ فيِ الخُرُوجِ."],[11,5,1,"مَّرْقَدِنَا","قُبُورِنَا."],[12,3,2,"صَيْحَةً وَاحِدَةً","نَفْخَةً وَاحِدَةً فِي القَرْنِ."],[12,9,1,"مُحْضَرُونَ","مَاثِلُونُ لِلْحِسَابِ."]]