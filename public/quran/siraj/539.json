[[1,6,1,"انظُرُونَا","انْتَظِرُونَا."],[1,7,1,"نَقْتَبِسْ","نَاخُذْ، وَنُصِبْ."],[1,20,1,"بَاطِنُهُ","مِمَّا يَلِي المُؤْمِنِينَ."],[1,23,1,"وَظَاهِرُهُ","مِمَّا يَلِي المُنَافِقِينَ."],[2,7,1,"فَتَنتُمْ","أَهْلَكْتُمْ."],[2,9,1,"وَتَرَبَّصْتُمْ","تَرَقَّبْتُمْ حُصُولَ النَّوَائِبِ لِلنَّبِيِّ - صلى الله عليه وسلم -، وَالمُؤْمِنِينَ مَعَهُ."],[2,10,1,"وَارْتَبْتُمْ","شَكَكْتُمْ فيِ البَعْثِ."],[2,11,2,"وَغَرَّتْكُمُ الْأَمَانِيُّ","خَدَعَتْكُمُ الأَبَاطِيلُ."],[2,15,2,"أَمْرُ اللَّهِ","المَوْتُ."],[2,19,1,"الْغَرُورُ","الشَّيْطَانُ."],[3,4,1,"فِدْيَةٌ","عِوَضٌ لِيُفْتَدَى بِهِ مِنْ عَذَابِ اللهِ."],[3,9,1,"مَاوَاكُمُ","مَصِيرُكُمْ."],[3,12,1,"مَوْلَاكُمْ","أَوْلَى بِكُمْ."],[3,14,1,"الْمَصِيرُ","المَرْجِعُ."],[4,0,2,"أَلَمْ يَانِ","أَلَمْ يَحِنْ وَيَجِئِ الوَقْتُ؟!"],[4,5,1,"تَخْشَعَ","تَخْضَعَ، وَتَرِقَّ، وَتَلِينَ."],[4,22,1,"الْأَمَدُ","الزَّمَانُ."],[6,1,1,"الْمُصَّدِّقِينَ","المُتَصَدِّقِينَ."],[6,5,2,"قَرْضًا حَسَنًا","مُحْتَسِبِينَ فِي نَفَقَاتِهِمْ بِلَا مَنٍّ، وَلَا أَذًى."]]