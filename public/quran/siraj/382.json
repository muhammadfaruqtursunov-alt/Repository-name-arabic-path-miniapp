[[0,14,1,"يَتَطَهَّرُونَ","يَتَنَزَّهُونَ عَنْ إِتْيَانِ الذُّكْرَانِ."],[1,4,1,"قَدَّرْنَاهَا","جَعَلْنَا امْرَأَةَ لُوطٍ."],[1,6,1,"الْغَابِرِينَ","البَاقِينَ فِي العَذَابِ."],[2,2,1,"مَّطَرًا","حِجَارَةً مِنَ السَّمَاءِ."],[2,3,1,"فَسَاءَ","قَبُحَ."],[4,12,2,"ذَاتَ بَهْجَةٍ","ذَاتَ مَنْظَرٍ حَسَنٍ."],[4,26,1,"يَعْدِلُونَ","يَجْعَلُونَ للهِ عِدْلًا وَنَظِيرًا."],[5,5,1,"خِلَالَهَا","وَسَطَهَا."],[5,9,1,"رَوَاسِيَ","جِبَالًا ثَوَابِتَ."],[5,12,1,"الْبَحْرَيْنِ","العَذْبِ، وَالمَالِحِ."],[6,5,2,"وَيَكْشِفُ السُّوءَ","يُزِيلُ المَكْرُوهَ."],[6,8,2,"خُلَفَاءَ الْأَرْضِ","تَخْلُفُونَ مَنْ سَبَقَكُمْ فِي الأَرْضِ."],[7,1,1,"يَهْدِيكُمْ","يُرْشِدُكُمْ."],[7,9,1,"بُشْرًا","مُبَشِّرَاتٍ بِالمَطَرِ."]]