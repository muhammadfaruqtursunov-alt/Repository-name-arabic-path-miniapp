[[0,1,1,"الْبِرَّ","التَّوَسُّعَ فِي فِعْلِ الخَيْرِ وَالطَّاعَةِ."],[0,26,2,"وَابْنَ السَّبِيلِ","المُسَافِرَ المُحْتَاجَ المُنْقَطِعَ عَنْ أَهْلِهِ."],[0,29,2,"وَفِي الرِّقَابِ","فِي تَحْرِيرِ الرِّقَابِ مِنَ الرِّقِّ وَالأَسْرِ."],[0,41,1,"الْبَاسَاءِ","الفَقْرِ."],[0,42,1,"والضَّرَّاءِ","المَرَضِ."],[0,43,2,"وَحِينَ الْبَاسِ","حِينَ شِدَّةِ القِتَالِ."],[3,7,2,"تَرَكَ خَيْرًا","تَرَكَ مَالًا كَثِيرًا."]]