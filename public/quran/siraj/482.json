[[0,9,1,"أَكْمَامِهَا","أَوْعِيَتِهَا."],[0,23,1,"آذَنَّاكَ","أَعْلَمْنَاكَ."],[1,0,1,"وَضَلَّ","ذَهَبَ، وَغَابَ."],[1,7,1,"وَظَنُّوا","أَيْقَنُوا."],[1,11,1,"مَّحِيصٍ","مَلَجَأٍ، وَمَهْرَبٍ."],[2,0,2,"لَا يَسْأَمُ","لَا يَمَلُّ."],[2,3,3,"مِن دُعَاء الْخَيْرِ","طَلَبِ الزِّيَادَةِ فِي الدُّنْيَا."],[2,8,1,"الشَّرُّ","الفَقْرُ، وَالمَرَضُ، وَالخَوْفُ."],[3,11,2,"وَمَا أَظُنُّ","مَا أَعْتَقِدُ."],[3,31,1,"غَلِيظٍ","شَدِيدٍ."],[4,5,2,"وَنَأى بِجَانِبِهِ","تَبَاعَدَ عَنْ شُكْرِ النِّعْمَةِ، وَاتِّبَاعِ الحَقِّ؛ تَكَبُّرًا."],[4,10,3,"فَذُو دُعَاء عَرِيضٍ","صَاحِبُ دُعَاءٍ بِكَشْفِ الضُّرِّ كَثِيرٍ."],[5,1,1,"أَرَأَيْتُمْ","أَخْبِرُونِي."],[5,10,2,"مَنْ أَضَلُّ","لَا أَحَدَ أَضَلُّ."],[5,15,2,"شِقَاقٍ بَعِيدٍ","خِلَافٍ بَعِيدٍ عَنِ الحَقِّ."],[6,3,1,"الْآفَاقِ","أَقْطَارِ السَّمَوَاتِ، وَالأَرْضِ."],[6,9,2,"أَنَّهُ الْحَقُّ","أَنَّ القُرْآنَ حَقٌّ لَا رَيْبَ فِيهِ."],[6,11,3,"أَوَلَمْ يَكْفِ بِرَبِّكَ","أَلَا يَكْفِيهِمْ دَلَالَةً عَلَى أَنَّ القُرْآنَ حَقٌّ: شَهَادَةُ اللهِ لَهُ بِذَلِكَ؟!"],[7,3,1,"مِرْيَةٍ","شَكٍّ عَظِيمٍ."]]