[[0,0,3,"لَّا جُنَاحَ عَلَيْهِنَّ","لَا إِثْمَ عَلَيْهِنَّ فِي عَدَم الاِحْتِجَابِ."],[0,15,2,"وَلَا نِسَائِهِنَّ","أَيِ: النِّسَاءِ المُؤْمِنَاتِ."],[0,18,3,"مَا مَلَكَتْ أَيْمَانُهُنَّ","العَبِيدِ المُمْلُوكِينَ لَهُنَّ."],[1,3,1,"يُصَلُّونَ","صَلَاةُ اللهِ: ثَنَاؤُهُ عَلَى عَبْدِهِ فِي المَلَإِ الأَعْلَى، وَصَلَاةُ المَلَائِكَةِ: ثَنَاؤُهُمْ وَدُعَاؤُهُمْ."],[2,2,2,"يُؤْذُونَ اللَّهَ","يُشْرِكُونَ بِهِ، وَيَعْصُونَهُ."],[2,5,2,"لَعَنَهُمُ اللَّهُ","أَبْعَدَهُمْ، وَطَرَدَهُمْ مِنْ كُلِّ خَيْرٍ."],[3,8,1,"احْتَمَلُوا","ارْتَكَبُوا."],[3,9,1,"بُهْتَانًا","أَفْحَشَ الكَذِبِ وَالزُّورِ."],[4,7,2,"يُدْنِينَ عَلَيْهِنَّ","يُرْخِينَ عَلَى رُؤُوسِهِنَّ وَوُجُوهِهِنَّ وَصُدُورِهِنَّ."],[4,10,1,"جَلَابِيبِهِنَّ","الجِلْبَابُ: الرِّدَاءُ، وَالمِلْحَفَةُ الَّتِي تَسْتُرُ بَدَنَ المَرْأَةِ وَزِينَتَهَا."],[4,12,1,"أَدْنَى","أَقْرَبُ."],[4,13,2,"أَن يُعْرَفْنَ","يُمَيَّزْنَ بِالسِّتْرِ وَالصِّيَانَةِ؛ فَلَا يُتَعَرَّضَ لَهُنَّ بِمَكْرُوهٍ."],[5,7,1,"مَّرَضٌ","شَكُّ، وَرِيبَةٌ."],[5,8,1,"وَالْمُرْجِفُونَ","الَّذِينَ يَنْشُرُونَ الأَخْبَارَ الكَاذِبَةَ."],[5,11,2,"لَنُغْرِيَنَّكَ بِهِمْ","لَنُسَلِّطَنَّكَ عَلَيْهِمْ."],[5,14,2,"لَا يُجَاوِرُونَكَ","لَا يُسَاكِنُونَكَ."],[6,2,1,"ثُقِفُوا","وُجِدُوا."],[7,0,2,"سُنَّةَ اللَّهِ","طَرِيقَتَهُ فيِ المُنَافِقِينَ: القَتْلَ، وَالأَسْرَ."],[7,4,1,"خَلَوْا","مَضَوْا."],[7,11,1,"تَبْدِيلًا","تَحْوِيلًا، وَتَغْيِيرًا."]]