[[0,26,1,"الطَّالِبُ","المَعْبُودُ مِنْ دُونِ اللهِ الَّذِي أُخِذَ مِنْهُ شَيْءٌ."],[0,27,1,"وَالْمَطْلُوبُ","الذُّبَابُ."],[1,0,2,"مَا قَدَرُوا","مَا عَظَّمُوا."],[2,1,1,"يَصْطَفِي","يَخْتَارُ."],[5,13,1,"حَرَجٍ","ضِيقٍ، وَشِدَّةٍ."],[5,6,1,"اجْتَبَاكُمْ","اصْطَفَاكُمْ."],[5,14,2,"مِّلَّةَ أَبِيكُمْ","هَذِهِ المِلَّةَ السَّمْحَةَ مِلَّةَ أَبِيكُمْ."],[5,17,2,"هُوَ سَمَّاكُمُ","اللهُ سَمَّاكُمُ المُسْلِمِينَ فِي الكُتُبِ السَّابِقَةِ."],[5,39,1,"مَوْلَاكُمْ","مَالِكُكُمْ، وَنَاصِرُكُمْ، وَمُتَوَلِّي أُمُورِكُمْ."]]