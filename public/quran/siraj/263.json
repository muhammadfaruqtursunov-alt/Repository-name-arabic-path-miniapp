[[0,4,1,"بُرُوجًا","مَنَازِلَ لِلْكَوَاكِبِ تَنْزِلُ فِيهَا."],[1,4,1,"رَّجِيمٍ","مَطْرُودٍ مِنْ رَحْمَةِ اللهِ."],[2,2,2,"اسْتَرَقَ السَّمْعَ","اخْتَلَسَ الوَحْيَ مِنَ السَّمَاءِ الدُّنْيَا."],[2,4,1,"فَأَتْبَعَهُ","فَأَدْرَكَهُ."],[2,5,1,"شِهَابٌ","كَوْكَبٌ مُضِيءٌ مُحْرِقٌ."],[3,4,1,"رَوَاسِيَ","رَاسِيَةً تُثَبِّتُهَا."],[4,3,1,"مَعَايِشَ","مَا تَعِيشُونَ بِهِ مِنْ مَعَادِنَ، وَحِجَارَةٍ، وَنَبَاتٍ."],[6,2,1,"لَوَاقِحَ","تَلْقَحُ السَّحَابَ؛ فَيَمْتَلِئُ بِالمَاءِ."],[10,4,1,"صَلْصَالٍ","طِينٍ يَابِسٍ يُسْمَعُ لَهُ صوْتٌ إِذَا نُقِرَ."],[10,6,1,"حَمَإٍ","طِينٍ أَسْوَدَ."],[10,7,1,"مَّسْنُونٍ","مُتَغَيِّرٍ لَوْنُهُ وَرِيحُهُ."],[11,5,2,"نَّارِ السَّمُومِ","نَارٍ شَدِيدَةِ الحَرَارَةِ لَا دُخَانَ لَهَا."]]