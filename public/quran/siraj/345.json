[[0,4,1,"أَجَلَهَا","مَوْعِدُ هَلَاكِهَا المُحَدَّدُ."],[1,3,1,"تَتْرَا","يَتْبَعُ بَعْضُهُمْ بَعْضًا."],[1,14,1,"أَحَادِيثَ","أَخْبَارًا لِمَنْ بَعْدَهُمْ."],[2,5,1,"بِآيَاتِنَا","وَهِيَ تِسْعٌ: العَصَا، وَاليَدُ، وَالجَرَادُ، وَالقُمَّلُ، وَالضَّفَادِعُ، وَالدَّمُ، وَالطُّوفَانُ، وَالسِّنُونَ، وَنَقْصُ الثَّمَرَاتِ."],[3,6,1,"عَالِينَ","مُتَكَبِّرِينَ مُتَطَاوِلِينَ عَلَى النَّاسِ."],[4,6,1,"عَابِدُونَ","مُتَذَلِّلُونَ مُطِيعُونَ."],[7,5,1,"وَآوَيْنَاهُمَا","جَعَلْنَا لَهُمَا مَاوًى وَمَسْكَنًا."],[7,7,1,"رَبْوَةٍ","مَكَانٍ مُرْتَفِعٍ مِنَ الأَرْضِ."],[7,8,2,"ذَاتِ قَرَارٍ","مُسْتَوٍ لِلاِسْتِقْرَارِ عَلَيْهِ."],[7,10,1,"وَمَعِينٍ","مَاءٍ جَارٍ ظَاهِرٍ لِلْعُيُونِ."],[9,2,1,"أُمَّتُكُمْ","دِينُكُمْ يَا مَعْشَرَ الأَنْبِيَاءِ."],[9,3,2,"أُمَّةً وَاحِدَةً","دِينًا وَاحِدًا هُوَ: الإِسْلَامُ."],[10,0,2,"فَتَقَطَّعُوا أَمْرَهُم","فَتَفَرَّقَ الأَتْبَاعُ فِي الدِّينِ."],[10,3,1,"زُبُرًا","شِيَعًا، وَأَحْزَابًا."],[11,2,1,"غَمْرَتِهِمْ","ضَلَالَتِهِمْ، وَجَهْلِهِمْ."],[11,3,2,"حَتَّى حِينٍ","إِلَى وَقْتِ نُزُولِ العَذَابِ بِهِمْ."],[14,6,1,"مُّشْفِقُونَ","وَجِلُونَ."]]