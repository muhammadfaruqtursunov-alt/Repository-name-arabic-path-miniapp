[[0,0,1,"تَرْهَقُهَا","تَغْشَاهَا."],[0,1,1,"قَتَرَةٌ","ذِلَّةٌ، وَظُلْمَةٌ."],[1,2,1,"الْكَفَرَةُ","الجَاحِدُونَ بِقُلُوبِهِمْ."],[1,3,1,"الْفَجَرَةُ","العُصَاةُ بِأَعْمَالِهِمْ."],[2,2,1,"كُوِّرَتْ","لُفَّتْ، وَذَهَبَ ضَوْؤُهَا."],[3,2,1,"انكَدَرَتْ","تَنَاثَرَتْ، وَذَهَبَ نُورُهَا."],[4,2,1,"سُيِّرَتْ","أُزِيلَتْ عَنْ وَجْهِ الأَرْضِ؛ فَصَارَتْ هَبَاءً مَنْثُورًا."],[5,1,1,"الْعِشَارُ","النُّوقُ الحَوَامِلُ."],[5,2,1,"عُطِّلَتْ","أُهْمِلَتْ، وَتُرِكَتْ."],[6,2,1,"حُشِرَتْ","جُمِعَتْ، وَاخْتَلَطَتْ؛ لِيُقْتَصَّ لِبَعْضِهَا مِنْ بَعْضٍ."],[7,2,1,"سُجِّرَتْ","مُلِئَتْ حَتَّى خَاضَتْ، فَانْفَجَرَت، ثُمَّ اتَّقَدَتْ نِيرَانًا."],[8,2,1,"زُوِّجَتْ","قُرِنَتْ بِأَمْثَالِهَا وَنَظَائِرِهَا."],[9,1,1,"الْمَوْؤُودَةُ","الطِّفْلَةُ المَدْفُونَةُ حَيَّةً."],[11,1,1,"الصُّحُفُ","صُحُفُ الأَعْمَالِ."],[11,2,1,"نُشِرَتْ","فُتِحَتْ، وَبُسِطَتْ."],[12,2,1,"كُشِطَتْ","قُلِعَتْ، وَأُزِيلَتْ."],[13,2,1,"سُعِّرَتْ","أُوقِدَتْ، فَأُضْرِمَتْ."],[14,2,1,"أُزْلِفَتْ","قُرِّبَتْ مِنْ أَهْلِهَا."],[15,3,1,"أَحْضَرَتْ","قَدَّمَتْ مِنْ خَيْرٍ أَوْ شَرٍّ."],[16,0,2,"فَلَا أُقْسِمُ","أُقْسِمُ، وَ (لَا): لِتَاكِيدِ الْقَسَمِ."],[16,2,1,"بِالْخُنَّسِ","النُّجُومِ المُخْتَفِيَةِ أَنْوَارُهَا نَهَارًا."],[17,0,1,"الْجَوَارِ","النُّجُومِ الجَارِيَةِ فيِ أَفْلَاكِهَا."],[17,1,1,"الْكُنَّسِ","النُّجُومِ المُسْتَتِرَةِ فِي أَبْرَاجِهِا."],[18,2,1,"عَسْعَسَ","أَقْبَلَ بِظَلَامِهِ، وَأَدْبَرَ."],[19,2,1,"تَنَفَّسَ","ظَهَرَ ضِيَاؤْهُ، وَامْتَدَّ."],[20,2,2,"رَسُولٍ كَرِيمٍ","هُوَ: جِبْرِيلُ - عليه السلام -."],[21,5,1,"مَكِينٍ","ذِي مَكَانَةٍ رَفِيعَةٍ عِنْدَ اللهِ."],[22,1,1,"ثَمَّ","هُنَاكَ فيِ السَّموَاتِ."],[24,1,2,"رَآهُ بِالْأُفُقِ","رَأَى نَبِيُّنَا مُحَمَّدٌ - صلى الله عليه وسلم - جِبْرِيلَ - عليه السلام - فيِ الأُفُقِ عَلَى صُورَتِهِ الَّتِي خُلِقَ عَلَيْهَا."],[25,4,1,"بِضَنِينٍ","بِبَخِيلٍ فِي تَبْلِيغِ الوَحْيِ، وَفِي قِرَاءَةٍ: (بِظَنِينٍ)، أَيْ: مُتَّهَمٍ عَلَى الْوَحْيِ."],[26,4,1,"رَجِيمٍ","مَرْجُومٍ، مَطْرُودٍ مِنْ رَحْمَةِ اللهِ."],[28,0,2,"إِنْ هُوَ","مَا هُوَ."],[28,4,1,"لِّلْعَالَمِينَ","الإِنْسِ، وَالجِنِّ."],[30,6,2,"رَبُّ الْعَالَمِينَ","رَبُّ الخَلَائِقِ أَجْمَعِينَ."]]