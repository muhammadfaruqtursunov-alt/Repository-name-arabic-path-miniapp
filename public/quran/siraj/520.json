[[0,0,2,"وَكَمْ أَهْلَكْنَا","كَثِيرًا أَهْلَكْنَا."],[0,4,1,"قَرْنٍ","أُمَمٍ."],[0,8,1,"بَطْشًا","قُوَّةً، وَسَطْوَةً."],[0,9,1,"فَنَقَّبُوا","طَوَّفُوا."],[0,14,1,"مَّحِيصٍ","مَهْرَبٍ."],[1,9,2,"أَلْقَى السَّمْعَ","أَصْغَى السَّمْعِ."],[1,11,2,"وَهُوَ شَهِيدٌ","هُوَ حَاضِرٌ بِقَلْبِهِ، غَيْرُ غَافِلٍ وَلَا لَاهٍ."],[2,12,1,"لُّغُوبٍ","تَعَبٍ، وَنَصَبٍ."],[3,4,3,"وَسَبِّحْ بِحَمْدِ رَبِّكَ","صَلِّ حَامِدًا لَهُ."],[3,7,3,"قَبْلَ طُلُوعِ الشَّمْسِ","صَلَاةَ الفَجْرِ."],[3,10,2,"وَقَبْلَ الْغُرُوبِ","صَلَاةَ العَصْرِ."],[4,3,2,"وَأَدْبَارَ السُّجُودِ","سَبِّحْ عَقِبَ الصَّلَوَاتِ، أَوْ صَلِّ النَّوَافِلَ بَعْدَ الفَرَائِضِ."],[5,3,1,"الْمُنَادِ","المَلَكُ المُوكَلُ بِالنَّفْخِ فيِ الصُّورِ؛ وَهُوَ: إِسْرَافِيلُ - عليه السلام -."],[6,2,1,"الصَّيْحَةَ","نَفْخَةَ البَعْثِ."],[6,5,2,"يَوْمُ الْخُرُوجِ","مِنَ القُبُورِ."],[7,5,1,"الْمَصِيرُ","المَرْجعُ، وَالمَآلُ."],[8,1,2,"تَشَقَّقُ الْأَرْضُ","تَتَصَدَّعُ."],[8,4,1,"سِرَاعًا","يَخْرُجُونَ مُسْرِعِينَ."],[9,7,1,"بِجَبَّارٍ","بِمُسَلَّطٍ تُجْبِرُهُمْ عَلَى الإِيمَانِ."],[9,11,2,"يَخَافُ وَعِيدِ","يَخْشَى وَعِيدِي."],[10,0,1,"وَالذَّارِيَاتِ","قَسَمٌ بِالرِّيَاحِ، المُثِيرَاتِ لِلتُّرَابِ."],[11,0,2,"فَالْحَامِلَاتِ وِقْرًا","فَالسُّحُبِ الحَامِلَاتِ ثِقَلًا عَظِيمًا مِنَ المَاءِ."],[12,0,2,"فَالْجَارِيَاتِ يُسْرًا","فَالسُّفُنِ الَّتِي تَجْرِي فِي البِحَارِ بِيُسْرٍ."],[13,0,2,"فَالْمُقَسِّمَاتِ أَمْرًا","فَالمَلَائِكَةِ الَّتِي تُقَسِّمُ أَمْرَ اللهِ فِي خَلْقِهِ."],[15,1,1,"الدِّينَ","الحِسَابَ، وَالجَزَاءَ."]]