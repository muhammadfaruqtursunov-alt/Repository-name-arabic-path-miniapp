[[0,4,1,"الْقَاسِطُونَ","الجَائِرُونَ، الظَّالِمُونَ الَّذِينَ حَادُوا عَنِ الحَقِّ."],[0,8,2,"تَحَرَّوْا رَشَدًا","قَصَدُوا طَرِيقَ الحَقِّ، وَاجْتَهَدُوا فِي اخْتِيَارِهِ."],[2,0,2,"وَأَلَّوِ اسْتَقَامُوا","وَأَنَّهُ لَوِ اسْتَقَامَ الكُفَّارُ."],[2,3,1,"الطَّرِيقَةِ","دِينِ الإِسْلَامِ."],[2,6,1,"غَدَقًا","كَثِيرًا."],[3,0,2,"لِنَفْتِنَهُمْ فِيهِ","لِنَخْتَبِرَهُمْ كَيْفَ يَشْكُرُونَ نِعَمَ اللهِ عَلَيْهِمْ."],[3,7,1,"يَسْلُكْهُ","يُدْخِلْهُ."],[3,9,1,"صَعَدًا","شَدِيدًا شَاقًّا."],[5,5,1,"يَدْعُوهُ","يَعْبُدُ رَبَّهُ."],[5,6,1,"كَادُوا","قَارَبَ الجِنُّ."],[5,9,1,"لِبَدًا","جَمَاعَاتٍ مُتَرَاكِبَةً بَعْضُهَا فَوْقَ بَعْضٍ، مِنْ شِدَّةِ ازْدِحَامِهِمْ لِسَمَاعِ القُرْآنِ مِنْهُ."],[7,7,1,"رَشَدًا","نَفْعًا."],[8,3,1,"يُجِيرَنِي","يُنْقِذَنِي."],[8,11,1,"مُلْتَحَدًا","مَلْجَأً أَفِرُّ إِلَيْهِ مِنْ عَذَابِهِ."],[9,0,2,"إِلَّا بَلَاغًا","لَكِنْ أَمْلِكُ أَنْ أُبَلِّغَكُمْ."],[11,1,2,"إِنْ أَدْرِي","مَا أَدْرِي."],[11,4,2,"مَّا تُوعَدُونَ","العَذَابُ الَّذِي وُعِدْتُّمْ بِهِ."],[11,10,1,"أَمَدًا","مُدَّةً طَوِيلَةً."],[13,6,1,"يَسْلُكُ","يُرْسِلُ."],[13,12,1,"رَصَدًا","مَلَائِكَةً يَحْفَظُونَهُ، وَيَحْرُسُونَهُ."]]