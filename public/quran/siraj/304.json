[[0,10,1,"دَكَّاءَ","مُنْهَدِمًا مُسْتَوِيًا بِالأَرْضِ."],[1,3,1,"يَمُوجُ","يَخْتَلِطُ وَيَضْطَرِبُ."],[1,6,1,"وَنُفِخَ","هِيَ النَّفْخَةُ الثَّانِيَةُ؛ وَهِيَ نَفْخَةُ البَعْثِ."],[1,8,1,"الصُّورِ","القَرْنِ الَّذِي يَنْفُخُ فِيهِ إِسْرَافِيلُ."],[2,0,1,"وَعَرَضْنَا","أَبْرَزْنَا."],[4,13,1,"نُزُلًا","مَنزِلًا."],[7,6,1,"فَحَبِطَتْ","فَبَطَلَتْ."],[7,13,1,"وَزْنًا","قَدْرًا."],[9,7,2,"جَنَّاتُ الْفِرْدَوْسِ","هِيَ أَعْلَى الجَنَّةِ، وَأَوْسَطُهَا، وَأَفْضَلُهَا."],[10,5,1,"حِوَلًا","تَحَوُّلًا."],[10,-1,0,"لَنَفِدَ","لَفَنِيَ وَفَرَغَ."],[11,4,1,"مَدَدًا","حِبْرًا."]]