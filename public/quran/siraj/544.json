[[1,0,1,"أَأَشْفَقْتُمْ","أَخَشِيتُمُ الفَقْرَ؟"],[2,3,3,"الَّذِينَ تَوَلَّوْا قَوْمًا","المُنَافِقِينَ اتَّخَذُوا اليَهُودَ أَصْدِقَاءَ، وَوَالَوْهُمْ."],[4,2,1,"جُنَّةً","وِقَايَةً لَهُمْ مِنَ القَتْلِ."],[6,9,1,"وَيَحْسَبُونَ","يَعْتَقِدُونَ."],[7,0,1,"اسْتَحْوَذَ","غَلَبَ، وَاسْتَوْلَى."],[8,2,1,"يُحَادُّونَ","يُخَالِفُونَ، وَيُشَاقُّونَ."],[8,7,1,"الأَذَلِّينَ","الأَذِلَّاءِ المَغْلُوبِينَ المُهَانِينَ."],[9,2,1,"لَأَغْلِبَنَّ","لَأَنْتَصِرَنَّ."],[9,8,1,"عَزِيزٌ","غَالِبٌ لَا يُغْلَبُ."]]