[[0,7,2,"بِبَطْنِ مَكَّةَ","بِالحُدَيْبِيَةِ قُرْبَ مَكَّةَ."],[0,12,1,"أَظْفَرَكُمْ","أَقْدَرَكُمْ عَلَيْهِمْ؛ فَأَمْسَكْتُمْ بِهِمْ، وَكَانُوا ثَمَانِينَ رَجُلًا."],[1,7,1,"وَالْهَدْيَ","البُدْنَ الَّتِي سَاقَهَا رَسُولُ اللهِ - صلى الله عليه وسلم - فيِ عَامِ الحُدَيْبِيَةِ؛ لِيُهْدِيَهَا فيِ الحَرَمِ."],[1,8,1,"مَعْكُوفًا","مَحْبُوسًا."],[1,11,1,"مَحِلَّهُ","المَكَانَ الَّذِي يَحِلُّ فِيهِ نَحْرُهُ؛ وَهُوَ الحَرَمُ."],[1,13,2,"رِجَالٌ مُّؤْمِنُونَ","مُسْتَضْعَفُونَ، مُسْتَخْفُونَ بِإِيمَانِهِمْ."],[1,20,1,"تَطَؤُوهُمْ","خَشْيَةَ أَنْ تُهْلِكُوهُمْ إِذَا حَارَبْتُمُ الكُفَّارَ."],[1,23,1,"مَّعَرَّةٌ","إِثْمٌ، وَعَيْبٌ، وَغَرَامَةٌ."],[1,33,1,"تَزَيَّلُوا","تَمَيَّزَ هَؤْلَاءِ المُسْتَضْعَفُونَ عَنِ الكُفَّارِ."],[2,6,1,"الْحَمِيَّةَ","الأَنَفَةَ."],[2,11,1,"سَكِينَتَهُ","الاِطْمِئْنَانَ وَالوَقَارَ."],[2,17,2,"كَلِمَةَ التَّقْوَى","هِيَ: لَا إِلَهَ إِلَّا اللهُ."],[3,26,2,"فَتْحًا قَرِيبًا","هُوَ: صُلْحُ الحُدَيْبِيَةِ، وَفَتْحُ خَيْبَرَ."],[4,4,1,"بِالْهُدَى","بِالبَيَانِ الوَاضِحِ، وَالعِلْمِ النَّافِعِ."],[4,7,4,"لِيُظْهِرَهُ عَلَى الدِّينِ كُلِّهِ","لِيُعْلِيَهُ عَلَى المِلَلِ كُلِّهَا."]]