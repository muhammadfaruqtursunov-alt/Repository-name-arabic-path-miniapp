[[0,7,1,"يُوَادُّونَ","يُحِبُّونَ."],[0,9,1,"حَادَّ","عَادَى."],[0,20,1,"عَشِيرَتَهُمْ","أَقْرِبَاءَهُمْ."],[0,26,1,"وَأَيَّدَهُم","قَوَّاهُمْ."],[0,27,2,"بِرُوحٍ مِّنْهُ","بِنَصْرٍ، وَتَايِيدٍ."],[1,0,2,"سَبَّحَ لِلَّهِ","نَزَّهَ اللهَ عَمَّا لَا يَلِيقُ بِهِ جَلَّ جَلَالُهُ وَمَجَّدَهُ."],[2,6,2,"أَهْلِ الْكِتَابِ","هُمْ يَهُودُ بَنِي النَّضِيرِ."],[2,10,2,"لِأَوَّلِ الْحَشْرِ","فِي أَوَّلِ إِخْرَاجٍ، وَإِجْلَاءٍ إِلَى الشَّامِ."],[2,26,2,"لَمْ يَحْتَسِبُوا","لَمْ يَخْطُرْ لَهُمْ بِبَالٍ."],[2,28,1,"وَقَذَفَ","أَلْقَى."],[2,31,1,"الرُّعْبَ","الخَوْفَ الشَّدِيدَ."],[2,37,3,"يَا أُولِي الْأَبْصَارِ","يَا أَصْحَابَ البَصَائِرِ السَّلِيمَةِ."],[3,5,1,"الْجَلَاءَ","الخُرُوجَ مِنْ دِيَارِهِمْ."]]