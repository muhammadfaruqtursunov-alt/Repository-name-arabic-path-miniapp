[[0,11,1,"نَصَبًا","تَعَبًا."],[1,1,1,"أَرَأَيْتَ","أَتَذْكُرُ؟"],[1,3,1,"أَوَيْنَا","لَجَانَا."],[2,4,1,"نَبْغِ","نَطْلُبُ."],[2,5,1,"فَارْتَدَّا","فَرَجَعَا."],[2,6,3,"عَلَى آثَارِهِمَا قَصَصًا","يَتَتَبَّعَانِ آثَارَ مَشْيِهِمَا."],[3,0,2,"فَوَجَدَا عَبْدًا","هُوَ الخِضْرُ - عليه السلام -."],[3,9,2,"مِن لَّدُنَّا","مِنْ عِنْدِنَا."],[6,3,5,"مَا لَمْ تُحِطْ بِهِ خُبْرًا","مَا يَخْفَى عَلَيْكِ عِلْمُهُ."],[9,6,1,"خَرَقَهَا","قَلَعَ لَوْحًا مِنْ أَلْوَاحِهَا."],[9,14,1,"إِمْرًا","أَمْرًا مُنْكَرًا."],[11,5,2,"وَلَا تُرْهِقْنِي","لَا تُكَلِّفْنِي."],[12,9,1,"زَكِيَّةً","طَاهِرَةً لَمْ تَبْلُغْ حَدَّ التَّكْلِيفِ."],[12,15,1,"نُّكْرًا","مُنْكَرًا عَظِيمًا."]]