[[0,4,1,"وَيُولِجُ","يُدْخِلُ؛ بِأَنْ يَاخُذَ مِنْ سَاعَاتِ اللَّيْلِ فَيطُولُ النَّهَارُ، وَالعَكْسِ."],[2,3,1,"الْفُلْكَ","السُّفُنَ."],[2,7,2,"بِنِعْمَتِ اللَّهِ","بِأَمْرِ اللهِ وَرَحْمَتِهِ."],[3,1,1,"غَشِيَهُم","عَلَاهُمْ."],[3,3,1,"كَالظُّلَلِ","كَالسَّحَابِ، أَوِ الجِبَالِ المُظِلَّةِ."],[3,14,1,"مُّقْتَصِدٌ","مُتَوَسِّطٌ لَمْ يَقُمْ بِشُكْرِ اللهِ عَلَى وَجْهِ الكَمَالِ."],[3,20,1,"خَتَّارٍ","غَدَّارٍ تَاقِضٍ لِلْعَهْدِ."],[3,21,1,"كَفُورٍ","جَحُودٍ لِنِعَمِ اللهِ."],[4,6,3,"لَّا يَجْزِي وَالِدٌ","لَا يُغْنِي فِيهِ وَالِدٌ."],[4,22,2,"فَلَا تَغُرَّنَّكُمُ","فَلَا تَخْدَعَنَّكُمْ، وَتُلْهِيَنَّكُمْ."],[4,29,1,"الْغَرُورُ","مَا يَغُرُّ وَيَخْدَعُ مِنْ شَيْطَانٍ وَغَيْرِهِ."]]