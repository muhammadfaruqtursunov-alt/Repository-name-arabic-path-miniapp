[[0,3,2,"مَّاءٍ مَّهِينٍ","ضَعِيفٍ حَقِيرٍ؛ وَهُوَ النُّطْفَةُ."],[1,2,2,"قَرَارٍ مَّكِينٍ","مَكَانٍ حَصِينٍ مُتَمَكِّنٍ."],[2,1,1,"قَدَرٍ","وَقْتٍ."],[5,3,1,"كِفَاتًا","وِعَاءً تَضُمُّ الأَحْيَاءَ وَالأَمْوَاتَ."],[7,2,2,"رَوَاسِيَ شَامِخَاتٍ","جِبَالًا ثَوَابِتَ، مُرْتَفِعَاتٍ."],[7,6,1,"فُرَاتًا","عَذْبًا، سَائِغًا."],[10,2,1,"ظِلٍّ","هُوَ دُخَانُ جَهَنَّمَ."],[10,3,3,"ذِي ثَلَاثِ شُعَبٍ","يَتَفَرَّعُ مِنْهُ ثَلَاثُ قِطَعٍ."],[11,0,2,"لَا ظَلِيلٍ","لَا يُظِلُّ مِنْ حَرِّ ذَلِكَ اليَوْمِ."],[11,2,2,"وَلَا يُغْنِي","لَا يَدْفَعُ، وَلَا يَقِي."],[12,2,1,"بِشَرَرٍ","الشَّرَارَةُ: مَا يَتَطَايَرُ مِنَ النَّارِ."],[12,3,1,"كَالْقَصْرِ","كَالبِنَاءِ المُشَيَّدِ فِي العِظَمِ وَالاِرْتِفَاعِ."],[13,1,2,"جِمَالَتٌ صُفْرٌ","كَأَنَّ الشَّرَرَ إِبِلٌ سُودٌ يَمِيلُ لَوْنُهَا إِلَى الصُّفْرَةِ."],[19,3,1,"كَيْدٌ","حِيلَةٌ فِي الخَلَاصِ مِنَ العَذَابِ."],[21,3,1,"ظِلَالٍ","ظِلِّ الأَشْجَارِ الوَارِفَةِ."],[23,2,1,"هَنِيئًا","مُتَهَنِّئِينَ مِنْ غَيْرِ تَنْغِيصٍ، وَلَا كَدَرٍ."],[30,1,2,"حَدِيثٍ بَعْدَهُ","كِتَابٍ وَكَلَامٍ بَعْدَ القُرْآنِ."]]