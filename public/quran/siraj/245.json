[[0,1,2,"مَعَاذَ اللهِ","نَعْتَصِمُ بِاللهِ، وَنَسْتَجِيرُ بِهِ."],[1,1,1,"اسْتَيْأَسُوا","يَئِسُوا وَانْقَطَعَ رَجَاؤُهُم."],[1,3,2,"خَلَصُوا نَجِيًّا","انْفَرَدُوا يَتَشَاوَرُونَ."],[1,14,1,"مَّوْثِقًا","عَهْدًا مُؤَكَّدًا."],[1,20,1,"فَرَّطتُمْ","قَصَّرْتُمْ."],[1,24,1,"أَبْرَحَ","أُفَارِقَ."],[3,5,1,"وَالْعِيْرَ","القَافِلَةَ."],[4,2,1,"سَوَّلَتْ","زَيَّنَتْ."],[5,11,1,"كَظِيمٌ","شَدِيدُ الكِتْمَانِ لِحُزْنِهِ."],[6,2,1,"تَفْتَأُ","مَا تَزَالُ."],[6,7,1,"حَرَضًا","تُشْرِفُ عَلَى الهَلَاكِ."],[7,3,1,"بَثِّي","هَمِّي."]]