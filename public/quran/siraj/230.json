[[0,-1,0,"يَا وَيْلَتَى","كَلِمَةُ تَعَجُّبٍ."],[0,6,1,"بَعْلِي","زَوْجِي."],[1,12,1,"حَمِيدٌ","مَحْمُودُ الصِّفَاتِ وَالأَفْعَالِ."],[1,13,1,"مَّجِيدٌ","ذُو عَظَمَةٍ."],[2,4,1,"الرَّوْعُ","الخَوْفُ."],[3,3,1,"أَوَّاهٌ","كَثِيرُ التَّضَرُّعِ وَالدُّعَاءِ."],[3,4,1,"مُّنِيبٌ","تَائِبٌ يَرْجِعُ إِلَى اللهِ فِي أُمُورِهِ كُلِّهَا."],[5,4,2,"سِيءَ بِهِمْ","سَاءَهُ مَجِيئُهُمْ."],[5,6,3,"وَضَاقَ بِهِمْ ذَرْعًا","ضَاقَ صَدْرُهْ، وَاغْتَمَّ لِمَجِيئِهِمْ؛ خَوْفًا عَلَيْهِمْ مِنْ قَوْمِهِ."],[5,12,1,"عَصِيبٌ","شَدِيدٌ."],[6,2,1,"يُهْرَعُونَ","يُسْرِعُونَ."],[6,18,2,"وَلَا تُخْزُونِ","لَا تَفْضَحُونِي."],[6,25,1,"رَّشِيدٌ","يَامُرُ بِالمَعْرُوفِ، وَيَنْهَى عَنِ المُنْكَرِ."],[7,7,2,"مِنْ حَقٍّ","مِنْ حَاجَةٍ، أَوْ رَغْبَةٍ."],[9,8,1,"فَأَسْرِ","فَاخْرُجْ."],[9,10,3,"بِقِطْعٍ مِّنَ اللَّيْلِ","بِبَقِيَّةٍ مِنَ اللَّيْلِ."]]