[[0,2,1,"فَتَحَسَّسُوا","فَاسْتَقْصُوا خَبَرَهُ."],[0,6,2,"وَلَا تَيْأَسُوا","لَا تَقْطَعُوا رَجَاءَكُمْ."],[0,9,2,"رَّوْحِ اللهِ","رَحْمَةِ اللهِ."],[1,8,1,"الضُّرُّ","القَحْطُ، وَالجَدْبُ."],[1,10,2,"بِبِضَاعَةٍ مُّزْجَاةٍ","ثَمَنٍ رَدِيءٍ قَلِيلٍ."],[4,3,1,"آثَرَكَ","فَضَّلَكَ وَاخْتَارَكَ."],[4,8,1,"لَخَاطِئِينَ","آثِمِينَ بِمَا فَعَلْنَاهُ بِكَ، وَبِأَخِيكَ عَمْدًا."],[5,1,2,"لَا تَثْرَيبَ","لَا تَانِيبَ."],[7,1,2,"فَصَلَتِ الْعِيرُ","خَرَجَتِ القَافِلَةُ مِنْ أَرْضِ مِصْرَ."],[7,11,1,"تُفَنِّدُونِ","تُسَفِّهُونِي."],[8,4,1,"ضَلَالِكَ","خَطَئِكَ."]]