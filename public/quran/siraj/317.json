[[0,5,1,"أَسْرِ","اُخْرُجْ لَيْلًا."],[0,7,1,"فَاضْرِبْ","فَاتَّخِذْ."],[0,12,1,"يَبَسًا","يَابِسًا."],[0,15,1,"دَرَكًا","إِدْرَاكًا."],[1,3,1,"فَغَشِيَهُمْ","فَغَمَرَهُمْ، وَغَطَّاهُمْ."],[1,5,1,"الْيَمِّ","البَحْرِ."],[3,7,2,"جَانِبَ الطُّورِ","جَانِبِ جَبَلِ الطُّورِ."],[3,9,1,"الْمَنَّ","طَعَامًا؛ كَالعَسَلِ."],[3,13,1,"وَالسَّلْوَى","طَيْرًا؛ كَالسُّمَانَى."],[4,5,3,"وَلَا تَطْغَوْا فِيهِ","لَا تَعْتَدُوا بِأَنْ يَظْلِمَ بَعْضُكُمْ بَعْضًا."],[4,8,1,"فَيَحِلَّ","فَيَنْزِلَ."],[4,16,1,"هَوَى","خَسِرَ، وَهَلَكَ."],[7,2,1,"أُولَاءِ","هَؤُلاءِ."],[7,3,2,"عَلَى أَثَرِي","خَلْفِي سَوْفَ يَلْحَقُونَ بِي."],[9,5,1,"أَسِفًا","حَزِينًا."],[9,11,2,"وَعْدًا حَسَنًا","الوَعْدَ بِإِنْزَالِ التَّوْرَاةِ."],[10,4,1,"بِمَلْكِنَا","بِاخْتِيَارِنَا وَقُدْرَتِنَا."],[10,7,1,"أَوْزَارًا","أَثْقَالًا."],[10,8,3,"مِّن زِينَةِ الْقَوْمِ","مِنْ حُلِيِّ قَوْمِ فِرْعَوْنَ."],[10,11,1,"فَقَذَفْنَاهَا","أَلْقَيْنَاهَا فِي حُفْرَةٍ فِيهَا نَارٌ."]]