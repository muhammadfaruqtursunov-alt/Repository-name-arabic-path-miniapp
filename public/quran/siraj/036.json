[[0,3,3,"بِاللَّغْوِ فِيَ أَيْمَانِكُمْ","اليَمِينُ اللَّاغِيَةُ هِيَ: اليَمِينُ الَّتِي لَا يَقْصِدُهَا صَاحِبُهَا."],[1,1,1,"يُؤْلُونَ","يَحْلِفُونَ أَلَّا يُجَامِعُوا نِسَاءَهُمْ."],[1,4,1,"تَرَبُّصُ","انْتِظَارُ."],[1,8,1,"فَاؤُوا","رَجَعُوا."],[3,1,1,"يَتَرَبَّصْنَ","يَنْتَظِرْنَ."],[3,3,2,"ثَلَاثَةَ قُرُوَءٍ","ثَلَاثَ حِيَضٍ."]]