[[6,10,1,"عَادُونَ","مُتَجَاوِزُونَ مَا أَبَاحَهُ اللهُ لَكُمْ مِنَ الحَلَالِ إِلَى الحَرَامِ."],[7,7,1,"الْمُخْرَجِينَ","المَطْرُودِينَ مِنْ بِلَادِنَا."],[7,0,1,"الْقَالِينَ","المُبْغِضِينَ لِعَمَلِكُمْ بُغْضًا شَدِيدًا."],[11,3,1,"الْغَابِرِينَ","البَاقِينَ فيِ العَذَابِ."],[13,3,1,"فَسَاءَ","قَبُحَ."],[16,1,2,"أَصْحَابُ الْأَيْكَةِ","أَصْحَابُ الأَرْضِ ذَاتِ الشَّجَرِ المُلْتَفِّ؛ وَهُمْ قَوْمُ شُعَيْبٍ."],[21,5,1,"الْمُخْسِرِينَ","النَّاقِصِينَ لِحُقُوقِ النَّاسِ."],[22,1,1,"بِالْقِسْطَاسِ","بِالمِيزَانِ."],[22,2,1,"الْمُسْتَقِيمِ","العَدْلِ السَّوِيِّ."],[23,0,2,"وَلَا تَبْخَسُوا","لَا تَنْقُصُوا."],[23,4,2,"وَلَا تَعْثَوْا","لَا تُكْثِرُوا الفَسَادَ."]]