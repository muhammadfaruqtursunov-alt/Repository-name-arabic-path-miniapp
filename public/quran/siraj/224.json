[[0,3,1,"مُعْجِزِينَ","فَائِتِينَ مِنْ عَذَابِ اللهِ بِالهَرَبِ."],[1,4,1,"وَضَلَّ","ذَهَبَ."],[2,0,2,"لَا جَرَمَ","حَقًّا."],[3,5,1,"وَأَخْبَتُوا","خَضَعُوا لِلهِ."],[4,3,1,"وَالأَصَمِّ","الَّذِي لَا يَسْمَعُ."],[7,1,1,"الْمَلأُ","رُؤَسَاءُ الكُفْرِ."],[7,17,1,"أَرَاذِلُنَا","أَسَافِلُنَا."],[7,18,2,"بَادِيَ الرَّايِ","مِنْ غَيْرِ تَفَكُّرٍ، وَلَا رَوِيَّةٍ."],[8,13,2,"فَعُمِّيَتْ عَلَيْكُمْ","فَأُخْفِيَتْ عَلَيْكُمْ."],[8,15,1,"أَنُلْزِمُكُمُوهَا","أَنُجْبِرُكم عَلَى قَبُولِهَا."]]