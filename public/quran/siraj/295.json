[[0,18,1,"مِّرْفَقًا","مَا تَنْتَفِعُونَ بِهِ فِي حَيَاتِكُمْ مِنْ أَسْبَابِ العَيْشِ."],[1,4,1,"تَّزَاوَرُ","تَمِيلُ."],[1,11,1,"تَّقْرِضُهُمْ","تَتْرُكُهُمْ، وَتَتَجَاوَزُ عَنْهُمْ."],[1,16,1,"فَجْوَةٍ","مُتَّسَعٍ."],[2,12,1,"بِالْوَصِيدِ","بِفِنَاءِ الكَهْفِ."],[2,18,1,"فِرَارًا","هَرَبًا."],[3,22,1,"بِوَرِقِكُمْ","بِنُقُودِكُمُ الفِضِّيَّةِ."],[3,28,1,"أَزْكَى","أَحَلُّ، وَأَطْيَبُ."],[4,2,1,"يَظْهَرُوا","يَطَّلِعُوا."]]