[[0,2,1,"كَرِيمٌ","عَظِيمُ المَنَافِعِ، كَثِيرُ الخَيْرِ، غَزِيرُ العِلْمِ."],[1,2,1,"مَّكْنُونٍ","مَسْتُورٍ مَصُونٍ."],[4,1,1,"الْحَدِيثِ","القُرْآنِ."],[4,3,1,"مُّدْهِنُونَ","مُكَذِّبُونَ."],[5,0,2,"وَتَجْعَلُونَ رِزْقَكُمْ","تَجْعَلُونَ شُكْرَ نِعَمِ اللهِ عَلَيْكُمْ."],[6,2,2,"بَلَغَتِ الْحُلْقُومَ","وَصَلَتِ الرُّوحُ الحُلْقُومَ عِنْدَ المَوْتِ."],[9,3,2,"غَيْرَ مَدِينِينَ","غَيْرَ مَجْزِيِّينَ، وَمُحَاسَبِينَ."],[10,0,1,"تَرْجِعُونَهَا","تَرُدُّونَ الرُّوحَ إِلَى الجَسَدِ."],[12,0,1,"فَرَوْحٌ","رَحْمَةٌ وَاسِعَةٌ، وَاسْتِرَاحَةٌ، وَفَرَحٌ."],[12,1,1,"وَرَيْحَانٌ","رِزْقٌ حَسَنٌ، وَرَائِحَةٌ طَيِّبَةٌ، وَجَمِيعُ مَا تَطِيبُ بِهِ نَفْسُهُ."],[14,0,2,"فَسَلَامٌ لَّكَ","يُقَالُ لَهُ: سَلَامَةٌ لَكَ، وَأَمْنٌ."],[14,2,3,"مِنْ أَصْحَابِ الْيَمِينِ","لِكَوْنِكَ مِنْ أَصْحَابِ اليَمِينِ."],[16,0,1,"فَنُزُلٌ","ضِيَافَةٌ."],[16,2,1,"حَمِيمٍ","شَرَابِ جَهَنَّمَ المُتَنَاهِي فِي الحَرَارَةِ."],[17,0,2,"وَتَصْلِيَةُ جَحِيمٍ","يَدْخُلُ فِيهَا، وَيُقَاسِي حَرَّهَا."],[18,3,2,"حَقُّ الْيَقِينِ","لَا مِرْيَةَ فِيهِ."],[20,0,2,"سَبَّحَ لِلَّهِ","نَزَّهَ اللهَ عَمَّا لَا يَلِيقُ بِهِ جَلَّ جَلَالُهُ."],[22,1,1,"الْأَوَّلُ","الَّذِي لَيْسَ قَبْلَهُ شَيْءٌ."],[22,2,1,"وَالْآخِرُ","الَّذِي لَيْسَ بَعْدَهُ شَيْءٌ."],[22,3,1,"وَالظَّاهِرُ","الَّذِي لَيْسَ فَوْقَهُ شَيْءٌ."],[22,4,1,"وَالْبَاطِنُ","الَّذِي لَيْسَ دُونَهُ شَيْءٌ."]]