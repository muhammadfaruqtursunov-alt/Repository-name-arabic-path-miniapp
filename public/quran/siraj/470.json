[[1,3,1,"عُذْتُ","اسْتَجَرْتُ."],[2,37,1,"مُسْرِفٌ","مُتَجَاوِزٌ لِلْحَدِّ بِتَرْكِ الحَقِّ، وَاتِّبَاعِ البَاطِلِ."],[3,4,1,"ظَاهِرِينَ","غَالِبِينَ عَالِينَ."],[3,10,2,"بَاسِ اللَّهِ","عَذَابِ اللهِ."],[3,16,2,"مَا أُرِيكُمْ","مَا أُشِيرُ عَلَيْكُمْ."],[3,22,1,"أَهْدِيكُمْ","أَدْعُوكُمْ."],[3,24,2,"سَبِيلَ الرَّشَادِ","طَرِيقَ الحَقِّ وَالصَّوَابِ."],[4,9,1,"الْأَحْزَابِ","الأُمَمِ المُتَحَزِّبَةِ عَلَى أَنْبِيَائِهَا، المُعَادِيَةِ لِهُمْ."],[5,1,3,"دَابِ قَوْمِ نُوحٍ","عَادَتِهِمْ فيِ الكُفْرِ وَالتَّكْذِيبِ."],[6,4,2,"يَوْمَ التَّنَادِ","يَوْمَ القِيَامَةِ الَّذِي يُنَادِي النَّاسُ فِيهِ بَعْضُهُمْ بَعْضًا."],[7,2,1,"مُدْبِرِينَ","هَارِبِينَ."],[7,8,1,"عَاصِمٍ","مَانِعٍ يَمْنَعُكُمْ."]]