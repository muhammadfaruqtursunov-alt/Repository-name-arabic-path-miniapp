[[0,1,1,"وَلِيِّيَ","نَاصِرِي، وَحَافِظِي مِنْ كُلِّ سُوءٍ."],[3,0,2,"خُذِ الْعَفْوَ","خُذْ مَا تَيَسَّرَ مِنْ أَخْلَاقِ النَّاسِ، وَلَا تُكَلِّفْهُمْ مَا لَا يُرِيدُونَ بَذْلَهُ لَكَ."],[3,3,1,"بِالْعُرْفِ","بِالْمَعْرُوفِ، وَهُوَ كُلُّ قَوْلٍ وَعَمَلٍ حَسَنٍ."],[3,6,1,"الْجَاهِلِينَ","السُّفَهَاءِ."],[4,1,1,"يَنزَغَنَّكَ","يُصِيبَنَّكَ."],[4,4,1,"نَزْغٌ","وَسْوَسَةٌ، وَتَثْبِيطٌ عَنِ الْخَيْرِ، وَحَثٌّ عَلَى الشَّرِّ."],[4,5,2,"فَاسْتَعِذْ بِاللهِ","فَالْجَا مُسْتَجِيرًا بِاللهِ."],[5,5,3,"طَائِفٌ مِّنَ الشَّيْطَانِ","عَارِضٌ مِنْ وَسْوَسَةِ الشَّيْطَانِ."],[6,1,1,"يَمُدُّونَهُمْ","يُعِينُونَهُمْ فِي الْغَوَايَةِ."],[6,5,2,"لَا يُقْصِرُونَ","لَا يَدَّخِرُونَ وُسْعًا فِي غَوَايَتِهِمْ."],[7,6,1,"اجْتَبَيْتَهَا","اخْتَلَقْتَهَا وَأَحْدَثْتَهَا."],[7,16,1,"بَصَائِرُ","حُجَجٌ، وَبَرَاهِينُ."],[9,4,1,"تَضَرُّعًا","تَخَشُّعًا وَتَذّلُّلًا."],[9,5,1,"وَخِيفَةً","تَوَاضُعًا، وَخَوْفًا مِنْهُ."],[9,10,1,"بِالْغُدُوِّ","بأَوَّلِ النَّهَارِ."],[9,11,1,"وَالآصَالِ","آخِرِ النَّهَارِ."],[10,8,1,"وَيُسَبِّحُونَهُ","يُنَزِّهُونَهُ عَمَّا لَا يَلِيقُ بِجَلَالِهِ."]]