[[0,1,1,"خَيْرَاتٌ","زَوْجَاتٌ طَيِّبَاتُ الأَخْلَاقِ."],[2,0,1,"حُورٌ","نِسَاءٌ بِيضٌ حِسَانٌ."],[2,1,1,"مَّقْصُورَاتٌ","مَسْتُورَاتٌ مَصُونَاتٌ."],[4,1,1,"يَطْمِثْهُنَّ","يَطَاهُنَّ."],[6,2,2,"رَفْرَفٍ خُضْرٍ","وَسَائِدَ ذَوَاتِ أَغْطِيَةٍ خُضْرٍ."],[6,4,1,"وَعَبْقَرِيٍّ","فُرُشٍ، وَبُسُطٍ."],[8,0,1,"تَبَارَكَ","كَثُرَتْ بَرَكَتُهُ، وَخَيْرُهُ."],[9,2,1,"الْوَاقِعَةُ","القِيَامَةُ."],[10,0,2,"لَيْسَ لِوَقْعَتِهَا","لَيْسَ لِوُقُوعِهَا، وَقِيَامِهَا."],[10,2,1,"كَاذِبَةٌ","نَفْسٌ تُكَذِّبُ بِذَلِكَ."],[11,0,2,"خَافِضَةٌ رَّافِعَةٌ","تَخْفِضُ الكُفَّارَ فِي النَّارِ، وَتَرْفَعُ المُؤْمِنِينَ فِي الجَنَّةِ."],[12,1,1,"رُجَّتِ","حُرِّكَتْ."],[12,3,1,"رَجًّا","تَحْرِيكًا شَدِيدًا."],[13,0,1,"وَبُسَّتِ","فُتِّتَتْ."],[14,1,2,"هَبَاءً مُّنبَثًّا","غُبَارًا مُتَطَايِرًا فِي الجَوِّ."],[15,1,1,"أَزْوَاجًا","أَصْنَافًا."],[17,1,1,"الْمَشْأَمَةِ","الشِّمَالِ."],[18,0,1,"وَالسَّابِقُونَ","الَّذِينَ يَسْبِقُونَ إِلَى الخَيْرَاتِ، وَيُسَارِعُونَ لِلطَّاعَاتِ."],[18,0,1,"السَّابِقُونَ","الَّذِينَ يَسْبِقُونَ إِلَى المَنَازِلِ العَالِيَةِ فِي الجَنَّةِ."],[21,0,1,"ثُلَّةٌ","جَمَاعَةٌ كَثِيرَةٌ."],[21,2,1,"الْأَوَّلِينَ","صَدْرِ هَذِهِ الأُمَّةِ وَغَيْرِهِمْ مِنَ الأُمَمِ الأُخْرَى."],[22,2,1,"الْآخِرِينَ","آخِرِ هَذِهِ الأُمَّةِ."],[23,2,1,"مَّوْضُونَةٍ","مَنْسُوجَةٍ بِالذَّهَبِ."]]