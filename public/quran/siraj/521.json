[[0,1,2,"ذَاتِ الْحُبُكِ","ذَاتِ الخَلْقِ الحَسَنِ، وَذَاتِ الطُّرُقِ الَّتِي تَسِيُر فِيهَا الكَوَاكِبُ."],[1,2,2,"قَوْلٍ مُّخْتَلِفٍ","مُتَنَاقِضٍ، مُضْطَرِبٍ فِي القُرْآنِ وَالرَّسُولِ - صلى الله عليه وسلم -."],[2,0,2,"يُؤْفَكُ عَنْهُ","يُصْرَفُ عَنِ القُرْآنِ وَالرَّسُولِ - صلى الله عليه وسلم -."],[3,0,2,"قُتِلَ الْخَرَّاصُونَ","قُتِلَ، وَلُعِنَ الكَذَّابُونَ، الظَّانُّونَ غَيْرَ الحَقِّ."],[4,3,1,"غَمْرَةٍ","جَهْلٍ يَغْمُرُهُمْ."],[4,4,1,"سَاهُونَ","غَافِلُونَ عَنْ أَمْرِ الآخِرَةِ."],[5,0,1,"يَسْأَلُونَ","سُؤَالَ اسْتِبْعَادٍ وَإِنْكَارٍ."],[5,1,3,"أَيَّانَ يَوْمُ الدِّينِ","مَتَى يَوْمُ الجَزَاءِ؟!"],[6,4,1,"يُفْتَنُونَ","يُحْرَقُونَ، وَيُعَذَّبُونَ."],[7,1,1,"فِتْنَتَكُمْ","عَذَابَكُمْ."],[10,5,1,"يَهْجَعُونَ","يَنَامُونَ."],[11,0,1,"وَبِالْأَسْحَارِ","آخِرِ اللَّيْلِ، قُبَيْلَ الفَجْرِ."],[12,3,1,"لِّلسَّائِلِ","لِلْمُحْتَاجِ الَّذِي يَسْأَلُ النَّاسَ."],[12,4,1,"وَالْمَحْرُومِ","الَّذِي لَا يَسْأَلُ النَّاسَ حَيَاءً."],[16,3,2,"إِنَّهُ لَحَقٌّ","إِنَّ مَا وَعَدَكُمْ بِهِ مِنَ الجَزَاءِ لَحَقٌّ ثَابِتٌ."],[17,3,2,"ضَيْفِ إِبْرَاهِيمَ","أَضْيَافِهِ مِنَ المَلَائِكَةِ."],[18,8,1,"مُّنكَرُونَ","غُرَبَاءُ لَا تُعْرَفُونَ."],[19,0,1,"فَرَاغَ","مَالَ، وَعَدَلَ بِخُفْيَةٍ."],[21,0,2,"فَأَوْجَسَ مِنْهُمْ","أَحَسَّ فِي نَفْسِهِ مِنْهُمِ."],[21,7,1,"بِغُلَامٍ","هُوَ: إِسْحَاقُ - عليه السلام -."],[22,1,1,"امْرَأَتُهُ","هِيَ: سَارَةُ."],[22,3,1,"صَرَّةٍ","صَيْحَةٍ، وَضَجَّةٍ."],[22,4,2,"فَصَكَّتْ وَجْهَهَا","لَطَمَتْهُ بِيَدِهَا تَعَجُّبًا."],[22,8,1,"عَقِيمٌ","لَا يُولَدُ لِي وَلَدٌ."]]