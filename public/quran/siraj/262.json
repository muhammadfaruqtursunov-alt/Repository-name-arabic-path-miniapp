[[1,0,1,"رُّبَمَا","رُبَّمَا."],[2,3,2,"وَيُلْهِهِمُ الأَمَلُ","يَشْغَلُهُمُ الطَّمَعُ فِي الُّدنْيَا، وَطُولُ البَقَاءِ فِيهَا."],[3,6,2,"كِتَابٌ مَّعْلُومٌ","أَجَلٌ مُقَدَّرٌ."],[6,0,2,"لَّوْ مَا","هَلَّا."],[7,8,1,"مُّنظَرِينَ","مُمْهَلِينَ، وَمُؤَخَّرِينَ."],[9,5,2,"شِيَعِ الأَوَّلِينَ","فِرَقِ الأُمَمِ السَّابِقِينَ."],[11,1,1,"نَسْلُكُهُ","نُدْخِلُ الكُفْرَ."],[12,4,1,"خَلَتْ","مَضَتْ."],[13,6,1,"فَظَلُّوا","فَاسْتَمَرُّوا."],[13,8,1,"يَعْرُجُونَ","يَصْعَدُونَ."],[14,2,1,"سُكِّرَتْ","سُحِرَتْ."]]