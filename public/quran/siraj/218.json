[[3,0,1,"وَيُحِقُّ","يُثْبِتُ وَيُعْلِي."],[4,16,1,"لَعَالٍ","لَجَبَّارٌ، مُسْتَكْبِرٌ."],[4,21,1,"الْمُسْرِفِينَ","المُتَجَاوِزِينَ الحَدَّ فِي الكُفْرِ وَالفَسَادِ."],[5,11,1,"مُّسْلِمِينَ","مُذْعِنِينَ لَهُ بِالطَّاعَةِ."],[6,5,5,"لَا تَجْعَلْنَا فِتْنَةً لِّلْقَوْمِ الظَّالِمِينَ","لَا تَنْصُرْهُمْ عَلَيْنَا، فَيَظُنُّوا أَنَّهُمْ عَلَى الحَقِّ؛ فَيَفْتَتِنُوا، أَوْ يَفْتِنوُنَا عَنِ الدِّينِ."],[8,5,1,"تَبَوَّءَا","اتَّخِذَا."],[8,11,1,"قِبْلَةً","مَسَاجِدَ تُصَلُّونَ فِيهَا عِنْدَ الخَوْفِ."],[9,17,3,"اطْمِسْ عَلَى أَمْوَالِهِمْ","أَتْلِفْهَا."],[9,20,3,"وَاشْدُدْ عَلَى قُلُوبِهِمْ","اخْتِمْ عَلَيْهَا حَتَّى لَا تُؤْمِنَ."]]