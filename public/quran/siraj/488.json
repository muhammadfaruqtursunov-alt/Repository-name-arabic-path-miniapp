[[0,3,1,"خَاشِعِينَ","خَاضِعِينَ مُتَضَائِلِينَ."],[0,6,4,"يَنظُرُونَ مِن طَرْفٍ خَفِيٍّ","يُسَارِقُونَ النَّظَرَ، وَلَا يَنْظُرُونَ بِمِلْءِ أَعْيُنِهمْ."],[1,12,4,"فَمَا لَهُ مِن سَبِيلٍ","مَا لَهُ مِنْ طَرِيقٍ يَصِلُ بِهِ إِلَى الحَقِّ فِي الدُّنْيَا."],[2,7,3,"لَّا مَرَدَّ لَهُ","لَا يُمْكِنُ رَدُّهُ."],[2,20,1,"نَّكِيرٍ","لَا تُنْكِرُونَ ذُنُوبَكُمْ، وَلَيْسَ لَكُمْ مَكَانٌ تَسْتَخْفُونَ وَتَتَنَكَّرُونَ فِيهِ."],[3,5,1,"حَفِيظًا","حَافِظًا لِأَعْمَالِهِمْ."],[3,26,1,"كَفُورٌ","جَحُودٌ؛ يُعَدِّدُ المَصَائِبَ، وَيَنْسَى النِّعَمَ."],[5,1,1,"يُزَوِّجُهُمْ","يَجْمَعُ لَهُ النَّوْعَيْنِ."],[5,7,1,"عَقِيمًا","لَا يُولَدُ لَهُ."],[6,7,1,"وَحْيًا","إِعْلَامًا فِي المَنَام، أَوْ بِالإِلْهَامِ."],[6,9,3,"مِن وَرَاءِ حِجَابٍ","كَمَا كَلَّمَ مُوسَى - عليه السلام -."],[6,13,1,"رَسُولًا","هُوَ: جِبْرِيلُ - عليه السلام -."]]