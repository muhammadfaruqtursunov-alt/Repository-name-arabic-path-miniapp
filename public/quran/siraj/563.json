[[2,5,1,"ذَلُولًا","سَهْلَةً، مُمَهَّدَةً تَسْتَقِرُّونَ عَلَيْهَا."],[2,8,1,"مَنَاكِبِهَا","نَوَاحِيهَا، وَجَوَانِبِهَا."],[2,12,2,"وَإِلَيْهِ النُّشُورُ","إِلَيْهِ تُبْعَثُونَ مِنْ قُبُورِكُمْ لِلْجَزَاءِ وَالحِسَابِ."],[3,1,3,"مَّن فِي السَّمَاء","اللهَ الَّذِي فِي العُلُوِّ."],[3,10,1,"تَمُورُ","تَضْطَرِبُ بِكُمْ حَتَّى تَهْلِكُوا."],[4,8,1,"حَاصِبًا","رِيحًا تَرْجُمُكُمْ بِالحِجَارَةِ الصَّغِيرَةِ."],[4,11,1,"نَذِيرِ","تَحْذِيرِي لَكُمْ."],[5,7,1,"نَكِيرِ","إِنْكَارِي عَلَيْهِمْ، وَتَغْيِيرُ مَا بِهِمْ مِنَ النِّعْمَةِ."],[6,5,1,"صَافَّاتٍ","بَاسِطَاتٍ أَجْنِحَتَهَا عِنْدَ طَيَرَانِهَا فِي الهَوَاءِ."],[6,6,1,"وَيَقْبِضْنَ","يَضْمُمْنَهَا إِلَى جُنُوبِهَا أَحْيانًا."],[7,14,1,"غُرُورٍ","خِدَاعٍ وَضَلَالٍ مِنَ الشَّيْطَانِ."],[8,8,1,"لَّجُّوا","اسْتَمَرُّوا، وَتَمَادَوْا."],[8,10,1,"عُتُوٍّ","مُعَانَدَةٍ، وَاسْتِكْبَارٍ."],[8,11,1,"وَنُفُورٍ","شُرُودٍ وَتَبَاعُدٍ عَنِ الحَقِّ."],[9,2,1,"مُكِبًّا","مُنَكَّسًا."],[9,8,1,"سَوِيًّا","مُسْتَوِيًا، مُنْتَصِبَ القَامَةِ سَالِمًا."],[9,10,2,"صِرَاطٍ مُّسْتَقِيمٍ","طَرِيقٍ وَاضِحٍ لَا اعْوِجَاجَ فِيهِ."],[10,3,1,"أَنشَأَكُمْ","أَوْجَدَكُمْ."],[11,3,1,"ذَرَأَكُمْ","خَلَقَكُمْ، وَنَشَرَكُمْ فِي الأَرْضِ."]]