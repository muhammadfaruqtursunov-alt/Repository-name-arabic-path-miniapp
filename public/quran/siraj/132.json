[[2,12,2,"مَّا فَرَّطْنَا","مَا تَرَكْنَا."],[3,3,1,"صُمٌّ","الَّذِينَ لَا يَسْمَعُونَ."],[3,4,1,"وَبُكْمٌ","الَّذِينَ لَا يَتَكَلَّمُونَ."],[4,1,1,"أَرَأَيْتَكُمْ","أَخْبِرُونِي."],[6,7,1,"بِالْبَاسَاءِ","الْفَقْرِ."],[6,8,1,"وَالضَّرَّاءِ","الْمَرَضِ."],[8,19,1,"مُّبْلِسُونَ","آيِسُونَ، مُنْقَطِعُونَ مِنْ كُلِّ خَيْرٍ."]]