[[1,5,1,"وَالصَّابِئِينَ","عَبَدَةَ المَلَائِكَةِ، أَوِ الكَوَاكِبِ."],[1,7,1,"وَالْمَجُوسَ","عَبَدَةَ النَّارِ."],[1,21,1,"شَهِيدٌ","عَاِلمٌ بِهِ عِلْمَ مُشَاهَدَةٍ."],[3,1,1,"خَصْمَانِ","فَرِيقَانِ مُخْتَلِفَانِ، وَهُمْ أَهْلُ إِيمَانٍ، وَأَهْلُ كُفْرَانٍ."],[3,7,3,"قُطِّعَتْ لَهُمْ ثِيَابٌ","جُعِلَتْ لَهُمْ ثِيَابٌ مِنَ النَّارِ يَلْبَسُونَهَا."],[3,16,1,"الْحَمِيمُ","المَاءُ المُتَنَاهِي فِي حَرِّهِ."],[4,0,2,"يُصْهَرُ بِهِ","يُذَابُ بِهِ."],[5,1,1,"مَّقَامِعُ","مَطَارِقُ."],[6,5,2,"مِنْ غَمٍّ","مِنْ شِدَّةِ غَمِّهِمْ، وَكَرْبِهِمْ."],[6,9,1,"وَذُوقُوا","وَقِيلَ لَهُمْ: ذُوقُوا."],[7,12,1,"يُحَلَّوْنَ","يُزَيَّنُونَ."]]