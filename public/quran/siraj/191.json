[[1,15,1,"عَيْلَةً","فَقْرًا."],[2,24,1,"الْجِزْيَةَ","مَالٌ يُفْرَضُ عَلَى الكَافِرِ المُقِيمِ بِبِلَادِ المُسْلِمِينَ."],[2,28,1,"صَاغِرُونَ","أَذِلَّاءُ."],[3,13,1,"يُضَاهِئُونَ","يُشَابِهُونَ."],[3,21,2,"أَنَّى يُؤْفَكُونَ","كَيْفَ يُصْرَفُونَ عَنِ الحَقِّ؟!"],[4,1,1,"أَحْبَارَهُمْ","عُلَمَاءَ اليَهُودِ."],[4,2,1,"وَرُهْبَانَهُمْ","عُبَّادَ النَّصَارَى."],[4,20,1,"سُبْحَانَهُ","تَنَزَّهَ، وَتَقَدَّسَ."]]