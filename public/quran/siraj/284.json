[[0,3,1,"الْعَاجِلَةَ","الدُّنْيَا."],[0,15,1,"يَصْلاهَا","يَدْخُلُهَا، وَيُقَاسِي حَرَّهَا."],[0,16,1,"مَذْمُومًا","مَلُومًا."],[0,17,1,"مَّدْحُورًا","مَطْرُودًا مِنْ رَحْمَةِ اللهِ."],[2,1,1,"نُّمِدُّ","نَزِيدُ مِنَ العَطَاءِ."],[2,11,1,"مَحْظُورًا","مَمْنُوعًا."],[4,8,1,"مَّخْذُولًا","غَيْرَ مَنْصُورٍ، وَلَا مُعَانٍ مِنَ اللهِ."],[5,0,1,"وَقَضَى","أَمَرَ، وَأَلْزَمَ، وَأَوْجَبَ."],[5,18,1,"أُفٍّ","كَلِمَةُ تَضَجُّرٍ وَتَبَرُّمٍ."],[6,0,4,"وَاخْفِضْ لَهُمَا جَنَاحَ الذُّلِّ","تَوَاضَعْ لَهُمَا."],[7,10,1,"لِلأَوَّابِينَ","لِلرَّاجِعِينَ إِلَيْهِ فِي كُلِّ وَقْتٍ."],[8,5,2,"وَابْنَ السَّبِيلِ","المُسَافِرَ، المُنْقَطِعَ فيِ سَفَرِهِ."],[8,7,2,"وَلَا تُبَذِّرْ","لَا تُنْفِقْ مَالَكَ فِي غَيْرِ طَاعَةٍ، أَوْ عَلَى وَجْهِ الإِسْرَافِ."]]