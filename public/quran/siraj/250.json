[[0,8,1,"الْمَثُلَاتُ","عُقُوبَاتُ أَمْثَالِهِمْ مِنَ المُكَذِّبِينَ."],[2,7,2,"تَغِيضُ الأَرْحَامُ","تَنْقُصُهُ الأَرْحَامُ؛ فَيَسْقُطُ قَبْلَ تَمَامِهِ."],[3,4,1,"الْمُتَعَالِ","العَالِي بِذَاتِهِ وَقَدْرِهِ وَقَهْرِهِ."],[4,12,1,"وَسَارِبٌ","مَنْ جَهَرَ بِأَعْمَالِهِ."],[5,1,1,"مُعَقِّبَاتٌ","مَلَائِكَةٌ يَتَعَاقَبُونَ عَلَى الإِنْسَانِ لِحِفْظِهِ، وَإِحْصَاءِ عَمَلِهِ."],[5,33,2,"مِن وَالٍ","وَلِيٍّ يَتَوَلَّى أُمُورَهُمْ، وَيَدْفَعُ البَلَاءَ عَنْهُمْ."],[7,18,1,"الْمِحَالِ","الحَوْلِ، وَالقُوَّةِ، وَالبَطْشِ."]]