[[0,5,1,"فُرَاتٌ","شَدِيدُ العُذُوبَةِ."],[0,6,1,"سَائِغٌ","سَهْلٌ مُرُورُهُ فِي الحَلْقِ."],[0,10,1,"أُجَاجٌ","شَدِيدُ المُلُوحَةِ."],[0,14,2,"لَحْمًا طَرِيًّا","هُوَ: السَّمَكُ."],[0,17,1,"حِلْيَةً","هِيَ: اللُّؤْلُؤُ، وَالمَرْجَانُ."],[0,20,1,"الْفُلْكَ","السُّفُنَ."],[0,22,1,"مَوَاخِرَ","تَشُقُّ المِيَاهَ."],[1,0,1,"يُولِجُ","يُدْخِلُ مِنْ سَاعَاِت اللَّيْلِ فيِ النَّهَارِ، وَالعَكْسُ، فَتَحْدُثُ الزِّيَادَةُ وَالنَّقْصُ فِيهِمَا."],[1,8,1,"وَسَخَّرَ","ذَلَّلَ."],[1,13,2,"لِأَجَلٍ مُّسَمًّى","لِوَقْتٍ مَعْلُومٍ مُقَدَّرٍ."],[1,27,1,"قِطْمِيرٍ","هِيَ: القِشْرَةُ الرَّقِيقَةُ البَيْضَاءُ عَلَى النَّوَاةِ."],[2,12,2,"يَكْفُرُونَ بِشِرْكِكُمْ","يَتَبَرَّؤُونَ مِنْكُمْ."],[6,0,2,"وَلَا تَزِرُ","لَا تَحْمِلُ."],[6,2,1,"وَازِرَةٌ","نَفْسٌ مُذْنِبَةٌ."],[6,3,2,"وِزْرَ أُخْرَى","ذَنْبَ نَفْسٍ أُخْرَى."],[6,6,1,"تَدْعُ","تَسْأَلْ."],[6,7,1,"مُثْقَلَةٌ","نَفْسٌ مُثْقَلَةٌ بِالخَطَايَا."],[6,9,1,"حِمْلِهَا","ذُنُوبِهَا الَّتي أَثْقَلَتْهَا."],[6,27,1,"تَزَكَّى","تُطَهُّرَ مِنَ الشِّرْكِ وَالمَعَاصِي."],[6,33,1,"الْمَصِيرُ","المَآلُ والمَرْجِعُ."]]