[[0,3,1,"الْحِكْمَةَ","الفِقْهَ فيِ الدِّينِ، وَالإِصَابَةَ فيِ القَوْلِ."],[2,5,1,"وَهْنًا","ضَعْفًا."],[2,8,1,"وَفِصَالُهُ","فِطَامُهُ عَنِ الرَّضَاعَةِ."],[3,18,1,"سَبِيلَ","طَرِيقَ."],[3,20,1,"أَنَابَ","رَجَعَ، وَتَابَ."],[4,4,1,"مِثْقَالَ","وَزْنَ، وَمِقْدَارَ."],[4,5,3,"حَبَّةٍ مِّنْ خَرْدَلٍ","حَبَّةٍ صَغِيرَةٍ مُتَنَاهِيَةٍ فيِ الصِّغَرِ."],[4,17,3,"يَاتِ بِهَا اللَّهُ","يَاتِ بِهَا يَوْمَ القِيَامَةِ، وَيُحَاسِبْ عَلَيْهَا."],[5,14,3,"مِنْ عَزْمِ الْأُمُورِ","مِنَ الأُمُورِ الَّتِي يَنْبَغِي الحِرْصُ عَلَيْهَا."],[6,0,3,"وَلَا تُصَعِّرْ خَدَّكَ","لَا تُمِلْ وَجْهَكَ كِبْرًا وَتَعَاظُمًا."],[6,8,1,"مَرَحًا","مُخْتَالًا مُتَبَخْتِرًا."],[6,14,1,"مُخْتَالٍ","مُتَكَبِّرٍ بِفِعْلِهِ."],[6,15,1,"فَخُورٍ","مُتَكَبِّرٍ بِقَوْلِهِ."],[7,0,1,"وَاقْصِدْ","تَوَاضَعْ، وَكُنْ بَيْنَ المُسْرِعِ، وَالمُبْطِئِ."],[7,3,1,"وَاغْضُضْ","اخْفِضْ."],[7,7,1,"أَنكَرَ","أَقْبَحَ، وَأَبْغَضَ."]]