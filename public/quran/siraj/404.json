[[0,11,1,"الْحَيَوَانُ","الحَيَاةُ الحَقِيقِيَّةُ الكَامِلَةُ الدَّائِمَةُ."],[1,3,1,"الْفُلْكِ","السُّفُنِ."],[3,4,2,"حَرَمًا آمِنًا","هِيَ: مَكَّةُ."],[3,6,2,"وَيُتَخَطَّفُ النَّاسُ","يُسْتَلَبُونَ بِسُرْعَةٍ قَتْلًا وَأَسْرًا."],[4,15,1,"مَثْوًى","مَسْكَنٌ وَمُسْتَقَرٌّ."],[7,0,2,"غُلِبَتِ الرُّومُ","هَزَمَتْ فَارِسُ الرُّومَ."],[8,1,2,"أَدْنَى الْأَرْضِ","أَقْرَبِ أَرْضِ الشَّامِ إِلَى فَارِسَ."],[8,6,1,"غَلَبِهِمْ","كَوْنِهِمْ مَغْلُوبِينَ."],[9,1,2,"بِضْعِ سِنِينَ","البِضْعُ: مُدَّةٌ لَا تَزِيدُ عَلَى عَشْرِ سَنَوَاتٍ، وَلَا تَنْقُصُ عَنْ ثَلَاثٍ."]]