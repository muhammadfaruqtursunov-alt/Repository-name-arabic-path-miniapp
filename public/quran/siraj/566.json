[[0,0,2,"خَاشِعَةً أَبْصَارُهُمْ","مُنْكَسِرَةً ذَلِيلَةً؛ لَا يَرْفَعُونَهَا."],[0,2,1,"تَرْهَقُهُمْ","تَغْشَاهُمْ."],[0,10,1,"سَالِمُونَ","أَصِحَّاءُ، قَادِرُونَ."],[1,4,1,"الْحَدِيثِ","القُرْآنِ."],[1,5,1,"سَنَسْتَدْرِجُهُم","سَنَمُدُّهُمْ بِالأَمْوَالِ وَالنِّعَمِ؛ اسْتِدْرَاجًا لَهُمْ."],[2,0,2,"وَأُمْلِي لَهُمْ","أُمْهِلُهُمْ، وَأُطِيلُ أَعْمَارَهُمْ."],[2,4,1,"مَتِينٌ","قَوِيٌّ، شَدِيدٌ."],[3,5,1,"مَّغْرَمٍ","غَرَامَةِ تِلْكَ الأُجْرَةِ."],[3,6,1,"مُّثْقَلُونَ","مُكَلَّفُونَ حِمْلًا ثَقِيلًا."],[4,0,2,"أَمْ عِندَهُمُ","بَلْ أَعِنْدَهُمْ."],[5,3,4,"وَلَا تَكُن كَصَاحِبِ الْحُوتِ","لَا تَكُنْ مِثْلَ يُونُسَ حِينَ اسْتَعْجَلَ العَذَابَ، وَغَضِبَ."],[5,10,1,"مَكْظُومٌ","مَمْلُوءٌ غَمًّا."],[6,3,3,"نِعْمَةٌ مِّن رَّبِّهِ","بِتَوْفِيقِهِ لِلتَّوْبَةِ، وَقَبُولِهَا."],[6,6,2,"لَنُبِذَ بِالْعَرَاءِ","لَطُرِحَ مِنْ بَطْنِ الحُوتِ بِالأَرْضِ الفَضَاءِ المُهْلِكَةِ."],[6,8,2,"وَهُوَ مَذْمُومٌ","آتٍ بِمَا يُلَامُ عَلَيْهِ."],[7,0,1,"فَاجْتَبَاهُ","اصْطَفَاهُ رَبُّهُ لِرِسَالَتِهِ."],[8,4,1,"لَيُزْلِقُونَكَ","لَيُسْقِطُونَكَ عَنْ مَكَانِكَ؛ بِنَظَرِهِمْ إِلَيْكَ؛ عَدَاوَةً وَبُغْضًا."],[10,0,1,"الْحَاقَّةُ","القِيَامَةُ الوَاقِعَةُ حَقًّا الَّتِي يَتَحَقَّقُ فِيهَا الوَعْدُ وَالوَعِيدُ."],[13,3,1,"بِالْقَارِعَةِ","بِالقِيَامَةِ الَّتِي تَقْرَعُ القُلُوبَ بِأَهْوَالِهَا."],[14,3,1,"بِالطَّاغِيَةِ","بِالصَّيْحَةِ الَّتِي جَاوَزَتِ الحَدَّ فِي شِدَّتِهَا."],[15,4,1,"صَرْصَرٍ","بَارِدَةٍ."],[15,5,1,"عَاتِيَةٍ","شَدِيدَةِ الهُبُوبِ."],[16,0,2,"سَخَّرَهَا عَلَيْهِمْ","سَلَّطَهَا عَلَيْهِمْ."],[16,6,1,"حُسُومًا","مُتُتُابِعَةً؛ لَا تَفْتُرُ، وَلَا تَنْقَطِعُ."],[16,10,1,"صَرْعَى","مَوْتَى."],[16,12,2,"أَعْجَازُ نَخْلٍ","أُصُولُ نَخْلٍ."],[16,14,1,"خَاوِيَةٍ","خَرِبَةٍ مُتَآكِلَةِ الأَجْوَافِ."]]