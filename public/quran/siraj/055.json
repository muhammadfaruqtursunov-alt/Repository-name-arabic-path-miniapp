[[0,9,1,"لَّدُنْكَ","عِنْدَكَ."],[1,16,1,"وَحَصُورًا","لَا يَقْرَبُ الذُّنُوبَ وَالشَّهَوَاتِ تَعَفُّفًا."],[2,10,1,"عَاقِرٌ","عَقِيمٌ لَا تَلِدُ."],[3,4,1,"آيَةً","عَلَامَةً أسْتَدِلُّ بِهَا عَلَى وَجَودِ الوَلَدِ مِنِّي."],[3,13,1,"رَمْزًا","إِشَارَةً."],[3,18,1,"بِالْعَشِيِّ","آخِرِ النَّهَارِ."],[5,1,1,"اقْنُتِي","دَاوِمِي عَلَى الطَّاعَةِ."],[6,10,2,"يُلْقُونَ أَقْلَامَهُمْ","يَطْرَحُونَ سِهَامَهُمْ لِلِاقْتِرَاعِ."]]