[[0,2,2,"ذِي الذِّكْرِ","المُشْتَمِلِ عَلَى تَذْكِيرِ النَّاسِ بِمَا هُمْ عَنْهُ غَافِلُونَ."],[1,4,1,"عِزَّةٍ","تَكَبُّرٍ، وَحَمِيَّةٍ."],[1,5,1,"وَشِقَاقٍ","مُخَالَفَةٍ، وَعِنَادٍ."],[2,0,2,"كَمْ أَهْلَكْنَا","كَثِيرًا مِنَ الأُمَمِ أَهْلَكْنَا."],[2,5,1,"قَرْنٍ","أُمَّةٍ سَابِقَةٍ."],[2,7,3,"وَلَاتَ حِينَ مَنَاصٍ","لَيْسَ الوَقْتُ وَقْتَ فِرَارٍ وَخَلَاصٍ."],[4,7,1,"عُجَابٌ","عَجِيبٌ."],[5,1,1,"الْمَلَأُ","الأَشْرَافُ، وَكِبَارُ القَوْمِ."],[5,4,1,"امْشُوا","اسْتَمِرُّوا عَلَى دِينِكُمْ، وَشِرْكِكُمْ."],[5,10,2,"لَشَيْءٌ يُرَادُ","مُدَبَّرٌ يُقْصَدُ مِنْهُ التَّرَؤُسُ، وَالسِّيَادَةُ."],[6,4,2,"الْمِلَّةِ الْآخِرَةِ","دِينِ آبَائِنَا وَدِينِ النَّصَارَى."],[6,9,1,"اخْتِلَاقٌ","كَذِبٌ، وَافْتِرَاءٌ."],[9,7,3,"فَلْيَرْتَقُوا فِي الْأَسْبَابِ","فَلْيَاخُذُوا بِالأَسْبَابِ المُوصِلَةِ إِلَى السَّمَاءِ، وَلْيَمْنُعوا الوَحْيَ."],[10,0,2,"جُندٌ مَّا","جُنُودٌ قَلِيلُونَ حَقِيرُونَ."],[11,6,2,"ذُو الْأَوْتَادِ","صَاحِبُ الجُنُودِ، وَالقُوَّةِ العَظِيمَةِ."],[12,3,2,"وَأَصْحَابُ الأَيْكَةِ","أَصْحَابُ الأَشْجَارِ وَالبَسَاتِينِ؛ وَهُمْ قَوْمُ شُعَيْبٍ - عليه السلام -."],[13,5,2,"فَحَقَّ عِقَابِ","فَوَجَبَ العِقَابُ عَلَيْهِمْ."],[14,0,2,"وَمَا يَنظُرُ","مَا يَنْتَظِرُ."],[14,4,2,"صَيْحَةً وَاحِدَةً","نَفْخَةَ القِيَامَةِ."],[14,9,1,"فَوَاقٍ","رُجُوعٍ."],[15,4,1,"قِطَّنَا","نَصِيبَنَا مِنَ العَذَابِ."]]