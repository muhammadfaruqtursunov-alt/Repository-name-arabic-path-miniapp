[[0,1,2,"يَشْرَبُ بِهَا","يَشْرَبُونَ مُتَلَذِّذِينَ بِهَا."],[0,5,1,"يُفَجِّرُونَهَا","يُجْرُونَهَا إِجْرَاءً سَهْلًا حَيْثُ شَاؤُوا."],[1,1,1,"بِالنَّذْرِ","بِمَا أَوْجَبُوا عَلَى أَنْفُسِهِمْ مِنَ الطَّاعَاتِ."],[1,6,1,"مُسْتَطِيرًا","فَاشِيًا مُنْتَشِرًا عَلَى النَّاسِ."],[2,5,1,"وَيَتِيمًا","طِفْلًا مَاتَ وَالِدُهُ قَبْلَ بُلُوغِهِ، وَلَا مَالَ لَهُ."],[2,6,1,"وَأَسِيرًا","المَاخُوذَ فِي الحَرْبِ."],[4,5,1,"عَبُوسًا","تَكْلَحُ فِيهِ الوُجُوهُ لِهَوْلِهِ."],[4,6,1,"قَمْطَرِيرًا","شَدِيدَ العُبُوسِ."],[5,5,1,"وَلَقَّاهُمْ","أَعْطَاهُمْ."],[5,6,1,"نَضْرَةً","حُسْنًا وَنُورًا."],[7,3,1,"الْأَرَائِكِ","الأَسِرَّةِ المُزَيَّنَةِ بِفَاخِرِ الثِّيَابِ، وَالسُّتُورِ."],[7,9,1,"زَمْهَرِيرًا","شِدَّةَ بَرْدٍ."],[8,0,1,"وَدَانِيَةً","قَرِيبَةً أَشْجَارُهَا."],[8,3,2,"وَذُلِّلَتْ قُطُوفُهَا","سُهِّلَ لَهُمْ أَخْذُ ثِمَارِهَا."],[9,7,1,"قَوَارِيرَا","مِنَ الزُّجَاجِ."],[10,3,1,"قَدَّرُوهَا","قَدَّرَهَا السُّقَاةُ عَلَى مِقْدَارِ مَا يَشْتَهِي الشَّارِبُونَ."],[11,2,1,"كَاسًا","إِنَاءً مَمْلُوءًا خَمْرًا."],[12,2,2,"تُسَمَّى سَلْسَبِيلًا","سُمِّيَتْ بِذَلِكَ؛ لِسَلَاسَةِ شُرْبِهَا، وَسُهُولَةِ مَسَاغِهِ."],[13,2,2,"وِلْدَانٌ مُّخَلَّدُونَ","غِلْمَانٌ لِلْخِدْمَةِ دَائِمُونَ عَلَى حَالِهِمْ."],[13,7,1,"لُؤْلُؤًا","كَاللُّؤْلُؤِ المُفَرَّقِ المُضِيءِ؛ لِحُسْنِهِمْ، وَصَفَاءِ أَلْوَانِهِمْ."],[14,0,3,"وَإِذَا رَأَيْتَ ثَمَّ","وَإِذَا أَبْصَرْتَ أَيَّ مَكَانٍ فِي الجَنَّةِ."],[15,0,1,"عَالِيَهُمْ","يَعْلُوهُمْ."],[15,1,2,"ثِيَابُ سُندُسٍ","الحَرِيرُ الرَّقِيقُ الأَخْضَرُ؛ وَهَذَا بَاطِنُ الثِّيَابِ."],[15,4,1,"وَإِسْتَبْرَقٌ","الحَرِيرُ الغَلِيظُ؛ وَهَذَا ظَاهِرُ الثُيَابِ."],[15,12,1,"طَهُورًا","لَا رِجْسَ فِيهِ، وَلَا دَنَسَ."],[16,6,1,"سَعْيُكُم","عَمَلُكُمُ الصَّالِحُ فِي الدُّنْيَا."],[18,1,2,"لِحُكْمِ رَبِّكَ","لِأَمْرِهِ القَدَرِيِّ فَتَقْبَلُهُ، وَلَأَمْرِهِ الشَّرْعِيِّ فَتَمْضِي عَلَيْهِ."],[19,3,2,"بُكْرَةً وَأَصِيلًا","أَوَّلَ النَّهَارِ، وَآخِرَهُ."]]