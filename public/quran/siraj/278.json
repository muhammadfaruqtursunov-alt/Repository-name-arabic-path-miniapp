[[2,2,1,"يَنفَدُ","يَذْهَبُ وَيَفْنَى."],[4,7,1,"الرَّجِيمِ","المَطْرُودِ مِنْ رَحْمَةِ اللهِ."],[5,3,1,"سُلْطَانٌ","تَسَلُّطٌ."],[6,4,1,"يَتَوَلَّوْنَهُ","يَتَّخِذُونَهُ وَلِيًّا مُطَاعًا."],[7,12,1,"مُفْتَرٍ","كَاذِبٌ، مُخْتَلِقٌ عَلَى اللهِ."],[8,2,2,"رُوحُ الْقُدُسِ","الرُّوحُ المُطَهَّرُ: جِبْرِيلُ - عليه السلام -."]]