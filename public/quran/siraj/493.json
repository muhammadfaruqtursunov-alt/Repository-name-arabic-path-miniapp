[[0,5,1,"آيَةٍ","حُجَّةٍ عَلَى صِدْقِ دَعْوَتِهِ."],[0,10,1,"بِالْعَذَابِ","مِنَ الجَرَادِ، وَالقُمَّلِ، وَالضَّفَادِعِ، وَنَحْوِهَا."],[1,2,1,"السَّاحِرُ","العَالِمُ (وَكَانَ السَّاحِرُ فِيهِمْ عَظِيمًا يُوَقِّرُونَهُ، وَلَمْ يَكُنْ صِفَةَ ذَمٍّ)."],[1,6,3,"بِمَا عَهِدَ عِندَكَ","بِعَهْدِهِ الَّذِي عَهِدَ إِلَيْكَ، وَمَا خَصَّكَ بِهِ مِنَ الفَضَائِلِ."],[2,6,1,"يَنكُثُونَ","يَغْدِرُونَ، وَيُصِرُّونَ عَلَى الكُفْرِ."],[4,7,1,"مَهِينٌ","ضَعِيفٌ لَا عِزَّ لَهُ."],[4,8,3,"وَلَا يَكَادُ يُبِينُ","لَا يَكَادُ يُفْصِحُ فِي كَلَامِهِ."],[5,10,1,"مُقْتَرِنِينَ","مَقْرُونِينَ مَعَهُ يُصَدِّقُونَهُ."],[6,0,2,"فَاسْتَخَفَّ قَوْمَهُ","اسْتَخَفَّ بِعُقُولِهِمْ."],[7,1,1,"آسَفُونَا","أَغْضَبُونَا."],[8,1,1,"سَلَفًا","قُدْوَةً لِمَنْ يَعْمَلُ مِثْلَ عَمَلِهِمْ؛ فَيَسْتَحِقُّ العُقُوبَةَ."],[8,2,1,"وَمَثَلًا","عِظَةً، وَعِبْرَةً."],[9,8,1,"يَصِدُّونَ","يَضَجُّونَ، وَيَصِيحُونَ، فَرَحًا، وَجَذَلًا."],[10,13,1,"خَصِمُونَ","شَدِيدُو الخُصُومَةِ بِالبَاطِلِ."],[11,7,1,"مَثَلًا","عِبْرَةً، وَآيَةً."],[12,2,2,"لَجَعَلْنَا مِنكُم","لَجَعَلْنَا بَدَلَكُمْ."],[12,7,1,"يَخْلُفُونَ","يَخْلُفُ بَعْضُهُمْ بَعْضًا، بَدَلًا مِنْ بَنِي آدَمَ."]]