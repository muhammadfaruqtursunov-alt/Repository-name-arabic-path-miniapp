[[1,1,3,"لَا يُغْنِي مَوْلًى","لَا يَدْفَعُ صَاحِبٌ."],[4,1,1,"الْأَثِيمِ","صَاحِبُ الآثَامِ الكَبِيرَةِ."],[5,0,1,"كَالْمُهْلِ","كَالمَعْدَنِ المُذَابِ."],[6,1,1,"الْحَمِيمِ","المَاءِ الَّذِي بَلَغَ الغَايَةَ فيِ الحَرَارَةِ."],[7,1,1,"فَاعْتِلُوهُ","جُرُّوهُ وَسُوقُوهُ بِعُنْفٍ."],[7,3,2,"سَوَاءِ الْجَحِيمِ","وَسَطِ الجَحِيمِ."],[9,2,3,"أَنتَ الْعَزِيزُ الْكَرِيمُ","عَلَى وَجْهِ التَّهَكُّمِ، وَالتَّوْبِيخِ لَهُمْ."],[10,5,1,"تَمْتَرُونَ","تَشُكُّونَ."],[11,3,2,"مَقَامٍ أَمِينٍ","مَوْضِعٍ يُؤْمَنُ فِيهِ الخَوْفُ، وَالآفَاتُ، وَالأَحْزَانُ."],[13,2,1,"سُندُسٍ","هُوَ: الرَّقِيقُ مِنَ الدِّيبَاجِ."],[13,3,1,"وَإِسْتَبْرَقٍ","هُوَ: الغَلِيظُ مِنَ الدِّيبَاجِ."],[14,2,2,"بِحُورٍ عِينٍ","نِسَاءِ الجَنَّةِ الحِسَانِ، الوَاسِعَاتِ الأَعْيُنِ."],[15,0,2,"يَدْعُونَ فِيهَا","يَطْلُبُونَ فِيهَا."],[16,5,2,"الْمَوْتَةَ الْأُولَى","الَّتِي ذَاقُوهَا فِي الدُّنْيَا."],[19,0,1,"فَارْتَقِبْ","انْتَظِرْ نَصْرَكَ، وَهَلَاكَهُمْ."],[19,2,1,"مُّرْتَقِبُونَ","مُنْتَظِرُونَ مَوْتَكَ، وَهَزِيمَتَكَ."]]