[[0,4,1,"بِالْبُشْرَى","بِالخَبَرِ السَّارِّ، وَهُوَ: البِشَارَةُ بِإِسْحَاقَ - عليه السلام -."],[1,15,1,"الْغَابِرِينَ","البَاقِينَ فيِ العَذَابِ."],[2,5,2,"سِيءَ بِهِمْ","سَاءَهُ مَجِيئُهُمْ خَوْفًا عَلَيْهِمْ مِنْ قَوْمِهِ أَنْ يَفْعَلُوا بِهِمُ الفَاحِشَةَ."],[2,7,3,"وَضَاقَ بِهِمْ ذَرْعًا","ضَاقَ صَدْرُهُ، وَحَزِنَ خَوْفًا عَلَيْهِمْ."],[3,6,1,"رِجْزًا","عَذَابًا شَدِيدًا."],[4,1,2,"تَّرَكْنَا مِنْهَا","أَبْقَيْنَا مِنْ دِيَارِهِمُ."],[4,3,2,"آيَةً بَيِّنَةً","آثَارًا وَاضِحَةً."],[5,8,3,"وَارْجُوا الْيَوْمَ الْآخِرَ","اطْلُبُوا بِعِبَادَتِكُمْ جَزَاءَ الآخِرَةِ."],[5,11,2,"وَلَا تَعْثَوْا","لَا تُكْثِرُوا الفَسَادَ."],[6,2,1,"الرَّجْفَةُ","الزَّلْزَلَةُ الشَّدِيدَةُ."],[6,6,1,"جَاثِمِينَ","صَرْعَى هَالِكِينَ."],[7,15,1,"مُسْتَبْصِرِينَ","عَارِفِينَ بِكُفْرِهِمْ مُعْجَبِينَ بِهِ."]]