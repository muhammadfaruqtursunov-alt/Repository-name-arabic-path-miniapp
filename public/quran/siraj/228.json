[[0,3,1,"اعْتَرَاكَ","أَصَابَكَ."],[0,6,1,"بِسُوَءٍ","بِجُنُونٍ."],[1,2,1,"فَكِيدُونِي","فَاجْتَهِدُوا فِي إِيصَالِ الضُّرِّ إِلَيَّ."],[1,4,3,"ثُمَّ لَا تُنْظِرُونِ","لَا تُمْهِلُونِي."],[2,11,2,"آخِذٌ بِنَاصِيَتِهَا","مَالِكُهَا، وَالمُتَصَرِّفُ فِيهَا."],[3,8,1,"وَيَسْتَخْلِفُ","يَاتِي بِقَوْمٍ آخَرِينَ يَخْلُفُونَكُمْ فِي دِيَارِكُمْ."],[3,20,1,"حَفِيظٌ","يَحْفَظُ مِنْ كُلِّ سُوءٍ."],[4,13,1,"غَلِيظٍ","شَدِيدٍ."],[5,10,1,"جَبَّارٍ","مُسْتَكْبِرٍ."],[5,11,1,"عَنِيدٍ","لَا يَقْبَلُ الحَقَّ."],[7,14,1,"أَنشَأَكُمْ","ابْتَدَأَ خَلْقَكُمْ."],[7,17,2,"وَاسْتَعْمَرَكُمْ فِيهَا","جَعَلَكُمْ عُمَّارًا لَهَا."],[8,3,3,"كُنتَ فِينَا مَرْجُوًّا","كُنَّا نَرْجُو أَنْ تَكُونَ سَيِّدًا."],[8,20,1,"مُرِيبٍ","مُوقِعٍ فِي الرَّيْبِ وَالشَّكِّ."]]