[[0,4,1,"السِّقَايَةَ","الإِنَاءَ الَّذِي كَانَ يَكِيلُ بِهِ لِلنَّاسِ."],[0,6,1,"رَحْلِ","مَتَاعِ."],[0,12,1,"الْعِيرُ","القَافِلَةُ فِيهَا الأَحْمَالُ."],[2,2,1,"صُوَاعَ","صَاعَ."],[2,11,1,"زَعِيمٌ","ضَامِنٌ، وَكَافِلٌ."],[5,6,2,"فَهُوَ جَزَاؤُهُ","يَكُونُ السَّارِقُ عَبْدًا لِلْمَسْرُوقِ مِنْهُ."],[6,18,2,"دِينِ الْمَلِكِ","حُكْمِهِ وَقَضَائِهِ؛ لِأَنَّهُ لَيْسَ فِيهِ اسْتِعْبَادُ السَّارِقِ."]]