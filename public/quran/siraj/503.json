[[2,2,1,"افْتَرَاهُ","اخْتَلَقَهُ."],[2,15,2,"تُفِيضُونَ فِيهِ","تَقُولُونَ فيِ القُرْآنِ."],[3,3,3,"بِدْعًا مِّنْ الرُّسُلِ","أَوَّلَ رُسُلِ اللهِ إِلَى خَلْقِهِ."],[4,1,1,"أَرَأَيْتُمْ","أَخْبِرُونِي."],[4,9,2,"وَشَهِدَ شَاهِدٌ","كَعَبْدِ اللهِ بْنِ سَلَامٍ - رضي الله عنه -."],[5,17,2,"إِفْكٌ قَدِيمٌ","كَذِبٌ مَاثُورٌ عَنِ النَّاسِ الأَقْدَمِينَ."],[6,4,1,"إِمَامًا","هَادِيًا يَاتَمُّونَ بِهِ، وَيَعْمَلُونَ."],[6,8,1,"مُّصَدِّقٌ","لِكُتُبٍ قَبْلَهُ."],[7,6,1,"اسْتَقَامُوا","ثَبَتُوا عَلَى الإِيمَانِ وَالطَّاعَةِ."]]