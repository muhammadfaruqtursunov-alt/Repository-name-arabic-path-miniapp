[[0,2,1,"حَافِّينَ","مُحْدِقِينَ، وَمُحِيطِينَ."],[0,9,3,"وَقُضِيَ بَيْنَهُم بِالْحَقِّ","حُكِمَ بَيْنَ الخَلَائِقِ بِالعَدْلِ."],[3,6,2,"ذِي الطَّوْلِ","صَاحِبِ الإِنْعَامِ وَالتَّفَضُّلِ."],[3,13,1,"الْمَصِيرُ","المَرْجِعُ."],[4,8,2,"فَلَا يَغْرُرْكَ","فَلَا يَخْدَعْكَ."],[4,10,1,"تَقَلُّبُهُمْ","تَنَقُّلُهُمْ وَتَرَدُّدُهُمْ بِأَنْوَاعِ التِّجَارَاتِ وَالنَّعِيمِ."],[5,4,1,"وَالْأَحْزَابُ","الأُمَمُ المُتَحَزِّبَةُ عَلَى رُسُلِهِمْ، مُعْلِنِينَ الحَرْبَ عَلَيْهِمْ."],[5,11,1,"لِيَاخُذُوهُ","لِيَقْتُلُوهُ."],[5,14,1,"لِيُدْحِضُوا","لِيُبْطِلُوا."],[6,1,1,"حَقَّتْ","وَجَبَتْ."],[7,23,1,"سَبِيلَكَ","طَرِيقَكَ؛ وَهُوَ الإِسْلَامُ."],[7,24,1,"وَقِهِمْ","جَنِّبْهُمْ."]]