[[0,14,2,"نَّجْوَى ثَلَاثَةٍ","تَنَاجِي ثَلَاثَةٍ بِحَدِيثِ سِرٍّ."],[1,20,5,"بِمَا لَمْ يُحَيِّكَ بِهِ اللَّهُ","قَالُوا لَكَ: السَّامُ عَلَيْكُمْ، أَيِ: المَوْتُ لَكَ."],[1,28,1,"لَوْلَا","هَلَّا."],[1,33,1,"حَسْبُهُمْ","كَافِيَتُهُمْ."],[1,37,1,"الْمَصِيرُ","المَرْجِعُ، وَالمَآلُ."],[3,0,2,"إِنَّمَا النَّجْوَى","التَّحَدُّثُ بِخُفْيَةٍ بِالإِثْمِ وَالعُدْوَانِ."],[4,6,1,"تَفَسَّحُوا","لِيُوسِعْ بَعْضُكُمْ لِبَعْضٍ فيِ المَجَالِسِ."],[4,15,1,"انشُزُوا","قُومُوا مِنْ مَجَالِسِكُمْ لِأَمْرٍ فِيه خَيْرٌ لَكُمْ."]]