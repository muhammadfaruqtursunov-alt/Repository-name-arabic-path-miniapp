[[0,7,1,"لَّلَجُّوا","لَتَمَادَوْا."],[0,10,1,"يَعْمَهُونَ","يَتَحَيَّرُونَ وَيَتَخَبَّطُونَ."],[1,4,1,"اسْتَكَانُوا","خَضَعُوا."],[2,11,1,"مُبْلِسُونَ","آيِسُونَ مِنْ كُلِّ خَيْرٍ مُتَحَيِّرُونَ."],[4,2,1,"ذَرَأَكُمْ","خَلَقَكُمْ، وَبَثَّكُمْ."],[13,7,1,"يُجِيرُ","يَحْمِي وَيُغِيثُ مَنْ يَشَاءُ."],[13,8,3,"وَلَا يُجَارُ عَلَيْهِ","لَا يُغَاثُ أَحَدٌ وَيُحْمَى مِنْهُ."],[14,3,2,"فَأَنَّى تُسْحَرُونَ","فَكَيْفَ تَذْهَبُ عُقُولُكُمْ وَتُخْدَعُونَ عَنْ تَوْحِيدِهِ؟!"]]