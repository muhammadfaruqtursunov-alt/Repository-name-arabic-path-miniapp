[[0,6,1,"وَالصَّابِئِينَ","قَوْمٌ بَاقُونَ عَلَى فِطْرَتِهِمْ، وَلَا دِينَ لَهُمْ يَتَّبِعُونَهُ."],[1,5,1,"الطُّورَ","جَبَلٌ بِسَيْنَاءَ."],[3,11,1,"خَاسِئِينَ","مَنْبُوذِينَ."],[4,1,1,"نَكَالًا","عِبْرَةً."],[6,14,1,"فَارِضٌ","مُسِنَّةٌ هَرِمَةٌ."],[6,16,1,"بِكْرٌ","صَغِيرَةُ فَتِيَّةٌ."],[6,17,1,"عَوَانٌ","مُتَوَسِّطةٌ بَيْنَ الْمُسِنَّةِ وَالصَّغِيرَةِ."],[7,14,1,"فَاقِعٌ","شَدِيدَةُ الصُّفْرَةِ."]]