[[0,7,2,"غَيْرُ مَمْنُونٍ","غَيْرُ مَقْطُوعٍ، وَلَا مَنْقُوصٍ."],[1,1,2,"ذَاتِ الْبُرُوجِ","ذَاتِ المَنَازِلِ الَّتِي تَمُرُّ بِهَا الشَّمْسُ، وَالقَمَرُ."],[2,0,2,"وَالْيَوْمِ الْمَوْعُودِ","هُوَ: يَوْمُ القِيَامَةِ."],[3,0,2,"وَشَاهِدٍ وَمَشْهُودٍ","أَقْسَمَ اللهُ بِكُلِّ شَاهِدٍ يَشْهَدُ، وَبِكُلِّ مَنْ يُشْهَدُ عَلَيْهِ."],[4,0,1,"قُتِلَ","لُعِنَ، وَعُذِّبَ، وَهَلَكَ."],[4,1,2,"أَصْحَابُ الْأُخْدُودِ","الَّذِينَ شَقُّوا فِي الأَرْضِ شَقًّا عَظِيمًا؛ لِإِحْرَاقِ المُؤْمِنِينَ."],[5,2,1,"الْوَقُودِ","مَا تُشْعَلُ وَتُوقَدُ بِهِ النَّارُ."],[7,5,1,"شُهُودٌ","حُضُورٌ."],[10,2,1,"فَتَنُوا","حَرَّقُوا بِالنَّارِ."],[10,12,2,"عَذَابُ الْحَرِيقِ","العَذَابُ المُحْرِقُ."],[12,1,1,"بَطْشَ","انْتِقَامَ."],[13,2,1,"يُبْدِئُ","يَخْلُقُ الخَلْقَ ابْتِدَاءً."],[13,3,1,"وَيُعِيدُ","يُحْيِيهِمْ بَعْدَ مَوْتِهِمْ."],[14,2,1,"الْوَدُودُ","المُحِبُّ لِأَوْلِيَائِهِ، المَحْبُوبُ لَهُمْ."],[15,2,1,"الْمَجِيدُ","العَظِيمُ."]]