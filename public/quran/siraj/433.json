[[1,1,1,"سُبْحَانَكَ","نُنَزِّهُكَ."],[1,2,2,"أَنتَ وَلِيُّنَا","أَنْتَ الَّذِي نُوَالِيهِ وَنَعْبُدُهُ."],[3,21,2,"إِفْكٌ مُّفْتَرًى","كَذِبٌ مُخْتَلَقٌ."],[4,4,1,"يَدْرُسُونَهَا","يَقْرَؤُونَهَا."],[5,6,3,"مِعْشَارَ مَا آتَيْنَاهُمْ","عُشْرَ مَا أَعْطَيْنَاهُمْ مِنَ القُوَّةِ وَالنِّعَمِ."],[5,13,1,"نَكِيرِ","إِنْكَارِي عَلَيهِمْ."],[6,3,1,"بِوَاحِدَةٍ","بِخَصْلَةٍ وَاحِدَةٍ."],[6,7,1,"مَثْنَى","اثْنَيْنِ اثْنَيْنِ."],[6,14,1,"جِنَّةٍ","جُنُونٍ."],[8,3,2,"يَقْذِفُ بِالْحَقِّ","يَرْمِي بِحُجَجِ الحَقِّ عَلَى البَاطِلِ؛ فَيَدْمَغُهُ."]]