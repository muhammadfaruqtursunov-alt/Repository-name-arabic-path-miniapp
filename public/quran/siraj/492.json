[[1,0,1,"وَزُخْرُفًا","ذَهَبًا."],[1,1,4,"وَإِن كُلُّ ذَلِكَ لَمَّا","مَا كُلُّ ذَلِكَ إِلَّا."],[2,1,1,"يَعْشُ","يُعْرِضْ."],[2,5,1,"نُقَيِّضْ","نُهَيِّئْ، وَنُيَسِّرْ."],[2,10,1,"قَرِينٌ","مُلَازِمٌ، وَمُصَاحِبٌ."],[4,7,2,"بُعْدَ الْمَشْرِقَيْنِ","مِثْلَ تَبَاعُدِ مَا بَيْنَ المَشْرِقِ، وَالمَغْرِبِ."],[10,1,1,"لَذِكْرٌ","لَشَرَفٌ؛ لِأَنَّهُ أُنْزِلَ بِلُغَتِهِمْ."],[12,6,1,"وَمَلَئِهِ","أَشْرَافُ قَوْمِهِ."]]