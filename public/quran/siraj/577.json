[[2,1,1,"حُمُرٌ","حُمُرٌ وَحْشِيَّةٌ شَدِيدَةُ النِّفَارِ."],[3,2,1,"قَسْوَرَةٍ","أَسَدٍ كَاسِرٍ."],[8,7,2,"أَهْلُ التَّقْوَى","أَهْلٌ لِأَنْ يُتَّقَى، وَيُطَاعَ."],[9,0,2,"لَا أُقْسِمُ","أُقْسِمُ، وَ (لَا): تَاكِيدٌ لِلْقَسَمِ."],[10,3,1,"اللَّوَّامَةِ","النَّفْسِ الَّتِي تَلُومُ صَاحِبَهَا."],[12,4,2,"نُّسَوِّيَ بَنَانَهُ","نَجْعَلَ أَصَابِعَ يَدَيْهِ وَرِجْلَيْهِ شَيْئًا مُسْتَوِيًا؛ كَخُفِّ البَعِيرِ، أَوْ نُعِيدَ خَلْقَهَا كَمَا كَانَتْ."],[14,1,1,"أَيَّانَ","مَتَى؟"],[15,1,2,"بَرِقَ الْبَصَرُ","تَحَيَّرَ البَصَرُ وَدُهِشَ لِأَهْوَالِ القِيَامَةِ."],[16,-1,0,"وَجُمِعَ الشَّمْسُ وَالْقَمَرُ","قُرِنَ بَيْنَهُمَا فِي الطُّلُوعِ مِنَ المَغْرِبِ مُظْلِمَيْنِ."],[19,1,2,"لَا وَزَرَ","لَا مَلْجَأَ وَلَا مَنْجَى لَهُ مِنَ اللهِ."],[20,3,1,"الْمُسْتَقَرُّ","المَرْجعُ، وَالمَصِيرُ."],[22,2,3,"عَلَى نَفْسِهِ بَصِيرَةٌ","شَاهِدٌ تَنْطقُ جَوَارِحُهُ بِعَملِهِ."],[23,0,3,"وَلَوْ أَلْقَى مَعَاذِيرَهُ","لَوْ جَاءَ بِكُلِّ مَعْذِرَةٍ يَعْتَذِرُ بِهَا، مَا قُبِلَتْ."],[24,4,2,"لِتَعْجَلَ بِهِ","لِتَسْتَعْجِلَ حِفْظَ مَا يُوحَى إِلَيْكَ."],[25,2,1,"جَمْعَهُ","فِي صَدْرِكَ."],[25,3,1,"وَقُرْآنَهُ","قِرَاءَتَهُ بِلِسَانِكَ مَتَى شِئْتَ."],[26,2,2,"فَاتَّبِعْ قُرْآنَهُ","اسْتَمِعْ لِقِرَاءَتِهِ مِنْ جِبْرِيلَ، ثُمَّ اقْرَاهُ كَمَا أَقْرَأَكَ."],[27,3,1,"بَيَانَهُ","تَفْسِيرَ مَا أَشْكَلَ عَلَيْكَ فَهْمُهُ."]]