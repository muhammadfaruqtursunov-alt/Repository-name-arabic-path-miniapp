[[0,11,1,"حَسْبُنَا","كَافِينَا."],[1,3,2,"عَلَيْكُمْ أَنفُسَكُمْ","أَلْزِمُوا أَنْفُسَكُمُ الْعَمَلَ بِالطَّاعَةِ."],[2,21,3,"ضَرَبْتُمْ فِي الأَرْضِ","سَافَرْتُمْ."],[3,5,1,"إِثْمًا","خِيَانَةً."],[3,13,1,"الأَوْلَيَانِ","الأَقْرَبَانِ لِلْمَيِّتِ."],[4,1,1,"أَدْنَى","أَقْرَبُ."],[4,5,2,"عَلَى وَجْهِهَا","عَلَى حَقِيقَتِهَا."]]