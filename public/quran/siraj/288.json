[[0,13,1,"مُبْصِرَةً","مُعْجِزَةً وَاضِحَةً."],[1,9,1,"الرُّؤيَا","مَا رَأَيْتَهُ لَيْلَةَ الإِسْرَاءِ والمِعْرَاج بِعَيْنِكَ مِنَ العَجَائِبِ."],[1,15,2,"وَالشَّجَرَةَ الْمَلْعُونَةَ","شَجَرَةَ الزَّقُّومِ."],[3,1,1,"أَرَأَيْتَكَ","أَخْبِرْنِي."],[3,11,1,"لأَحْتَنِكَنَّ","لَأَسْتَوْلِيَنَّ عَلَيْهِمْ."],[4,9,1,"مَّوْفُورًا","وَافِرًا."],[5,0,1,"وَاسْتَفْزِزْ","اسْتَخِفَّ، وَاسْتَعْجِلْ."],[5,4,1,"بِصَوْتِكَ","بِدُعَائِكَ إِيَّاهُمْ لِلْمَعَاصِي، وَبِالغِنَاءِ وَالمَزَامِيرِ."],[5,5,1,"وَأَجْلِبْ","اجْمَعْ، وَصِحْ عَلَيْهِمْ."],[5,7,2,"بِخَيْلِكَ وَرَجِلِكَ","بِجُنُودِكَ الرَّاكِبِينَ، وَالرَّاجِلِينَ فِي مَعْصِيَةِ اللهِ."],[5,18,1,"غُرُورًا","بَاطِلًا وخِدَاعًا."],[7,2,1,"يُزْجِي","يُسَيِّرُ، وَيُجْرِي."],[7,4,1,"الْفُلْكَ","السُّفُنَ."]]