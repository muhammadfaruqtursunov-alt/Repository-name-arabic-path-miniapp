[[1,3,1,"الْقَيِّمِ","المُسْتَقِيمِ."],[1,9,3,"لَّا مَرَدَّ لَهُ","لَا يَقْدِرُ أَحَدٌ عَلَى رَدِّهِ."],[1,15,1,"يَصَّدَّعُونَ","يَتَفَرَّقُ الخَلَائِقُ أَشْتَاتًا، ثُمَّ مَآلُهُمْ إِلَى الجَنَّةِ، أَوِ النَّارِ."],[2,8,1,"يَمْهَدُونَ","يُهَيِّئُونَ مَنَازِلَهُمْ فيِ الجَنَّةِ."],[4,5,1,"مُبَشِّرَاتٍ","تُبَشِّرُ بِالمَطَرِ."],[4,10,1,"الْفُلْكُ","السُّفُنُ."],[4,11,1,"بِأَمْرِهِ","بِإِرَادَةِ اللهِ، وَمَشِيئَتِهِ."],[6,4,1,"فَتُثِيرُ","تُحَرِّكُ، وَتَنْشُرُ."],[6,12,1,"كِسَفًا","قِطَعًا مُتَفَرَّقَةً."],[6,14,1,"الْوَدْقَ","المَطَرَ."],[6,16,2,"مِنْ خِلَالِهِ","مِنْ بَيْنِ السَّحَابِ."],[7,9,1,"لَمُبْلِسِينَ","يَائِسِينَ مِنْ نُزُولِهِ."],[8,3,2,"رَحْمَتِ اللَّهِ","المَطَرِ."]]