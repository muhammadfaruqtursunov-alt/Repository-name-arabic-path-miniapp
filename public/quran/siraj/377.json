[[3,9,1,"يَعْمَهُونَ","يَتَرَدَّدُونَ فِي أَعْمَالِهِمُ القَبِيحَةِ مُتَحَيِّرِينَ."],[5,1,1,"لَتُلَقَّى","لَتَتَلَقَّى."],[5,3,2,"مِن لَّدُنْ","من عِنْدِ."],[6,5,1,"آنَسْتُ","أَبْصَرْتُ."],[6,12,2,"بِشِهَابٍ قَبَسٍ","بِشُعْلَةِ نَارٍ."],[6,15,1,"تَصْطَلُونَ","تَسْتَدْفِئُونَ بِهَا مِنَ البَرْدِ."],[7,4,1,"بُورِكَ","قُدِّسَ وَطُهِّرَ."],[7,10,2,"وَسُبْحَانَ اللَّهِ","تَنْزِيهًا للِه عَمَّا لَا يَلِيقُ بِهِ."],[9,4,1,"تَهْتَزُّ","تَتَحَرَّكُ فِي خِفَّةٍ."],[9,6,1,"جَانٌّ","حَيَّةٌ خَفِيفَةٌ."],[9,8,1,"مُدْبِرًا","هَارِبًا."],[9,10,1,"يُعَقِّبْ","يَرْجِعْ عَلَى عَقِبِهِ."],[10,0,3,"إِلَّا مَنْ ظَلَمَ","لَكِنْ مَنْ ظَلَمَ نَفْسَهُ."],[11,3,1,"جَيْبِكَ","فَتْحَةِ القَمِيصِ الَّتِي يَدْخُلُ مِنْهَا الرَّاسُ."],[11,6,3,"مِنْ غَيْرِ سُوءٍ","مِنْ غَيْرِ بَرَصٍ وَلَا مَرَضٍ."],[12,2,1,"آيَاتُنَا","مُعْجِزَاتُنَا."],[12,3,1,"مُبْصِرَةً","ظَاهِرَةً بَيِّنَةً."],[12,7,1,"مُّبِينٌ","وَاضِحٌ بَيِّنٌ."]]