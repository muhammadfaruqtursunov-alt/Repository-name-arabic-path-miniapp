[[0,6,1,"وَاصْطَبِرْ","الْزَمِ الصَّبْرَ."],[0,11,1,"سَمِيًّا","مَثِيلًا، وَمُضَاهِيًا، فِي ذَاتِهِ، وَصِفَاتِهِ."],[3,7,1,"جِثِيًّا","بَارِكِينَ عَلَى رُكَبِهِمْ مِنَ الهَوْلِ."],[4,4,1,"شِيعَةٍ","طَائِفَةٍ."],[4,9,1,"عِتِيًّا","تَمَرُّدًا وَعِصْيَانًا."],[5,7,1,"صِلِيًّا","دُخُولًا، وَمُقَاسَاةً لِحَرِّهَا."],[6,3,1,"وَارِدُهَا","مَارًّا بِالصِّرَاطِ المَنْصُوبِ عَلَى مَتْنِ جَهَنَّمَ."],[6,7,1,"حَتْمًا","مَحْتُومًا لَازِمًا."],[7,7,1,"جِثِيًّا","بَارِكِينَ عَلَى رُكَبِهِمْ."],[8,13,1,"مَّقَامًا","مَنْزِلًا."],[8,15,1,"نَدِيًّا","مَجْلِسًا."],[9,4,1,"قَرْنٍ","أُمَّةٍ."],[9,7,1,"أَثَاثًا","مَتَاعًا."],[9,8,1,"وَرِئْيًا","مَنْظَرًا، وَمَرْأًى."],[10,5,1,"فَلْيَمْدُدْ","فَلْيُمْهِلْهُ، وَلْيُمْلِ لَهُ؛ اسْتِدْرَاجًا."],[11,5,1,"وَالْبَاقِيَاتُ","الأَعْمَالُ الصَّالِحَاتُ."],[11,12,1,"مَّرَدًّا","مَرْجِعًا، وَعَاقِبَةً."]]