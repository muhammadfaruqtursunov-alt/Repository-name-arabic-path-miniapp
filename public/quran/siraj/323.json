[[0,0,2,"وَكَمْ قَصَمْنَا","كَثِيرًا أَهْلَكْنَا."],[1,1,1,"أَحَسُّوا","رَأَوْا."],[1,2,1,"بَاسَنَا","عَذَابَنَا."],[1,6,1,"يَرْكُضُونَ","يُسِرِعُونَ هَارِبِينَ مِنَ العَذَابِ."],[2,5,1,"أُتْرِفْتُمْ","نُعِّمْتُمْ فِيهِ فَبَطِرْتُمْ وَاسْتَكْبَرْتُمْ."],[3,0,2,"يَا وَيْلَنَا","يَا هَلَاكَنَا."],[4,6,1,"حَصِيدًا","كَالزَّرْعِ المَحْصُودِ."],[4,7,1,"خَامِدِينَ","مَيِّتِينَ."],[7,1,2,"نَقْذِفُ بِالْحَقِّ","نَرْمِي بِهِ، وَنُبَيِّنُهُ فَنَرُدُّ بِهِ البَاطِلَ."],[7,5,1,"فَيَدْمَغُهُ","يَمْحَقُهُ، وَيَدْحَضُهُ."],[7,8,1,"زَاهِقٌ","ذَاهِبٌ، مُضْمَحِلٌّ."],[7,10,1,"الْوَيْلُ","العَذَابُ."],[8,11,2,"وَلَا يَسْتَحْسِرُونَ","لَا يَمَلُّونَ."],[9,3,2,"لَا يَفْتُرُونَ","لَا يَضْعُفُونَ، وَلَا يَسْأَمُونَ."],[10,5,2,"هُمْ يُنشِرُونَ","هُمْ يُحْيُونَ المَوْتَى؟ كَلَّا!"],[11,4,3,"إِلَّا اللَّهُ لَفَسَدَتَا","غَيْرُ اللهِ لَاخْتَلَّ نِظَامُهُمَا، وخَرِبَتَا؛ لِحُصُولِ التَّنَازُع."],[11,7,2,"فَسُبْحَانَ اللَّهِ","تَنَزَّهَ، وَتَقَدَّسَ."],[13,9,3,"ذِكْرُ مَن مَّعِيَ","القُرْآنُ."],[13,12,3,"وَذِكْرُ مَن قَبْلِي","الكُتُبُ السَّابِقَةُ."]]