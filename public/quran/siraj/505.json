[[0,1,2,"أَخَا عَادٍ","هُوَ: هُودٌ - عليه السلام -."],[0,6,1,"بِالْأَحْقَافِ","اسْمُ مَوْقِعِهِمْ؛ وَهُوَ فِي جَنُوبِ جَزِيرَةِ العَرَبِ."],[0,8,2,"خَلَتِ النُّذُرُ","مَضَتِ الرُّسُلُ."],[1,2,1,"لِتَافِكَنَا","لِتَصْرِفَنَا."],[3,2,1,"عَارِضًا","سَحَابًا عَرَضًا فِي أُفُقِ السَّمَاءِ."],[4,0,1,"تُدَمِّرُ","تُهْلِكُ."],[4,1,2,"كُلَّ شَيْءٍ","مَرَّتْ بِهِ مِمَّا أُرْسِلَتْ بِهَلَاكِهِ."],[5,1,1,"مَكَّنَّاهُمْ","أَقْدَرْنَاهُمْ، وَبَسَطْنَا لَهُمْ."],[5,2,4,"فِيمَا إِن مَّكَّنَّاكُمْ فِيهِ","فيِ الَّذِي لَمْ نُمَكِّنْكُمْ فِيهِ."],[5,26,1,"وَحَاقَ","نَزَلَ."],[6,6,2,"وَصَرَّفْنَا الْآيَاتِ","بَيَّنًا لَهُمْ أَنْوَاعَ الحُجَجِ، وَكَرَّرْنَاهَا لَهُمْ."],[7,0,1,"فَلَوْلَا","هَلَّا."],[7,7,1,"قُرْبَانًا","يَتَقَرَّبُونَ بِهَا إِلَى رَبِّهِمْ."],[7,13,1,"إِفْكُهُمْ","كَذِبُهُمْ."],[7,16,1,"يَفْتَرُونَ","يَكْذِبُونَ."]]