[[0,10,1,"مُسْتَقَرَّهَا","مَسْكَنَهَا فِي الدُّنْيَا، وَبَعْدَ المَوْتِ."],[0,11,1,"وَمُسْتَوْدَعَهَا","المَوْضِعَ الَّذِي تَمُوتُ فِيهِ."],[1,12,1,"لِيَبْلُوَكُمْ","لِيَخْتَبِرَكُمْ."],[2,5,2,"أُمَّةٍ مَّعْدُودَةٍ","أَجَلٍ مَعْلُومٍ."],[2,8,2,"مَا يَحْبِسُهُ","مَا يَمْنَعُهُ؟"],[2,16,1,"وَحَاقَ","أَحَاطَ بِهِمْ مِنْ كُلِّ جَانِبٍ."],[3,9,1,"لَيَؤُوسٌ","شَدِيدُ اليَاسِ وَالقُنُوطِ."],[4,4,1,"ضَرَّاءَ","ضِيقٍ وَنَكْبَةٍ."],[4,8,1,"السَّيِّئَاتُ","الضِّيقُ، وَالشَّدَائِدُ."],[4,11,1,"لَفَرِحٌ","لبَطِرٌ بِالنِّعَمِ، مَغْرُورٌ بِهَا."],[4,12,1,"فَخُورٌ","مُبَالِغٌ فِي الفَخْرِ وَالتَّعَالِي عَلَى النَّاسِ."],[6,14,1,"كَنْزٌ","مَالٌ كَثِيرٌ."]]