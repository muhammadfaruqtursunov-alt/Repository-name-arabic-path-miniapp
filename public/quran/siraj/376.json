[[5,2,1,"السَّمْعِ","اسْتِمَاعِ القُرْآنِ مِنَ السَّمَاءِ."],[5,3,1,"لَمَعْزُولُونَ","لَمَحْجُوبُونَ مَرْجُومُونَ بِالشُّهُبِ."],[8,0,2,"وَاخْفِضْ جَنَاحَكَ","أَلِنْ جَانِبَكَ وَكَلامَكَ تَوَاضُعًا."],[11,2,2,"حِينَ تَقُومُ","تُصَلِّي اللَّيْلَ وَحْدَكَ."],[15,3,1,"أَفَّاكٍ","كَذَّابٍ."],[15,4,1,"أَثِيمٍ","كَثِيرِ الآثَامِ."],[16,0,2,"يُلْقُونَ السَّمْعَ","تُلْقِي الشَّيَاطِينُ إِلَى الكُهَّانِ مَا يَسْتَرِقُونَ مِنَ المَلَأِ الأَعْلَى."],[18,5,1,"وَادٍ","فَنٍّ مِنْ فُنُونِ البَاطِلِ، وَالكَذِبِ."],[18,6,1,"يَهِيمُونَ","يَخُوضُونَ."],[20,17,1,"مُنقَلَبٍ","مَرْجِعٍ."]]