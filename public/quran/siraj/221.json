[[3,5,1,"فُصِّلَتْ","بُيِّنَتْ بِالأَمْرِ وَالنَّهْيِ."],[5,4,1,"تُوبُوا","ارْجِعُوا إِلَيْهِ نَادِمِينَ."],[7,2,2,"يَثْنُونَ صُدُورَهُمْ","يُضْمِرُونَ فِي صُدُورِهِمُ الكُفْرَ."],[7,4,2,"لِيَسْتَخْفُوا مِنْهُ","لِيَسْتَتِرُوا مِنَ اللهِ."],[7,8,2,"يَسْتَغْشُونَ ثِيَابَهُمْ","يَتَغَطَّوْنَ بِثِيَابِهِمْ."]]