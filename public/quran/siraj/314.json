[[1,6,1,"الْيَمِّ","نَهْرِ النِّيلِ."],[2,8,1,"يَكْفُلُهُ","يُرَبِّيهِ، وَيُرْضِعُهُ."],[2,13,2,"تَقَرَّ عَيْنُهَا","تَطِيبُ نَفْسُهَا."],[2,22,2,"وَفَتَنَّاكَ فُتُونًا","ابْتَلَيْنَاكَ ابْتِلَاءً."],[2,31,2,"عَلَى قَدَرٍ","عَلَى وَفْقِ الوَقْتِ المُقَدَّرِ لِإرْسَالِكَ."],[3,0,2,"وَاصْطَنَعْتُكَ لِنَفْسِي","اصْطَفَيْتُكَ لِرِسَالَتِي."],[4,4,2,"وَلَا تَنِيَا","لَا تَفْتُرَا وَلَا تَضْعُفَا."],[7,5,2,"يَفْرُطَ عَلَيْنَا","يُعَاجِلَنَا بِالعُقُوبَةِ."],[12,6,1,"خَلْقَهُ","صُورَتَهُ اللَّائِقَةَ بِخَاصَّتِهِ وَمَنْفَعَتِهِ."],[13,3,2,"الْقُرُونِ الْأُولَى","الأُمَمِ المَاضِيَةِ."]]