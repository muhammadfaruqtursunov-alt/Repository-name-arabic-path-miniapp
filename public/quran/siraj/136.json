[[1,12,1,"تُبْسَلَ","تُرْتَهَنَ، وَتُحْبَسَ."],[1,25,1,"تَعْدِلْ","تَفْتَدِ."],[1,33,1,"أُبْسِلُوا","ارْتَهَنُوا بِذُنُوبِهِمْ."],[1,39,1,"حَمِيمٍ","مَاءٍ بَالِغِ الْحَرَارَةِ."],[2,18,1,"اسْتَهْوَتْهُ","هَوَتْ بِهِ؛ فَأَضَلَّتْهُ."],[4,17,1,"الصُّورِ","الْقَرْنِ الَّذِي يَنْفُخُ فِيهِ إِسْرَافِيلُ - عليه السلام -."]]