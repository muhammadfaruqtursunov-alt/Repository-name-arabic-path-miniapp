[[1,10,1,"لِذِكْرِي","لِتَذْكُرَنِي فِيهَا."],[2,3,2,"أَكَادُ أُخْفِيهَا","أَقْرُبُ أَنْ أَسْتُرَهَا مِنْ نَفْسِي."],[3,9,1,"فَتَرْدَى","فَتَهْلِكَ."],[5,3,2,"أَتَوَكَّأُ عَلَيْهَا","أَعْتَمِدُ عَلَيْهَا فِي المَشْيِ."],[5,5,4,"وَأَهُشُّ بِهَا عَلَى غَنَمِي","أَهُزُّ بِهَا الشَّجَرَ؛ لِتَرْعَى غَنَمِي مَا يَتَسَاقَطُ مِنْ وَرَقِهِ."],[5,11,1,"مَآرِبُ","مَنَافِعُ، وَحَاجَاتٌ."],[7,4,1,"تَسْعَى","تَمْشِي بِسُرْعَةٍ وَخِفَّةٍ."],[8,5,1,"سِيرَتَهَا","حَالَتَهَا."],[9,3,1,"جَنَاحِكَ","جَنْبِكَ تَحْتَ العَضُدِ."],[9,8,1,"سُوءٍ","بَرَصٍ."],[14,0,2,"وَاحْلُلْ عُقْدَةً","أَطْلِقْ لِسَانِي بِفَصِيحِ المَنْطِقِ."],[18,0,3,"اشْدُدْ بِهِ أَزْرِي","قَوِّنِي بِهِ، وَشُدَّ بِهِ ظَهْرِي."],[19,2,1,"أَمْرِي","النُّبُوَّةِ."]]