[[1,1,1,"يَجْتَبِيكَ","يَصْطَفِيكَ."],[3,9,1,"عُصْبَةٌ","جَمَاعَةٌ ذَوُو عَدَدٍ."],[3,13,1,"ضَلَالٍ","خَطَإٍ."],[4,5,1,"يَخْلُ","يَخْلُصْ."],[5,8,2,"غَيَابَةِ الْجُبِّ","جَوْفِ البِئْرِ، والجُبُّ: هُوَ البِئْرُ الَّذِي قُطِعَ مِنَ الأَرْضِ دُونَ بِنَاءٍ يَحْمِيهِ مِنَ الِانْهِيَارِ."],[5,12,1,"السَّيَّارَةِ","المَارَّةِ مِنَ المُسَافِرِينَ."],[7,3,1,"يَرْتَعْ","يَاكُلْ مَا لَذَّ وَطَابَ."],[9,5,1,"عُصْبَةٌ","جَمَاعَةٌ قَوِيَّةٌ."]]