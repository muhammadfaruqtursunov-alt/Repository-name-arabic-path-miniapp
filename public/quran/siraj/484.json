[[0,0,1,"فَاطِرُ","خَالِقُ، وَمُبْدِعُ."],[0,8,3,"وَمِنَ الْأَنْعَامِ أَزْوَاجًا","أَنْوَاعًا؛ ذُكُورًا، وَإِنَاثًا."],[0,11,2,"يَذْرَؤُكُمْ فِيهِ","يُكَثِّرُكُمْ؛ بِسَبَبِ التَّزْوِيجِ."],[1,1,2,"مَقَالِيدُ السَّمَوَاتِ","مِلْكُهَا، وَمَفَاتِيحُ خَزَائِنِهَا."],[1,4,1,"يَبْسُطُ","يُوسِعُ."],[1,8,1,"وَيَقْدِرُ","يُضَيِّقُ."],[2,23,1,"كَبُرَ","عَظُمَ."],[2,30,2,"يَجْتَبِي إِلَيْهِ","يَصْطَفِي لِتَوْحِيدِهِ، وَدِينِهِ."],[2,37,1,"يُنِيبُ","يَرْجعُ إِلَيْهِ بِالطَّاعَةِ."],[3,8,1,"بَغْيًا","عِنَادًا، وَظُلْمًا."],[3,11,2,"كَلِمَةٌ سَبَقَتْ","بِتَاخِيرِ العَذَابِ."],[3,23,1,"الْكِتَابَ","التَّوْرَاةَ، وَالإِنْجِيلَ."],[3,29,1,"مُرِيبٍ","مُوقِعٍ فِي الرِّيبَةِ، وَالاِخْتِلَافِ المَذْمُومِ."],[4,0,2,"فَلِذَلِكَ فَادْعُ","قُمْ بِالدَّعْوَةِ إِلَى ذَلِكَ الدِّينِ."],[4,25,4,"لَا حُجَّةَ بَيْنَنَا وَبَيْنَكُمُ","لَا جِدَالَ بَيْنَنَا وَبَيْنَكُمْ؛ بَعْدَمَا تَبَيَّنَ الحَقُّ."],[4,33,1,"الْمَصِيرُ","المَرْجِعُ."]]