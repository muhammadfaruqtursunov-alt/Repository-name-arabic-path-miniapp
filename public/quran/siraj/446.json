[[0,0,1,"وَالصَّافَّاتِ","قَسَمٌ بِالمَلَائِكَةِ حِينَ تَصُفُّ فيِ عِبَادَتِهَا."],[1,0,1,"فَالزَّاجِرَاتِ","قَسَمٌ بِالمَلَائِكَةِ حِينَ تَزْجُرُ السَّحَابَ، وَتَسُوقُهُ."],[2,0,1,"فَالتَّالِيَاتِ","قَسَمٌ بِالمَلَائِكَةِ حِينَ تَتْلُو ذِكْرَ اللهِ، وَكَلَامَهُ."],[6,4,1,"مَّارِدٍ","جِنِّيًّ مُتَمَرِّدٍ، خَارجٍ عَنِ الطَّاعَةِ."],[7,5,1,"وَيُقْذَفُونَ","يُرْجَمُونَ."],[8,0,1,"دُحُورًا","طَرْدًا لِلشَّيَاطِينِ عَنِ الاِسْتِمَاعِ."],[8,3,1,"وَاصِبٌ","دَائِمٌ مُوجِعٌ."],[9,2,2,"خَطِفَ الْخَطْفَةَ","اخْتَلَسَ الكَلِمَةَ؛ مُسَارَقَةً بِسُرْعَةٍ."],[9,5,1,"شِهَابٌ","مَا يُرَى كَالكَوْكَبِ يَنْقَضُّ مِنَ السَّمَاءِ بِسُرْعَةٍ."],[9,6,1,"ثَاقِبٌ","مُضِيءٌ."],[10,8,1,"خَلَقْنَاهُم","خَلَقْنَا أَبَاهُمْ آدَمَ - عليه السلام -."],[10,11,1,"لَّازِبٍ","لَزِجٍ يَلْتَصِقُ بَعْضُهُ بِبَعْضٍ."],[17,3,1,"دَاخِرُونَ","صَاغِرُونَ، أَذِلَّاءُ."],[18,2,1,"زَجْرَةٌ","نَفْخَةٌ."],[21,0,1,"احْشُرُوا","اجْمَعُوا."],[21,3,1,"وَأَزْوَاجَهُمْ","نُظَرَاءَهُمْ، وَقُرَنَاءَهُمْ فيِ الدُّنْيَا."],[22,3,1,"فَاهْدُوهُمْ","سُوقُوهُمْ سَوْقًا عَنِيفًا."],[23,0,1,"وَقِفُوهُمْ","احْبِسُوهُمْ قَبْلَ أَنْ يَصِلُوا إِلَى جَهَنَّمَ."]]