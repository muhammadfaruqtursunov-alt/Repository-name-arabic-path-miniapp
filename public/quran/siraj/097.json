[[0,5,1,"نَّجْوَاهُمْ","حَدِيثَهُمْ سِرًّا."],[1,1,1,"يُشَاقِقِ","يُخَالِفْ عِنَادًا."],[1,13,3,"نُوَلِّهِ مَا تَوَلَّى","نَتْرُكْهُ، وَمَا تَوَجَّهَ إِلَيْهِ."],[3,5,1,"إِنَاثًا","أَصْنَامًا؛ كَاللَّاتِ وَالعُزَّى وَمَنَاةَ."],[3,10,1,"مَّرِيدًا","مُتَمَرِّدًا عَاتِيًا."],[4,6,2,"نَصِيبًا مَّفْرُوضًا","جُزْءًا مَعْلُومًا."],[5,3,1,"فَلَيُبَتِّكُنَّ","فَلَيُقَطِّعُنَّ وَلَيُشَقِّقُنَّ."],[7,6,1,"مَحِيصًا","مَحِيدًا، وَمَهْرَبًا."]]