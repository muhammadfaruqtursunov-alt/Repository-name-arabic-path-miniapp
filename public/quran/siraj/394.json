[[0,1,1,"أَرَأَيْتُمْ","أَخْبِرُونِي."],[0,7,1,"سَرْمَدًا","دَائِمًا بَاقِيًا."],[4,4,1,"شَهِيدًا","رَسُولًا شَاهِدًا يَشْهَدُ عَلَى قَوْمِهِ بِشِرْكِهِمْ."],[4,12,1,"وَضَلَّ","ذَهَبَ."],[4,16,1,"يَفْتَرُونَ","يَخْتَلِقُونَهُ مِنَ الكَذِبِ."],[5,6,2,"فَبَغَى عَلَيْهِمْ","تَجَاوَزَ حَدَّهُ فِي الكِبْرِ وَالتَّجَبُّرِ عَلَيْهِمْ."],[5,10,1,"الْكُنُوزِ","خَزَائِنِ الأَمْوَالِ."],[5,13,1,"مَفَاتِحَهُ","مَفَاتِيحَ خَزَائِنِ مَالِهِ وَصَنَادِيقِهُ المُقْفَلَةِ."],[5,14,2,"لَتَنُوءُ بِالْعُصْبَةِ","لَيَثْقُلُ حَمْلُهَا عَلَى الجَمَاعَةِ الكَثِيرَةِ."],[5,22,2,"لَا تَفْرَحْ","لَا تَبْطَرْ."],[6,0,1,"وَابْتَغِ","الْتَمِسْ وَاطْلُبْ."],[6,6,3,"وَلَا تَنسَ نَصِيبَكَ","لَا تَتْرُكْ حَظَّكَ."]]