[[1,5,1,"فَعَزَّزْنَا","أَيَّدْنَا، وَقَوَّيْنَا."],[5,2,2,"تَطَيَّرْنَا بِكُمْ","تَشَاءَمْنَا بِكُمْ."],[6,1,2,"طَائِرُكُمْ مَعَكُمْ","شُؤْمُكُمْ، وَأَعْمَالُكُمْ مِنَ الشِّرْكِ وَالشَّرِّ مَعَكُمْ، وَمَرْدُودَةٌ عَلَيْكُمْ."],[6,3,2,"أَئِن ذُكِّرْتُم","أَإِنْ وُعِظْتُمْ تَشَاءَمْتُمْ؟!"],[7,5,1,"يَسْعَى","يُسْرِعُ فِي مَشْيِهِ."],[9,5,1,"فَطَرَنِي","خَلَقَنِي."]]