[[0,2,1,"ثَقِفْتُمُوهُمْ","وَجَدتُّمُوهُم."],[0,7,1,"وَالْفِتْنَةُ","أَذًى لِلْمُسلِمِينَ، أَوْ شِرْكٌ بِاللهِ."],[4,4,3,"وَلَا تُلْقُوا بِأَيْدِيكُمْ","لَا تُوقِعُوا أَنْفُسَكُمْ."],[4,8,1,"التَّهْلُكَةِ","الهَلَاكِ بِتَرْكِ الجِهَادِ، وَالإِنْفَاقِ فِيهِ."],[5,5,1,"أُحْصِرْتُمْ","مُنِعْتُمْ لِمَرَضٍ، أَوْ عَدُوٍّ."],[5,9,1,"الْهَدْيِ","مَا يُهْدَى إِلَى البَيْتِ مِنَ الأَنْعَامِ."],[5,32,1,"نُسُكٍ","ذَبِيحَةٍ: شَاةٍ تُذْبَحُ لِفُقَرَاءِ الحَرَمِ."],[5,63,1,"حَاضِرِي","سَاكِنِي."]]