[[3,4,2,"عَنِ الْيَمِينِ","مِنْ قِبَلِ الحَقِّ وَالدِّينِ."],[5,5,1,"سُلْطَانٍ","حُجَّةٍ، أَوْ قُوَّةٍ."],[5,9,1,"طَاغِينَ","مُجَاوِزِينَ الحَدَّ فيِ العِصْيَانِ."],[6,0,2,"فَحَقَّ عَلَيْنَا","وَجَبَ عَلَيْنَا."],[15,3,1,"الْمُخْلَصِينَ","الَّذِينَ أَخْلَصُوا فِي عِبَادَةِ اللهِ؛ فَأَخْلَصَهُمْ، وَاخْتَصَّهُمْ بِرَحْمَتِهِ."],[20,2,1,"بِكَاسٍ","بِخَمْرٍ."],[20,3,2,"مِن مَّعِينٍ","مِنْ أَنْهَارٍ جَارِيَةٍ لَا يَخَافُونَ انْقِطَاعَهَا."],[22,0,3,"لَا فِيهَا غَوْلٌ","لَيْسَ فِيهَا مَا يَغْتَالُ عُقُولَهُمْ."],[22,3,4,"وَلَا هُمْ عَنْهَا يُنزَفُونَ","لَا يَسْكَرُونَ، وَلَا تَضُرُّ أَبْدَانَهُمْ."],[23,1,2,"قَاصِرَاتُ الطَّرْفِ","عَفِيفاتٌ لَا يَنْظُرْنَ إِلَى غَيْرِ أَزْوَاجِهِنَّ."],[23,3,1,"عِينٌ","حِسَانُ الأَعْيُنِ."],[24,2,1,"مَّكْنُونٌ","لَمْ تَمَسَّهُ الأَيْدِي."],[26,6,1,"قَرِينٌ","صَاحِبٌ مُلَازِمٌ لِي."]]