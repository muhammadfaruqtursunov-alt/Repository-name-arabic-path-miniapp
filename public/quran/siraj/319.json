[[0,10,2,"مِن لَّدُنَّا","مِنْ عِنْدِنَا."],[1,7,1,"وِزْرًا","إِثْمًا عَظِيمًا."],[3,3,1,"الصُّورِ","القَرْنِ الَّذِي يَنْفُخُ فِيهِ إِسْرَافِيلُ - عليه السلام -."],[3,4,1,"وَنَحْشُرُ","نَسُوقُ."],[3,7,1,"زُرْقًا","زُرْقَ العُيُونِ مَعَ سَوَادِ وُجُوهِهِمْ."],[4,0,1,"يَتَخَافَتُونَ","يَتَسَارُّونَ، وَيَتَهَامَسُونَ."],[5,6,2,"أَمْثَلُهُمْ طَرِيقَةً","أَعْلَمُهُمْ، وَأَوْفَاهُمْ عَقْلًا."],[6,4,1,"يَنسِفُهَا","يُزِيلُهَا عَنْ أَمَاكِنِهَا."],[6,6,1,"نَسْفًا","يَجْعَلُهَا هَبَاءً مُنْبَثًّا."],[7,0,1,"فَيَذَرُهَا","فَيَتْرُكُهَا."],[7,1,1,"قَاعًا","أَرْضًا مَلْسَاءَ لَا نَبَاتَ بِهَا."],[7,2,1,"صَفْصَفًا","مُسْتَوِيَةً."],[8,3,1,"عِوَجًا","انْخِفَاضًا."],[8,5,1,"أَمْتًا","ارْتِفَاعًا."],[9,3,3,"لَا عِوَجَ لَهُ","لَا مَحِيدَ عَنْ دَعْوَةِ الدَّاعِي."],[9,6,1,"وَخَشَعَتْ","سَكَنَتْ خُضُوعًا."],[12,0,1,"وَعَنَتِ","خَضَعَتْ، وَذَلَّتْ."],[12,3,1,"الْقَيُّومِ","القَائِمِ عَلَى شُؤُونِ خَلْقِهِ."],[12,8,1,"ظُلْمًا","زِيَادَةً فِي سَيِّئَاتِهِ."],[13,10,1,"هَضْمًا","نَقْصًا مِنْ حَسَنَاتِهِ."],[14,4,1,"وَصَرَّفْنَا","فَصَّلْنَا فِيهِ أَنْوَاعًا مِنَ الوَعِيدِ."],[14,13,1,"ذِكْرًا","تَذْكِرَةً، وَعِظَةً."]]