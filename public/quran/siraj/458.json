[[2,5,1,"أَجْرٍ","جَزَاءٍ وَأُجْرَةٍ عَلَى الهِدَايَةِ وَالدَّعْوَةِ."],[2,9,1,"الْمُتَكَلِّفِينَ","المُتَصَنِّعِينَ المُتَقَوِّلِينَ عَلَى اللهِ."],[4,1,1,"نَبَأَهُ","خَبَرَ القُرْآنِ وَصِدْقَهُ."],[6,7,3,"مُخْلِصًا لَّهُ الدِّينَ","مُوَحِّدًا لَهُ العِبَادَةَ وَالطَّاعَةَ."],[7,2,2,"الدِّينُ الْخَالِصُ","الطَّاعَةُ التَّامَّةُ السَّالِمَةُ مِنَ الشِّرْكِ."],[7,15,1,"زُلْفَى","تَقَرُّبًا."],[8,6,1,"لَّاصْطَفَى","لَاخْتَارَ."],[9,4,1,"يُكَوِّرُ","يُدْخِلُ."],[9,12,1,"وَسَخَّرَ","ذَلَّلَ."],[9,21,1,"الْعَزِيزُ","الغَالِبُ عَلَى أَمْرِهِ، المُنْتَقِمُ مِنْ أَعْدَائِهِ."]]