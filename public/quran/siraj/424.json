[[5,11,1,"تَمَسُّوهُنَّ","تَدْخُلُوا بِهِنَّ، وَتُجَامِعُوهُنَّ."],[5,16,1,"عِدَّةٍ","مُدَّةٍ تَنْتَظِرُ فِيهَا المَرْأَةُ."],[5,17,1,"تَعْتَدُّونَهَا","تُحْصُونَهَا عَلَيْهِنَّ."],[5,18,1,"فَمَتِّعُوهُنَّ","أَعْطُوهُنَّ مِنْ أَمْوَالِكُمْ مَا يَتَمَتَّعْنَ بِهِ بِحَسَبِ وُسْعِكُمْ؛ جَبْرًا لِخَوَاطِرِهِنَّ."],[5,19,1,"وَسَرِّحُوهُنَّ","طَلِّقُوهُنَّ."],[5,21,1,"جَمِيلًا","بِلَا أَذًى، أَوْ ضَرَرٍ."],[6,9,3,"وَمَا مَلَكَتْ يَمِينُكَ","الإِمَاءِ الَّتِي تَكُونُ مِلْكًا خَالِصًا لَكَ."],[6,13,3,"أَفَاءَ اللَّهُ عَلَيْكَ","أَنْعَمَ بِهِ عَلَيْكَ بِالجِهَادِ."],[6,38,2,"خَالِصَةً لَّكَ","خَاصَّةً بِكَ."],[6,56,1,"حَرَجٌ","ضِيقٌ."]]