[[1,11,1,"تَفْتَرُونَ","تَخْتَلِقُونَ مِنَ الكَذِبِ."],[3,8,1,"كَظِيمٌ","مُمْتَلِئٌ غَمًّا وَحُزْنًا."],[4,0,1,"يَتَوَارَى","يَسْتَخْفِي."],[4,8,1,"أَيُمْسِكُهُ","أَيُبْقِيهِ؟"],[4,10,1,"هُونٍ","ذُلٍّ، وَهَوَانٍ."],[4,12,1,"يَدُسُّهُ","يَدْفِنُهُ."],[5,4,2,"مَثَلُ السَّوْءِ","الصِّفَةُ القَبِيحَةُ."],[5,7,2,"الْمَثَلُ الأَعْلَىَ","الصِّفَاتُ العُلْيَا."],[7,4,1,"وَتَصِفُ","تَقُولُ."],[7,9,1,"الْحُسْنَى","حُسْنُ العَاقِبَةِ."],[7,10,2,"لَا جَرَمَ","حَقًّا."],[7,16,1,"مُّفْرَطُونَ","مَتْرُوكُونَ فِي النَّارِ، مَنْسِيُّونَ."]]