[[0,4,2,"نَاكِسُو رُؤُوسِهِمْ","قَدْ خَفَضُوهَا، وَأَطْرَقُوا خِزْيًا وَنَدَمًا."],[1,7,2,"حَقَّ الْقَوْلُ","ثَبَتَ وَتَحَقَّقَ وَوَجَبَ."],[1,13,1,"الْجِنَّةِ","الجِنِّ."],[4,0,1,"تَتَجَافَى","تَرْتَفِعُ، وَتَتَنحَّى لِلْعِبَادَةِ."],[4,3,1,"الْمَضَاجِعِ","فُرُشِ النَّوْمِ."],[5,3,3,"مَّا أُخْفِيَ لَهُم","مَا ادُّخِرَ لَهُمْ مِنَ الجَزَاءِ."],[5,6,3,"مِّن قُرَّةِ أَعْيُنٍ","مَا يُفْرِحُ، وَيَسُرُّ."],[7,7,1,"الْمَاوَى","الَّتِي يَاوُونَ إِلَيْهَا، وَيُقِيمُونَ بِهَا."],[7,8,1,"نُزُلًا","ضِيَافَةً لَهُمْ."]]