[[0,1,2,"بَلَغَ أَشُدَّهُ","قَوِيَ بَدَنُهُ."],[0,3,1,"وَاسْتَوَى","تَكَامَلَ عَقْلُهُ."],[1,12,2,"مِن شِيعَتِهِ","مِنْ قَوْمِ مُوسَى - عليه السلام -، وَهُمْ بَنُو إِسْرَائِيلَ."],[1,25,1,"فَوَكَزَهُ","ضَرَبَهُ بِجُمْعِ كَفِّهِ."],[3,7,1,"ظَهِيرًا","نَصِيرًا."],[4,4,1,"يَتَرَقَّبُ","يَتَوَقَّعُ المَكْرُوهَ."],[4,9,1,"يَسْتَصْرِخُهُ","يَطْلُبُ مِنْهُ النَّصْرَ."],[4,14,1,"لَغَوِيٌّ","كَثِيرُ الغَوَايَةِ، ضَالٌّ عَنِ الرُّشْدِ."]]