[[0,10,1,"سِجِّيلٍ","طِينٍ مُتَصَلِّبٍ مَتِينٍ."],[0,11,1,"مَّنضُودٍ","صُفَّ بَعْضُهَا إِلَى بَعْضٍ مُتَتَابِعَةً."],[1,0,1,"مُّسَوَّمَةً","مُعَلَّمَةً عِنْدَ اللهِ بِعَلَامَةٍ مَعْرُوفُةٍ لَا تُشْبِهُ حِجَارَةَ الأَرْضِ."],[3,4,1,"بِالْقِسْطِ","بِالعَدْلِ."],[3,5,2,"وَلَا تَبْخَسُوا","لَا تَنْقُصُوا."],[3,9,2,"وَلَا تَعْثَوْا","لَا تَسْعَوْا، وَلَا تَسِيرُوا."],[4,0,2,"بَقِيَّةُ اللهِ","مَا يُبْقِي اللهُ لَكُمْ بَعْدَ إِيفَاءِ الكَيْلِ وَالمِيزَانِ مِنَ الرِّبْحِ الحَلَالِ."],[4,10,1,"بِحَفِيظٍ","رَقِيبٍ أُحْصِي أَعْمَالَكُمْ."],[6,34,1,"أُنِيبُ","أَرْجِعُ بِالتَّوْبَةِ، وَالطَّاعَةِ."]]