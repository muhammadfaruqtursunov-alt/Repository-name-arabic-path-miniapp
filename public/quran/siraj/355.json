[[0,14,4,"يَوْمًا تَتَقَلَّبُ فِيهِ الْقُلُوبُ","أَيْ: بَيْنَ الرَّجَاءِ، وَالخَوْفِ."],[1,12,2,"بِغَيْرِ حِسَابٍ","بِلَا عَدٍّ، وَيُعْطَى مِنَ الأَجْرِ مَا لَا يَبْلُغُهُ عَمَلُ العَامِلِ."],[2,3,1,"كَسَرَابٍ","هُوَ مَا يُشَاهَدُ كَالمَاءِ عَلَى الأَرْضِ المُسْتَوِيَةِ فِي الظَّهِيرَةِ."],[2,4,1,"بِقِيعَةٍ","الأَرْضُ المُنْخَفِضَةُ المُسْتَوِيَةُ."],[3,4,1,"لُّجِّيٍّ","عَمِيقٍ."],[3,5,1,"يَغْشَاهُ","يَعْلُوهُ."],[4,11,1,"صَافَّاتٍ","بَاسِطَاتٍ أَجْنِحَتَهُنَّ فِي الهَوَاءِ."],[6,4,1,"يُزْجِي","يَسُوقُ."],[6,7,1,"يُؤَلِّفُ","يَجْمَعُ."],[6,11,1,"رُكَامًا","مُتَرَاكِمًا."],[6,13,1,"الْوَدْقَ","المَطَرَ."],[6,15,2,"مِنْ خِلَالِهِ","مِنْ بَيْنِهِ."],[6,34,2,"سَنَا بَرْقِهِ","ضَوْءُ البَرْقِ."]]