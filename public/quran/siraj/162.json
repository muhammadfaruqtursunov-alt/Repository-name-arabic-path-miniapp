[[1,34,1,"افْتَحْ","احْكُمْ."],[1,41,1,"الْفَاتِحِينَ","الحَاكِمِينَ."],[3,1,1,"الرَّجْفَةُ","الزَّلْزَلَةُ الشَّدِيدَةُ."],[3,5,1,"جَاثِمِينَ","هَالِكَينِ، لَاصِقَينِ بِالأَرْضِ عَلَى رُكَبِهِمْ، وَوُجُوهِهِمْ."],[4,4,2,"لَّمْ يَغْنَوْا","لَمْ يُقِيمُوا فِي دِيَارِهِمْ."],[5,11,1,"آسَى","أَحْزَنُ."],[6,9,1,"بِالْبَاسَاءِ","الْفَقْرِ وَالْبُؤْسِ."],[6,10,1,"وَالضَّرَّاء","الْمَرَضِ وَالأَلَمِ."],[6,12,1,"يَضَّرَّعُونَ","يَسْتَكِينُونَ، وَيَتَذَلَّلُونَ."],[7,3,1,"السَّيِّئَةِ","الْحَالَةِ السَّيِّئَةِ؛ مِنَ الْمَرَضِ، وَالْفَقْرِ."],[7,4,1,"الْحَسَنَةَ","الْحَالَةَ الْحَسَنَةَ؛ مِنَ الْعَافِيَةِ، وَالْغِنَى."],[7,6,1,"عَفَوْا","كَثُرُوا وَنَمَوْا عَدَدًا وَمَالًا."],[7,14,1,"بَغْتَةً","فَجْأَةً."]]