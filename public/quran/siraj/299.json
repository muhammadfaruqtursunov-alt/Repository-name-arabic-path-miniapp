[[0,5,2,"وَالْبَاقِيَاتُ الصَّالِحَاتُ","الأَعْمَالُ الصَّالِحَةُ."],[0,11,2,"وَخَيْرٌ أَمَلًا","خَيْرُ مَا يُرْجَى عِنْدَ اللهِ."],[1,5,1,"بَارِزَةً","ظَاهِرَةً لَيْسَ عَلَيْهَا مَا كَان يَسْتُرُهَا مِنَ المَخْلُوقَاتِ."],[1,6,1,"وَحَشَرْنَاهُمْ","جَمَعْنَاهُمْ."],[1,7,2,"فَلَمْ نُغَادِرْ","لَمْ نَتْرُكْ."],[2,3,1,"صَفًّا","مُصْطَفِّينَ."],[3,0,2,"وَوُضِعَ الْكِتَابُ","كِتَابُ أَعْمَالِ كُلِّ وَاحِدٍ فِي يَمِينِهِ، أَوْ شِمَالِهِ."],[3,12,2,"لَا يُغَادِرُ","لَا يَتْرُكُ."],[3,22,1,"حَاضِرًا","مُثْبَتًا."],[4,11,1,"فَفَسَقَ","فَخَرَجَ."],[4,17,1,"أَوْلِيَاءَ","أَعْوَانًا تُطِيعُونَهُمْ."],[5,12,1,"عَضُدًا","أَعْوَانًا."],[6,12,1,"مَّوْبِقًا","مَهلِكًا فِي جَهَنَّمَ يَهْلِكُونَ فِيهِ جَمِيعًا."],[7,3,1,"فَظَنُّوا","أَيْقَنُوا."],[7,5,1,"مُّوَاقِعُوهَا","وَاقِعُونَ فِيهَا."],[7,9,1,"مَصْرِفًا","مَكَانًا يَنْصَرِفُونَ إِلَى غَيْرِهِ."]]