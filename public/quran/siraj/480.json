[[0,6,1,"اسْتَقَامُوا","ثَبَتُوا عَلَى الحَقِّ عِلْمًا، وَعَمَلًا."],[0,7,2,"تَتَنَزَّلُ عَلَيْهِمُ","تَنْزِلُ عِنْدَ المَوْتِ."],[1,1,1,"أَوْلِيَاؤُكُمْ","أَنْصَارُكُمْ."],[1,15,1,"تَدَّعُونَ","تَطْلُبُونَ."],[2,0,1,"نُزُلًا","ضِيَافَةً، وَإِنْعَامًا."],[3,0,2,"وَمَنْ أَحْسَنُ","لَا أَحَدَ أَفْضَلُ."],[4,15,2,"وَلِيٌّ حَمِيمٌ","قَرِيبٌ لَكَ، شَفِيقٌ عَلَيْكَ."],[5,0,2,"وَمَا يُلَقَّاهَا","مَا يُوَفَّقُ لَهَا."],[5,8,3,"ذُو حَظٍّ عَظِيمٍ","صَاحِبُ نَصِيبٍ وَافِرٍ؛ مِنَ السَّعَادَةِ، وَالخُلُقِ، وَالخَيْرِ."],[6,1,1,"يَنزَغَنَّكَ","يُلْقِيَنَّ فيِ نَفْسِكَ وَسْوَسَةً، وَيَصْرِفَنَّكَ عَنِ الخَيْرِ."],[6,5,2,"فَاسْتَعِذْ بِاللَّهِ","اسْتَجِرْ، وَاعْتَصِمْ بِاللِه قَائِلًا: أَعُوذُ بِاللهِ مِنَ الشَّيْطَانِ الرَّجِيمِ."],[8,10,2,"لَا يَسْأَمُونَ","لَا يَفْتُرُونَ، وَلَا يَمَلُّونَ."]]