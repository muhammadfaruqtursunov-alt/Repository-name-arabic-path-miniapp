[[0,8,3,"لَن نُّؤْمِنَ لَكُمْ","لَنْ نُصَدِّقَكُمْ."],[1,4,1,"انقَلَبْتُمْ","رَجَعْتُمْ."],[1,11,1,"رِجْسٌ","خُبَثَاءُ البَوَاطِنِ."],[3,0,1,"الأَعْرَابُ","سُكَّانُ البَادِيَةِ."],[3,4,1,"وَأَجْدَرُ","أَحَقُّ، وَأَحْرَى."],[4,6,1,"مَغْرَمًا","غَرَامَةً، وَخَسَارَةً."],[4,7,1,"وَيَتَرَبَّصُ","يَنْتَظِرُ."],[4,9,1,"الدَّوَائِرَ","الحَوَادِثَ وَالآفَاتِ."],[4,10,3,"عَلَيْهِمْ دَائِرَةُ السَّوْءِ","دُعَاءٌ بِالشَّرِّ وَالعَذَابِ يَدُورُ عَلَيْهِمْ."]]