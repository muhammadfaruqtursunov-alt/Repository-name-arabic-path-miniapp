[[0,3,2,"أَجَلٌ مُّسَمًّى","وَقْتُ عَذَابِهِمُ المُقَدَّرُ عِنْدَ اللهِ."],[0,8,1,"بَغْتَةً","فَجْأَةً."],[2,1,1,"يَغْشَاهُمُ","يُحِيطُ بِهِمْ وَيَعْلُوهُمْ."],[5,4,1,"لَنُبَوِّئَنَّهُم","لِنُنْزِلَنَّهُمْ."],[5,7,1,"غُرَفًا","مَنَازِلَ عَالِيَةً."],[7,0,2,"وَكَأَيِّن مِّن","وَكَمْ مِنْ؟"],[7,3,3,"لَا تَحْمِلُ رِزْقَهَا","لَا تَدَّخِرُهُ لِغَدٍ."],[8,11,2,"فَأَنَّى يُؤْفَكُونَ","فَكَيْفَ يُصْرَفُونَ عَنِ الإِيمَانِ؟"],[9,1,1,"يَبْسُطُ","يُوَسِّعُ."],[9,7,1,"وَيَقْدِرُ","يُضَيِّقُ."]]