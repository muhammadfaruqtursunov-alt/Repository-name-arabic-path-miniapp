[[0,16,1,"مَلُومًا","يَلُومُكَ النَّاسُ وَنَفْسُكَ."],[0,17,1,"مَّدْحُورًا","مطَرْوُدًا مُبْعَدًا مِنْ رَحْمَةِ اللهِ."],[1,0,1,"أَفَأَصْفَاكُمْ","أَفَخَصَّكُمْ؟"],[2,1,1,"صَرَّفْنَا","نَوَّعْنَا الأَسَالِيبَ، وَوَضَّحْنَاهَا."],[2,9,1,"نُفُورًا","بُعْدًا عَنِ الحَقِّ."],[3,8,1,"لَّابْتَغَوْا","لَطَلَبُوا."],[3,10,2,"ذِي الْعَرْشِ","صَاحِبِ العَرْشِ، وَهُوَ اللهُ تَعَالَى."],[3,12,1,"سَبِيلًا","طَريقًا لِمُغَالَبَتِهِ، أَوْ لَابْتَغَوْا طَرِيقًا إلَى اللهِ؛ بِالعِبَادَةِ."],[5,11,2,"يُسَبِّحُ بِحَمْدَهِ","يُنَزِّهُهُ تَنْزِيهًا مَقْرُونًا بِالثَّنَاءِ، وَالحَمْدِ لِلهِ."],[6,11,1,"مَّسْتُورًا","سَاتِرًا."],[7,3,1,"أَكِنَّةً","أَغْطِيَةً."],[7,8,1,"وَقْرًا","صَمَمًا وَثِقَلًا فِي السَّمْعِ."],[7,18,1,"نُفُورًا","نَافِرِينَ."],[8,9,2,"هُمْ نَجْوَى","يَتَنَاجَوْنَ، وَيَتَحَدَّثُونَ فِيمَا بَيْنَهُمْ."],[10,4,1,"وَرُفَاتًا","أَجْزَاءً مُفَتَّتَةً."]]