[[0,5,1,"نَفَرٌ","جَمَاعَةٌ."],[0,12,1,"عَجَبًا","يُتَعَجَّبُ مِنْهُ فِي فَصَاحَتِهِ، وَبَلَاغَتِهِ، وَمَعَانِيهِ."],[1,2,1,"الرُّشْدِ","الحَقِّ، وَالهُدَى."],[2,2,2,"جَدُّ رَبِّنَا","عَظَمَةُ رَبِّنَا، وَجَلَالُهُ، وَغِنَاهُ."],[2,6,1,"صَاحِبَةً","زَوْجَةً."],[3,3,1,"سَفِيهُنَا","إِبْلِيسُ."],[2,6,1,"صَاحِبَةً","زَوْجَةً."],[3,3,1,"سَفِيهُنَا","إِبْلِيسُ"],[3,6,1,"شَطَطًا","قَوْلًا بَعِيدًا عَنِ الحَقِّ مِنْ دَعْوَى الصَّاحِبَةِ وَالوَلَدِ."],[5,5,1,"يَعُوذُونَ","يَسْتَجِيرُونَ، وَيَسْتَعِيذُونَ."],[5,10,1,"رَهَقًا","طُغْيانًا، وَسَفَهًا."],[6,0,2,"وَأَنَّهُمْ ظَنُّوا","وَأَنَّ كُفَّارَ الإِنْسِ حَسِبُوا."],[7,1,2,"لَمَسْنَا السَّمَاءَ","طَلَبْنَا بُلُوغَ السَّمَاءِ؛ لِاسْتِرَاقِ السَّمْعِ."],[7,7,1,"وَشُهُبًا","نُجُومًا مُحْرِقَةً؛ وَذَلِكَ لَمَّا بُعِثَ النَّبِيُّ - صلى الله عليه وسلم -."],[8,4,2,"مَقَاعِدَ لِلسَّمْعِ","مَوَاضِعَ؛ لِنَسْتَمِعَ إِلَى أَخْبَارِهَا."],[8,12,1,"رَّصَدًا","أُرْصِدَ لَهُ؛ لِيُرْمَى بِهِ."],[9,12,1,"رَشَدًا","خَيْرًا، وَصَلَاحًا، وَرَحْمَةً."],[10,7,2,"طَرَائِقَ قِدَدًا","فِرَقًا وَمَذَاهِبَ مُخْتَلِفَةً."],[11,1,1,"ظَنَنَّا","أَيْقَنَّا."],[11,3,3,"لَّن نُّعجِزَ اللَّهَ","لَنْ نَفُوتَهُ، وَنُفْلِتَ مِنْ قَبْضَتِهِ."],[12,11,1,"بَخْسًا","نُقْصَانًا مِنْ حَسَنَاتِهِ."],[12,12,2,"وَلَا رَهَقًا","وَلَا ظُلْمًا يَلْحَقُهُ بِزِيَادَةٍ فِي سَيِّئَاتِهِ."]]