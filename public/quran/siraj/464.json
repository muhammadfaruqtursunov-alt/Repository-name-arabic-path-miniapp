[[0,5,1,"وَحَاقَ","أَحَاطَ بِهِمْ مِنْ كُلِّ جَانِبٍ."],[1,7,1,"خَوَّلْنَاهُ","أَعْطَيْنَاهُ، وَمَنَحْنَاهُ."],[1,17,1,"فِتْنَةٌ","ابْتِلَاءٌ وَاخْتِبَارٌ."],[3,14,1,"بِمُعْجِزِينَ","بِفَائِتِينَ اللهَ، وَلَا سَابِقِيهِ."],[4,4,1,"يَبْسُطُ","يُوسِعُ."],[4,8,1,"وَيَقْدِرُ","يُضَيِّقُ."],[5,3,1,"أَسْرَفُوا","تَجَاوَزُوا الحَدَّ فِي المَعَاصِي."],[5,6,2,"لَا تَقْنَطُوا","لَا تَيْئَسُوا."],[6,0,1,"وَأَنِيبُوا","ارْجِعُوا إِلَى اللهِ بِالتَّوْبَةِ، وَالطَّاعَةِ."],[6,3,1,"وَأَسْلِمُوا","اخْضَعُوا، وَانْقَادُوا."],[7,12,1,"بَغْتَةً","فَجْأَةً."],[8,2,2,"يَا حَسْرَتَى","يَا نَدَامَتِي."],[8,6,1,"فَرَّطتُ","ضَيَّعْتُ."],[8,8,2,"جَنبِ اللَّهِ","طَاعَتِهِ، وَحَقِّهِ."],[8,13,1,"السَّاخِرِينَ","المُسْتَهْزِئِينَ."]]