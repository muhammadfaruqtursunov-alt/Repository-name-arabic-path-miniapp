[[0,7,1,"بِمَسْبُوقِينَ","لَا أَحَدَ يَفُوتُنَا وَيُعْجِزُنَا إِذَا أَرَدْنَاهُ."],[2,3,1,"الْأَجْدَاثِ","القُبُورِ."],[2,7,1,"نُصُبٍ","أَحْجَارٍ تُعْبَدُ مِنْ دُونِ اللهِ."],[2,8,1,"يُوفِضُونَ","يُهَرْوِلُونَ، وَيُسْرِعُونَ."],[3,0,1,"خَاشِعَةً","ذَلِيلَةً، مُنْكَسِرَةً."],[3,2,1,"تَرْهَقُهُمْ","تَغْشَاهُمْ."],[7,6,2,"أَجَلٍ مُّسَمًّى","وَقْتٍ مُقَدَّرٍ فيِ عِلْمِ اللهِ تَعَالَى."],[7,9,2,"أَجَلَ اللَّهِ","وَقْتَ مَجِيءِ عَذَابِهِ."],[10,9,2,"وَاسْتَغْشَوْا ثِيَابَهُمْ","تَغَطَّوْا بِهَا؛ مُبَالَغَةً فِي كَرَاهِيَتِي."],[10,11,1,"وَأَصَرُّوا","أَقَامُوا عَلَى كُفْرِهِمْ."],[12,2,1,"أَعْلَنتُ","رَفَعْتُ صَوْتِي دَاعِيًا."]]