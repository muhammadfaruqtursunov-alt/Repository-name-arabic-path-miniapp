[[0,6,1,"الصِّدِّيقُونَ","المُبَالِغُونَ فِي التَّصْدِيقِ."],[0,7,1,"وَالشُّهَدَاءُ","الَّذِينَ قُتِلُوا فِي سَبِيلِ اللهِ."],[1,4,1,"لَعِبٌ","تَلْعَبُ بِهَا الأَبْدَانُ."],[1,5,1,"وَلَهْوٌ","تَلْهُو بِهَا القُلُوبُ."],[1,16,1,"الْكُفَّارَ","الزُّرَّاعَ، سُمُّوا بِذَلِكَ؛ لِأَنَّهُمْ يَسْتُرُونَ الحَبَّ فيِ التُّرَابِ."],[1,19,1,"يَهِيجُ","يَيْبَسُ."],[1,24,1,"حُطَامًا","فُتَاتًا مُتَهَشِّمًا."],[2,0,1,"سَابِقُوا","سَارِعُوا مُسَارَعَةَ المُتَسَابِقِينَ فيِ المِضْمَارِ."],[3,11,1,"كِتَابٍ","هُوَ: اللَّوْحُ المَحْفُوظُ."],[3,15,1,"نَّبْرَأَهَا","نَخْلُقَ هَذِهِ المَخْلُوقَاتِ."],[4,1,1,"تَاسَوْا","تَحْزَنُوا."],[4,6,1,"تَفْرَحُوا","فَرَحَ بَطَرٍ، وَاخْتِيَالٍ."],[4,13,1,"مُخْتَالٍ","مُتَكَبِّرٍ."],[4,14,1,"فَخُورٍ","مُتَطَاوِلٍ بِهِ يَفْخَرُ عَلَى النَّاسِ."],[5,11,1,"الْحَمِيدُ","المَحْمُودُ عَلَى كَمَالِ صِفَاتِهِ، وَجَمِيلِ فِعَالِهِ."]]