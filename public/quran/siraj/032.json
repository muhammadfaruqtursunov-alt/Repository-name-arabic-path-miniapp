[[0,4,1,"مَّعْدُودَاتٍ","أَيَّامِ التَّشْرِيقِ: الحَادِيَ عَشَرَ، وَالثَّانِيَ عَشَرَ، وَالثَّالِثَ عَشَرَ؛ مِنْ ذِي الحِجَّةِ."],[1,15,2,"أَلَدُّ الْخِصَامِ","شَدِيدُ العَدَاوَةِ وَالخُصُومَةِ."],[2,8,1,"الْحَرْثَ","الزَّرْعَ."],[3,8,1,"فَحَسْبُهُ","كَافِيهِ."],[3,11,1,"الْمِهَادُ","الفِرَاشُ، وَالمَضْجَعُ."],[4,3,1,"يَشْرِي","يَبِيعُ."],[5,5,1,"السِّلْمِ","شَرَائِع الإِسْلَامِ."],[6,1,1,"زَلَلْتُمْ","انْحَرَفْتُمْ."],[7,1,1,"يَنظُرُونَ","يَنْتَظِرُونَ."],[7,7,3,"ظُلَلٍ مِّنَ الْغَمَامِ","قِطَعٍ مِنَ السَّحَابِ."]]