[[0,10,1,"مُّفْتَرًى","مُخْتَلَقٌ، تَنْسُبُهُ إِلَى اللهِ كَذِبًا."],[1,12,2,"عَاقِبَةُ الدَّارِ","النِّهَايَةُ المَحْمُودَةُ فِي الآخِرَةِ."],[2,17,1,"صَرْحًا","بِنَاءً عَالِيًا."],[4,2,3,"فَنَبَذْنَاهُمْ فِي الْيَمِّ","فَأَلْقَيْنَاهُمْ وَأَغْرَقْنَاهُمْ فيِ البَحْرِ."],[5,1,1,"أَئِمَّةً","قَادَةً إِلَى النَّارِ."],[6,0,1,"وَأَتْبَعْنَاهُمْ","أَلْحَقْنَاهُمْ."],[6,4,1,"لَعْنَةً","طَرْدًا وَإِبْعَادًا مِنَ الرَّحْمَةِ."],[6,9,1,"الْمَقْبُوحِينَ","المُبْعَدِينَ المُسْتَقْذَرَةِ أَفْعَالُهُمْ."],[7,8,2,"الْقُرُونَ الْأُولَى","الأُمَمَ المَاضِيَةَ المُكَذِّبَةَ."],[7,10,2,"بَصَائِرَ لِلنَّاسِ","نُورًا لِقُلُوبِهِمْ يُبْصِرُونَ بِهِ الحَقَائِقَ."]]