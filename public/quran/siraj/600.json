[[0,3,1,"لَكَنُودٌ","لَجَحُودٌ."],[1,3,1,"لَشَهِيدٌ","لَمُقِرٌّ عَلَى جُحُودِهِ."],[2,2,1,"الْخَيْرِ","المَالِ."],[3,3,1,"بُعْثِرَ","أُثِيرَ، وَأُخْرِجَ."],[4,0,1,"وَحُصِّلَ","اُسْتُخْرِجَ، وَأُبْرِزَ."],[6,0,1,"الْقَارِعَةُ","القِيَامَةُ الَّتِي تَقْرَعُ القُلُوبَ بِأَهْوَالِهَا."],[9,4,1,"الْمَبْثُوثِ","المُنْتَشِرِ."],[10,2,1,"كَالْعِهْنِ","كَالصُّوفِ المَصْبُوغِ بِأَلْوَانٍ مُخْتَلِفَةٍ."],[10,3,1,"الْمَنفُوشِ","الَّذِي مُزِّقَ، وَنُفِشَ، فَتَفَرَّقَتْ أَجْزَاؤُهُ."],[11,2,2,"ثَقُلَتْ مَوَازِينُهُ","رَجَحَتْ مَوَازِينُ حَسَنَاتِهِ."],[14,0,2,"فَأُمُّهُ هَاوِيَةٌ","مَاوَاهُ إِلَى جَهَنَّمَ يَهْوِي عَلَى رَاسِهِ."],[16,1,1,"حَامِيَةٌ","حَارَّةٌ قَدِ اشْتَدَّ إِيقَادُهَا."],[17,0,1,"أَلْهَاكُمُ","شَغَلَكُمْ عَنْ طَاعَةِ اللهِ."],[17,1,1,"التَّكَاثُرُ","التَّفَاخُرُ بِكَثْرَةِ الأَمْوَالِ وَالأَوْلَادِ وَالمَتَاعِ."],[18,1,2,"زُرْتُمُ الْمَقَابِرَ","دُفِنْتُمْ فِي القُبُورِ."],[21,3,2,"عِلْمَ الْيَقِينِ","حَقَّ العِلْم."],[23,2,2,"عَيْنَ الْيَقِينِ","لَتُبْصِرُنَّ جَهَنَّمَ يَقِينًا بِلَا رَيْبٍ."],[24,4,1,"النَّعِيمِ","كُلِّ أَنْوَاعِ النِّعَمِ مِنَ الأَمْنِ، وَالأَهْلِ، وَالمَطْعَمِ، وَنَحْوِهَا."]]