[[0,3,1,"يُخْزِيهِمْ","يَفْضَحُهُمْ، وَيُذِلُّهُمْ بِالعَذَابِ."],[0,9,2,"تُشَاقُّونَ فِيهِمْ","تُحَارِبُونَ، وَتُجَادِلُونَ الأَنْبِيَاءَ لِأَجْلِهِمْ."],[1,5,2,"فَأَلْقَوُا السَّلَمَ","فَاسْتَسْلَمُوا لِأَمْرِ اللهِ."],[2,6,1,"مَثْوَى","مَقَرُّ."],[6,1,1,"يَنظُرُونَ","يَنْتَظِرُونَ."],[7,4,1,"وَحَاقَ","وَأَحَاطَ."]]