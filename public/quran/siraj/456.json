[[0,3,2,"وَمِثْلَهُم مَّعَهُمْ","زِدْنَاهُ مِثْلَهُمْ مَعَهُمْ."],[0,8,2,"لِأُوْلِي الْأَلْبَابِ","لِأَصْحَابِ العُقُولِ السَّلِيمَةِ."],[1,2,1,"ضِغْثًا","حُزْمَةَ شَمَارِيخَ أَوْ قَبْضَةَ حَشِيشٍ."],[1,5,2,"وَلَا تَحْنَثْ","لَا تَنْقُضْ يَمِينَكَ الَّتِي حَلَفْتَهَا بِضَرْبِ زَوْجَتِكَ."],[1,13,1,"أَوَّابٌ","رَجَّاعٌ إِلَى طَاعَةِ اللهِ."],[2,5,2,"أُوْلِي الْأَيْدِي","أَصْحَابَ القُوَّةِ فيِ الطَّاعَةِ."],[2,7,1,"وَالْأَبْصَارِ","البَصِيرَةِ فيِ الدِّينِ."],[3,1,2,"أَخْلَصْنَاهُم بِخَالِصَةٍ","خَصَصْنَاهُمْ بِخَصْلَةٍ عَظِيمَةٍ."],[3,3,2,"ذِكْرَى الدَّارِ","تَذَكُّرُ الآخِرَةِ فيِ قُلُوبِهِمْ."],[4,3,1,"الْمُصْطَفَيْنَ","المُخْتَارِينَ."],[6,4,2,"لَحُسْنَ مَآبٍ","حُسْنَ مَرْجِعٍ فيِ الآخِرَةِ."],[9,1,2,"قَاصِرَاتُ الطَّرْفِ","لَا يَنْظُرْنَ إِلَى غَيْرِ أَزْوَاجِهِنَّ."],[9,3,1,"أَتْرَابٌ","مُتَسَاوِيَاتُ السِّنِّ."],[11,6,1,"نَّفَادٍ","انْقِطَاعٍ."],[12,3,2,"لَشَرَّ مَآبٍ","أَسْوَأَ مَرْجعٍ فِي الآخِرَةِ."],[13,1,1,"يَصْلَوْنَهَا","يَدْخُلُونَهَا وَيُقَاسُونَ حَرَّهَا."],[13,3,1,"الْمِهَادُ","الفِرَاشُ."],[14,2,1,"حَمِيمٌ","مَاءٌ شَدِيدُ الحَرَارَةِ."],[14,3,1,"وَغَسَّاقٌ","صَدِيدٌ سَائِلٌ مِنْ أَجْسَادِ أَهْلِ النَّارِ."],[15,0,1,"وَآخَرُ","عَذَابٌ آخَرُ."],[15,1,2,"مِن شَكْلِهِ","مِنْ مِثْلِهِ."],[15,3,1,"أَزْوَاجٌ","أَصْنَافٌ، وَأَلْوَانٌ."],[16,1,1,"فَوْجٌ","جَمَاعَةٌ مِنْ أَهْلِ النَّارِ."],[16,2,2,"مُّقْتَحِمٌ مَّعَكُمْ","دَاخِلَةٌ النَّارَ مَعَكُمْ."],[16,4,3,"لَا مَرْحَبًا بِهِمْ","لَا رَحَّبَتْ بِهِمْ النَّارُ؛ وَلَا اتَّسَعَتْ مَنَازِلُهُمْ فِيهَا."],[16,8,2,"صَالُوا النَّارِ","مُقَاسُو حَرِّهَا."],[17,10,1,"الْقَرَارُ","المَقَرُّ."],[18,8,1,"ضِعْفًا","مُضَاعَفًا."]]