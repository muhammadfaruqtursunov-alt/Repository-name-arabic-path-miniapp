[[4,7,1,"الْمَرْجُومِينَ","المَقْتُولِينَ رَمْيًا بِالحِجَارَةِ."],[6,0,1,"فَافْتَحْ","احْكُمْ."],[7,5,1,"الْمَشْحُونِ","المَمْلُوءِ بِالنَّاسِ، وَالدَّوَابِّ، وَالمَتَاعِ."],[16,2,1,"رِيعٍ","مَكَانٍ مُرْتَفِعٍ."],[16,3,1,"آيَةً","بِنَاءً عَالِيًا."],[16,4,1,"تَعْبَثُونَ","تُشْرِفُونَ مِنْهُ فَتَسْخَرُونَ مِنَ المَارَّةِ."],[17,1,1,"مَصَانِعَ","قُصُورًا مَنِيعَةً وَحُصُونًا مُشَيَّدَةً."],[20,2,1,"أَمَدَّكُم","أَعْطَاكُمْ وَأَنْعَمَ عَلَيْكُمْ."],[24,1,2,"سَوَاءٌ عَلَيْنَا","يَسْتَوِي عِنْدَنَا."],[24,3,1,"أَوَعَظْتَ","أَخَوَّفْتَ."]]