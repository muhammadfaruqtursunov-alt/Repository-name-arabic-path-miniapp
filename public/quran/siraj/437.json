[[2,3,1,"الْحَرُورُ","الرِّيحُ الحَارَّةُ."],[6,10,1,"وَبِالزُّبُرِ","الكُتُبِ المَجْمُوعِ فِيهَا كَثِيرٌ مِنَ الأَحْكَامِ."],[7,6,1,"نَكِيرِ","إِنْكَارِي عَلَيْهِمْ، وَعُقُوبَتِي لَهُمْ."],[8,15,1,"جُدَدٌ","ذَاتُ طَرَائِقَ وَخُطُوطٍ مُخْتَلِفَةِ الأَلْوَانِ."],[8,20,2,"وَغَرَابِيبُ سُودٌ","شَدِيدَةُ السَّوَادِ؛ كَالأَغْرِبَةِ."],[10,14,2,"لَّن تَبُورَ","لَنْ تَكْسُدَ، وَتَهْلِكَ."]]