[[0,3,1,"رُوحًا","قُرْآنًا، سُمِّيَ القُرْآنُ رُوحًا؛ لِأَنَّهُ حَيَاةُ القُلُوبِ."],[0,25,2,"صِرَاطٍ مُّسْتَقِيمٍ","هُوَ: الإِسْلَامُ."],[1,13,1,"تَصِيرُ","تَرْجِعُ إِلَيْهِ، فَيُجَازِيكُمْ عَلَيْهَا."],[5,2,2,"أُمِّ الْكِتَابِ","اللَّوْحِ المَحْفُوظِ."],[5,5,1,"لَعَلِيٌّ","رَفِيعُ الشَّانِ."],[5,6,1,"حَكِيمٌ","مُحْكَمٌ، وَذُو حِكْمَةٍ بَالِغَةٍ."],[6,0,4,"أَفَنَضْرِبُ عَنكُمُ الذِّكْرَ صَفْحًا","أَفَنُعْرِضُ عَنْكُمْ، وَنَتْرُكُ تَذْكِيرَكُمْ بِالقُرْآنِ؟!"],[6,4,2,"أَن كُنتُمْ","بِسَبَبِ أَنْ كُنْتُمْ."],[7,0,2,"وَكَمْ أَرْسَلْنَا","كَثِيرًا مِنَ الأَنْبِيَاءِ أَرْسَلْنَا."],[9,3,1,"بَطْشًا","قُوَّةً."],[9,4,3,"وَمَضَى مَثَلُ الْأَوَّلِينَ","سَبَقَ فيِ القُرْآنِ أَحَادِيثُ إِهْلَاكِهِمْ."],[11,4,1,"مَهْدًا","فِرَاشًا مُمَهَّدًا."],[11,8,1,"سُبُلًا","طُرُقًا لِمَعَاشِكُمْ تَسْلُكُونَهَا."]]