[[0,2,1,"أُمَّةٌ","جَمَاعَةٌ."],[0,14,1,"مَعْذِرَةً","أَيْ: نَعِظُهُمْ؛ لِنُعْذِرَ إِلَى اللهِ فيهِمْ."],[1,14,1,"بَئِيسٍ","شَدِيدٍ."],[2,1,1,"عَتَوْا","اسْتَكْبَرُوا، وَعَصَوْا."],[2,10,1,"خَاسِئِينَ","أَذِلَّاءَ، مُبْعَدِينَ."],[3,1,1,"تَأَذَّنَ","أَعْلَمَ إِعْلَامًا صَرِيحًا."],[3,9,1,"يَسُومُهُمْ","يُذِيقُهُمْ."],[4,0,1,"وَقَطَّعْنَاهُمْ","فَرَّقْنَاهُمْ."],[4,3,1,"أُمَمًا","جَمَاعَاتٍ."],[4,10,1,"بِالْحَسَنَاتِ","بِالرَّخَاءِ فِي الْعَيْشِ."],[4,11,1,"وَالسَّيِّئَاتِ","الشِّدَّةِ فِي الْعَيْشِ."],[5,0,1,"فَخَلَفَ","فَجَاءَ."],[5,3,1,"خَلْفٌ","بَدَلُ سُوءٍ."],[5,4,2,"وَرِثُوا الْكِتَابَ","أَخَذُوهُ مِنْ أَسْلَافِهِمْ."],[5,7,3,"عَرَضَ هَذَا الأدْنَى","مَا يُعْرَضُ لَهُمْ مِنْ دَنِيءِ الْمَكَاسِبِ؛ كَالرِّشْوَةِ."],[5,21,2,"مِّيثَاقُ الْكِتَابِ","الْعُهُودُ فِي التَّوْرَاةِ؛ بِإِقَامَتِهَا، وَالْعَمَلِ بِهَا."],[5,30,3,"وَدَرَسُوا مَا فِيهِ","عَلِمُوا مَا فِي الْكِتَابِ، فَضَيَّعُوهُ."],[6,1,1,"يُمَسِّكُونَ","يَتَمَسَّكُونَ."]]