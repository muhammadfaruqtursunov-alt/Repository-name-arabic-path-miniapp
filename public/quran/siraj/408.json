[[2,3,1,"سُلْطَانًا","بُرْهَانًا سَاطِعًا وَكِتَابًا قَاطِعًا."],[3,3,1,"رَحْمَةً","نِعْمَةً؛ مِنْ صِحَّةٍ، وَرَخَاءٍ."],[3,4,2,"فَرِحُوا بِهَا","فَرَحَ بَطَرٍ، وَأَشَرٍ، لَا فَرَحَ شُكْرٍ."],[3,8,1,"سَيِّئَةٌ","فَقْرٌ، وَمَرَضٌ."],[3,14,1,"يَقْنَطُونَ","يَيْئَسُونَ مِنْ زَوَالِ البَلَاءِ."],[4,4,1,"يَبْسُطُ","يُوسِعُ."],[4,8,1,"وَيَقْدِرُ","يُضَيَّقُ."],[6,1,1,"آتَيْتُم","أَعْطَيْتُمْ."],[6,3,1,"رِّبًا","قَرْضًا مِنَ المَالِ بِقَصْدِ الرِّبَا المُحَرَّمِ."],[6,4,1,"لِّيَرْبُوَ","لِيَزِيدَ."],[6,21,1,"الْمُضْعِفُونَ","الَّذِين يُضَاعِفُ اللهُ لَهُمُ الحَسَنَاتِ."],[8,1,1,"الْفَسَادُ","كَالجَدْبِ، وَالأَمْرَاضِ، وَالأَوْبِئَةِ."]]