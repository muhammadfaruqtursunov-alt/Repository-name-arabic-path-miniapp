[[4,4,2,"بِعِزَّةِ فِرْعَوْنَ","أَقْسَمُوا بِعِزَّتِهِ، وَقُوَّتِهِ."],[5,5,1,"تَلْقَفُ","تَبْتَلِعُ بِسُرْعَةٍ."],[5,6,2,"مَا يَافِكُونَ","مَا يَفْعَلُونَهُ مِنَ الكَذِبِ وَالتَّزْوِيرِ."],[9,17,2,"مِّنْ خِلَافٍ","بِقَطْعِ اليَدِ اليُمْنَى وَالرِّجْلِ اليُسْرَى، أَوْ عَكْسَ ذَلِكَ."],[10,1,2,"لَا ضَيْرَ","لَا ضَرَرَ."],[10,6,1,"مُنقَلِبُونَ","رَاجِعُونَ."],[13,4,1,"حَاشِرِينَ","جَامِعِينَ لِلْجَيْشِ مِنَ المَدَائِنِ."],[14,2,1,"لَشِرْذِمَةٌ","لَطَائِفَةٌ حَقِيرَةٌ."],[18,0,1,"وَكُنُوزٍ","خَزَائِنِ الأَمْوَالِ."],[18,1,2,"وَمَقَامٍ كَرِيمٍ","مَنَازِلَ حِسَانٍ."],[20,1,1,"مُّشْرِقِينَ","وَقْتَ شُرُوقِ الشَّمْسِ."]]