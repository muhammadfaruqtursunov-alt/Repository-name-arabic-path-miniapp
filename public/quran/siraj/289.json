[[0,5,1,"ضَلَّ","غَابَ."],[1,9,1,"حَاصِبًا","رِيحًا شَدِيدَةً تَرْمِيكُمْ بالحَصْبَاءِ."],[1,14,1,"وَكِيلًا","حَافِظًا يَحْفَظُكُمْ."],[2,9,3,"قَاصِفًا مِّنَ الرِّيحِ","رِيحًا شَدِيدَةً لَا تَمُرُّ عَلَى شَيْءٍ إِلَّا كَسَرَتْهُ."],[2,21,1,"تَبِيعًا","تَابِعًا، وَمُطَالِبًا يُطَالِبُ بالثَّارِ مِنَّا."],[4,4,1,"بِإِمَامِهِمْ","بِمَنْ كَانُوا يَقْتَدُونَ بِهِ فِي الدُّنْيَا."],[4,12,2,"وَلَا يُظْلَمُونَ","لَا يُنْقَصُونَ."],[4,14,1,"فَتِيلًا","قَدْرَ الخَيْطِ الَّذِي يَكُونُ فِي شَقِّ النَّوَاةِ."],[6,1,1,"كَادُوا","قَارَبُوا."],[6,2,1,"لَيَفْتِنُونَكَ","لَيَصْرِفُونَكَ، وَيُوقِعُونَكَ فِي الفِتْنَةِ."],[6,7,1,"لِتفْتَرِيَ","لِتَخْتَلِقَ، وَتَكْذِبَ."],[6,12,1,"خَلِيلًا","حَبِيبًا خَالِصًا."],[8,2,2,"ضِعْفَ الْحَيَاةِ","عَذَابًا مُضَاعَفًا فِي الدُّنْيَا."],[8,4,2,"وَضِعْفَ الْمَمَاتِ","عَذَابًا مُضَاعَفًا فِي الآخِرَةِ."]]