[[0,0,1,"تَبَارَكَ","تَعَالَى، وَتَعاظَمَ، وَتَكَاثَرَ خَيْرُهُ وَبِرُّهُ."],[1,4,1,"لِيَبْلُوَكُمْ","لِيَخْتَبِرَكُمْ."],[1,6,2,"أَحْسَنُ عَمَلًا","أَخْلَصُهُ، وَأَصْوَبُهُ."],[2,4,1,"طِبَاقًا","بَعْضُهَا فَوْقَ بَعْضٍ، مِنْ غَيْرِ مُمَاسَّةٍ."],[2,11,1,"تَفَاوُتٍ","اخْتِلَافٍ، وَتَبَايُنٍ."],[2,17,1,"فُطُورٍ","شُقُوقٍ، وَصُدُوعٍ."],[3,0,4,"ثُمَّ ارْجِعِ الْبَصَرَ كَرَّتَيْنِ","أَعِدِ النَّظَرَ مَرَّةً بَعْدَ مَرَّةٍ."],[3,4,1,"يَنقَلِبْ","يَرْجِعْ."],[3,7,1,"خَاسِئًا","ذَلِيلًا صَاغِرًا."],[3,9,1,"حَسِيرٌ","مُتْعَبٌ، كَلِيلٌ."],[4,6,2,"رُجُومًا لِّلشَّيَاطِينِ","شُهُبًا مُحْرِقَةً لِمُسْتَرِقِي السَّمْعِ مِنَ الشَّيَاطِينِ."],[4,8,1,"وَأَعْتَدْنَا","أَعْدَدْنَا."],[5,6,1,"الْمَصِيرُ","المَرْجِعُ، وَالمَآلُ."],[6,5,1,"شَهِيقًا","صَوْتًا مُنْكَرًا."],[6,7,1,"تَفُورُ","تَغْلِي غَلَيَانًا شَدِيدًا."],[7,1,3,"تَمَيَّزُ مِنَ الْغَيْظِ","تَتَمَزَّقُ مِنْ شِدَّةِ غَضَبِهَا عَلَى الكُفَّارِ."],[7,7,1,"فَوْجٌ","جَمَاعَةٌ."],[7,12,1,"نَذِيرٌ","رَسُولٌ يُحَذِّرُكُمْ هَذَا العَذَابَ."],[8,12,2,"إِنْ أَنتُمْ","مَا أَنْتُمْ."],[10,2,1,"فَسُحْقًا","بَعْدًا."],[11,4,1,"بِالْغَيْبِ","يَخْشَوْنَهُ وَهُمْ غَائِبُونَ عَنْ أَعْيُنِ النَّاسِ، وَيَخْشَوْنَ العَذَابَ قَبْلَ مُعَايَنَتِهِ."]]