[[0,9,2,"بِمَا رَحُبَتْ","مَعَ رَحْبِهَا وَسَعَتِهَا."],[2,13,5,"وَلَا يَرْغَبُوا بِأَنفُسِهِمْ عَن نَّفْسِهِ","بِأَنْ لَّا يَرْضَوْا بِالرَّاحَةِ لِأَنْفُسِهِمْ مَعَ تَعَبِهِ - صلى الله عليه وسلم -."],[2,24,1,"نَصَبٌ","تَعَبٌ."],[2,26,1,"مَخْمَصَةٌ","مَجَاعَةٌ."],[2,33,1,"يَغِيظُ","يُغْضِبُ، وَيُغِمُّ."],[2,39,1,"نَّيْلًا","قَتْلًا، أَوْ هَزِيمَةً، أو أذًى."],[4,3,2,"لِيَنفِرُوا كَافَّةً","لِيَخْرُجُوا لِلْجِهَادِ جَمِيعًا."]]