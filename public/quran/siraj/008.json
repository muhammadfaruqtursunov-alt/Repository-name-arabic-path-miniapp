[[0,5,1,"يَسُومُونَكُمْ","يُذِيقُونَكُمْ."],[0,14,1,"بَلاءٌ","اخْتِبَارٌ أو نِعْمَةٌ."],[1,1,1,"فَرَقْنَا","فَصَلْنَا."],[4,4,1,"وَالْفُرْقَانَ","الَّذِي يَفْصِلُ بَيْنَ الْحَقِّ وَالْبَاطِلِ؛ وَهُوَ التَّوْرَاةُ."],[5,12,1,"بَارِئِكُمْ","خَالِقِكُمْ."],[6,11,1,"الصَّاعِقَةُ","نَارٌ مِنَ السَّمَاءَ."],[8,0,1,"وَظَلَّلْنَا","جَعَلْنَاهُ ظِلًّا مِنْ حَرِّ الشَّمْسِ."],[8,2,1,"الْغَمَامَ","السَّحَابَ."],[8,5,1,"الْمَنَّ","شَيْئًا يُشْبِهُ الصَّمْغَ كَالْعَسَلِ."],[8,6,1,"وَالسَّلْوَى","طَيْرًا يُشْبِهُ السُّمَانَى."]]