[[0,4,1,"مُصْفَرًّا","صَارَ أَصْفَرَ بَعْدَ خُضْرَتِهِ؛ مِنَ الفَسَادِ."],[3,3,2,"مِّن ضَعْفٍ","مِنَ النُّطْفَةِ المَهِينَةِ."],[3,7,4,"مِن بَعْدِ ضَعْفٍ قُوَّةً","بَعْدَ ضَعْفِ الطُّفُولَةِ قُوَّةَ الرُّجُولَةِ."],[3,17,1,"وَشَيْبَةً","شَيْخُوخَةً، وَهَرَمًا."],[4,7,2,"غَيْرَ سَاعَةٍ","غَيْرَ فَتْرَةٍ قَصِيرَةٍ مِنَ الزَّمَنِ."],[4,11,1,"يُؤْفَكُونَ","يُصْرَفُونَ عَنِ الحَقِّ."],[6,5,1,"مَعْذِرَتُهُمْ","مَا يُقَدِّمُونَهُ مِنْ أَعْذَارٍ."],[6,6,3,"وَلَا هُمْ يُسْتَعْتَبُونَ","لَا يُطْلَبُ مِنْهُمْ إِرْضَاءُ اللهِ بِالطَّاعَةِ وَالتَّوْبَةِ."],[8,1,1,"يَطْبَعُ","يَخْتِمُ."],[9,5,2,"وَلَا يَسْتَخِفَّنَّكَ","لَا يَسْتَفِزَّنَّكَ، وَلَا يَحْمِلَنَّكَ عَلَى الخِفَّةِ، وَالطَّيْشِ."]]