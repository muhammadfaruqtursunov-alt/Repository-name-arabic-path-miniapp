[[0,3,1,"بِالْبَيِّنَاتِ","بِالحُجَجِ الوَاضِحَاتِ."],[0,7,1,"وَالْمِيزَانَ","العَدْلَ فيِ الأَقْوَالِ، وَالأَفْعَالِ."],[0,14,1,"بَاسٌ","قُوَّةٌ."],[0,27,1,"عَزِيزٌ","غَالِبٌ لَا يُغْلَبُ."],[2,1,3,"قَفَّيْنَا عَلَى آثَارِهِم","أَتْبَعْنَاهُمْ، وَبَعَثْنَا بَعْدَهُمْ."],[2,18,1,"وَرَهْبَانِيَّةً","غُلُوًّا فِي التَّعَبُّدِ."],[2,20,2,"مَا كَتَبْنَاهَا","مَا فَرَضْنَاهَا."],[2,24,1,"ابْتِغَاءَ","فَعَلُوهَا مِنْ عِنْدِ أَنْفُسِهِمْ يَطْلُبُونَ ..."],[2,27,2,"فَمَا رَعَوْهَا","مَا قَامُوا بِهَا حَقَّ القِيَامِ، بَلْ بَدَّلُوا وَخَالَفُوا."],[3,8,1,"كِفْلَيْنِ","ضِعْفَيْنِ."],[4,0,2,"لِئَلَّا يَعْلَمَ","أَعْطَاكُمُ اللهُ ذَلِكَ لِأَجْلِ أَنْ يَعْلَمَ."]]