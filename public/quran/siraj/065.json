[[1,10,1,"صِرٌّ","بَرْدٌ شَدِيدٌ."],[2,8,3,"لَا يَالُونَكُمْ خَبَالًا","لَا يُقَصِّرُونَ فِي إِفْسَادِ حَالِكُمْ."],[2,11,3,"وَدُّوا مَا عَنِتُّمْ","أَحَبُّوا مَشَقَّتَكُمُ الشَّدِيدَةَ."],[3,1,1,"أُوْلاءِ","هَؤُلَاءِ."],[5,1,1,"غَدَوْتَ","خَرَجْتَ مِنْ أَوَّلِ النَّهَارِ."],[5,4,1,"تُبَوِّئُ","تُنَزِّلُ."]]