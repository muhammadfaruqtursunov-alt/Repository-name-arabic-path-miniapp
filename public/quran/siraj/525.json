[[0,2,1,"أَحْلَامُهُم","عُقُولُهُمْ."],[0,7,1,"طَاغُونَ","مُتَجَاوِزُونَ الحَدَّ فِي العِصْيَانِ."],[1,2,1,"تَقَوَّلَهُ","اخْتَلَقَ القُرْآنَ مِنْ عِنْدِ نَفْسِهِ."],[5,2,2,"خَزَائِنُ رَبِّكَ","خَزَائِنُ رِزْقِهِ وَرَحْمَتِهِ."],[5,6,1,"الْمُصَيْطِرُونَ","المُتَسَلِّطُونَ، الجَبَّارُونَ."],[6,2,1,"سُلَّمٌ","مِصْعَدٌ إِلَى السَّمَاءِ."],[6,7,2,"بِسُلْطَانٍ مُّبِينٍ","بِحُجَّةٍ بَيِّنَةٍ تُصَدِّقُ دَعْوَاهُ."],[8,4,2,"مِّن مَّغْرَمٍ","مِنِ الْتِزَامِ غَرَامَةٍ تَطْلُبُهَا مِنْهُمْ."],[8,6,1,"مُّثْقَلُونَ","مُتْعَبُونَ، مُجْهَدُونَ."],[10,2,1,"كَيْدًا","مَكْرًا."],[10,6,1,"الْمَكِيدُونَ","يَرْجِعُ مَكْرُهُمْ عَلَى أَنْفُسِهِمْ."],[12,2,1,"كِسْفًا","قِطَعًا."],[12,8,1,"مَّرْكُومٌ","مُتَرَاكِمٌ بَعْضُهُ فَوْقَ بَعْضٍ."],[13,6,1,"يُصْعَقُونَ","يُهْلَكُونَ."],[14,1,3,"لَا يُغْنِي عَنْهُمْ","لَا يَدْفَعُ عَنْهُمْ."],[15,4,2,"دُونَ ذَلِكَ","قَبْلَ ذَلِكَ يَقَعُ فِي الدُّنْيَا عَلَيْهِمْ."],[16,4,1,"بِأَعْيُنِنَا","بِمَرْأًى مِنَّا، وَحِفْظٍ، وَاعْتِنَاءٍ؛ وَفِيهِ: إِثْبَاتُ صِفَةِ العَيْنَيْنِ للهِ؛ كَمَا يَلِيقُ بِهِ؛ بِلَا تَكْيِيفٍ، وَلَا تَمْثِيلٍ، وَجَاءَتْ بِصِيغَةِ الجَمْعِ لِلتَّعْظِيمِ."],[16,5,3,"وَسَبِّحْ بِحَمْدِ رَبِّكَ","نَزِّه رَبَّكَ، حَامِدًا لَهُ."],[16,8,2,"حِينَ تَقُومُ","لِلصَّلَاةِ، وَمِنْ نَوْمِكَ."],[17,2,1,"فَسَبِّحْهُ","نَزِّهْهُ، وَعَظِّمْهُ، وَصَلِّ لَهُ."],[17,3,2,"وَإِدْبَارَ النُّجُومِ","نَزِّهْهُ، وَصَلِّ لَهُ صَلَاةَ الصُّبْحِ وَقْتَ غَيْبَةِ النُّجُومِ."]]