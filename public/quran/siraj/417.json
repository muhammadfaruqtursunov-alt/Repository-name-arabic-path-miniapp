[[0,2,2,"الْعَذَابِ الْأَدْنَى","البَلَايَا وَالمَصَائِبِ فِي الدُّنْيَا."],[2,7,1,"مِرْيَةٍ","شَكٍّ."],[2,8,2,"مِّن لِّقَائِهِ","لِقَاِء مُوسَى - عليه السلام - لَيْلَةَ الإِسْرَاءِ."],[5,0,3,"أَوَلَمْ يَهْدِ لَهُمْ","أَوَلَمْ يَتَبَيَّنْ لِهَؤُلَاءِ الُمَكِّذِبينَ؟"],[5,3,2,"كَمْ أَهْلَكْنَا","مَا أَكْثَرَ إِهْلَاكَنَا!"],[5,7,2,"مِّنَ الْقُرُونِ","مِنَ الأُمَمِ السَّابِقَةِ."],[6,7,1,"الْجُرُزِ","اليَابِسَةِ، الغَلِيظَةِ الَّتِي لَا نَبَاتَ فِيهَا."],[7,3,1,"الْفَتْحُ","يَوْمُ العَذَابِ الَّذِي تَعِدُونَنَا."],[8,10,1,"يُنظَرُونَ","يُمْهَلُونَ."]]