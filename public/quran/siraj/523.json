[[1,0,2,"أَتَوَاصَوْا بِهِ","هَلْ وَصَّى بَعْضُهُمْ بَعْضًا بِالتَّكْذِيبِ؟"],[1,5,1,"طَاغُونَ","مُتَجَاوِزُونَ الحَدَّ فِي الكُفْرِ."],[7,3,1,"ذَنُوبًا","نَصِيبًا مِنَ العَذَابِ سَيَنْزِلُ بِهِمْ."],[9,0,1,"وَالطُّورِ","قَسَمٌ بِالجَبَلِ الَّذِي كَلَّمَ اللهُ عَلَيْهِ مُوسَى - عليه السلام -."],[10,0,2,"وَكِتَابٍ مَّسْطُورٍ","قَسَمٌ بِالقُرْآنِ المَكْتُوبِ."],[11,0,3,"فِي رَقٍّ مَّنشُورٍ","فَي صُحُفٍ مَنْشُورَةٍ، مَبْسُوطَةٍ."],[12,0,2,"وَالْبَيْتِ الْمَعْمُورِ","قَسَمٌ بِالبَيْتِ المَعْمُورِ بِالمَلَائِكَةِ الَّذِينَ يَطُوفُونَ بِهِ دَائِمًا، وَهُوَ فيِ السَّمَاءِ بِحِذَاءِ الكَعْبَةِ، يَطُوفُ بِهِ كُلَّ يَوْمٍ سَبْعُونَ أَلْفَ مَلَكٍ."],[13,0,2,"وَالسَّقْفِ الْمَرْفُوعِ","قَسَمٌ بِالسَّمَاءِ."],[14,1,1,"الْمَسْجُورِ","المَمْلُوءِ بِالمَاءِ."],[17,1,1,"تَمُورُ","تَتَحَرَّكُ، وَتَضْطَرِبُ."],[21,1,1,"يُدَعُّونَ","يُدْفَعُونَ بِعُنْفٍ وَشِدَّةٍ."]]