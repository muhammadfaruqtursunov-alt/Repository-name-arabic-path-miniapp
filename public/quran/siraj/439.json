[[0,3,1,"خَلَائِفَ","يَخْلُفُ بَعْضُكُمْ بَعْضًا فِي الأَرْضِ."],[0,17,1,"مَقْتًا","بُغْضًا وَغَضَبًا."],[1,1,1,"أَرَأَيْتُمْ","أَخْبِرُونِي."],[1,23,2,"بَيِّنَةٍ مِّنْهُ","حُجَّةٍ مِنْهُ."],[1,32,1,"غُرُورًا","خِدَاعًا وَبَاطِلًا."],[3,2,2,"جَهْدَ أَيْمَانِهِمْ","مُجْتَهِدِينَ في الحَلِفِ بِأَغْلَظِ الأَيْمَانِ."],[3,6,1,"نَذِيرٌ","رَسُولٌ مِنْ عِنْدِ اللهِ تَعَالَى."],[4,6,1,"يَحِيقُ","يُحِيطُ، وَيَنْزِلُ."],[4,12,1,"يَنظُرُونَ","يَنْتَظِرُونَ."],[4,14,2,"سُنَّتَ الْأَوَّلِينَ","العَذَابَ الَّذِي نَزَلَ بِأَمْثَالِهِمْ."]]