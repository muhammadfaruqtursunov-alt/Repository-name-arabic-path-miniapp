[[2,1,1,"فُصِّلَتْ","بُيِّنَتْ آيَاتُهُ، وَوُضِّحَتْ مَعَانِيهِ."],[4,3,1,"أَكِنَّةٍ","أَغْطِيَةٍ مَانِعَةٍ مِنْ فَهْمِ مَا تَدْعُونَا إِلَيْهِ."],[4,9,1,"وَقْرٌ","صَمَمٌ، وَثِقَلٌ."],[5,11,2,"فَاسْتَقِيمُوا إِلَيْهِ","اسْلُكُوا الطَّرِيقَ المُوصِلَ إِلَيْهِ."],[5,6,1,"وَوَيْلٌ","هَلَاكٌ، وَعَذَابٌ."],[7,7,2,"غَيْرُ مَمْنُونٍ","غَيْرُ مَقْطُوعٍ، وَلَا مَمْنُوعٍ."],[8,10,1,"أَندَادًا","شُرَكَاءَ، وَنُظَرَاءَ."],[9,2,1,"رَوَاسِيَ","جِبَالًا ثَوَابِتَ."],[9,9,1,"أَقْوَاتَهَا","أَرْزَاقَ أَهْلِهَا."],[9,10,3,"فِي أَرْبَعَةِ أَيَّامٍ","يَوْمَانِ لِخَلْقِ الأَرْضِ، وَيَوَمْانِ لِخَلْقِ الرَّوَاسِي، وَتَقْدِيرِ الأَقْوَاتِ."],[9,13,1,"سَوَاءً","فِي تَمَامِ أَرْبَعَةِ أَيَّامٍ مُسْتَوِيَةٍ؛ بِلَا زِيَادة، وَلَا نُقْصَانٍ."],[10,1,1,"اسْتَوَى","قَصَدَ."]]