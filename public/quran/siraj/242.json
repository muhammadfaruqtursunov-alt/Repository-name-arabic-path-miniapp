[[0,5,2,"لأَمَّارَةٌ بِالسُّوءِ","كَثِيرَةُ الأَمْرِ بِالمَعَاصِي."],[1,4,1,"أَسْتَخْلِصْهُ","أَجْعَلْهُ مِنْ خُلَصَائِي، وَأَهْلِ مَشُورَتِي."],[1,12,1,"مِكِينٌ","عَظِيمُ المَكَانَةِ."],[3,5,1,"يَتَبَوَّأُ","يَنْزِلُ."],[6,1,2,"جَهَّزَهُم بِجَهَازِهِمْ","أَعْطَاهُمْ مَا طَلَبُوا، وَوَفَّى الكَيْلَ لَهُمْ."],[8,1,3,"سَنُرَاوِدُ عَنْهُ أَبَاهُ","سَنَبْذُلُ جُهْدَنَا، لإِقْنَاعِ أَبِيهِ."],[9,3,1,"بِضَاعَتَهُمْ","الثَّمَنَ الَّذِي دَفَعُوهُ."],[9,5,1,"رِحَالِهِمْ","أَمْتِعَتِهِمْ، وَأَوْعِيَتِهِمْ."]]