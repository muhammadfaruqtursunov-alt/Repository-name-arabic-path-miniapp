[[1,4,1,"لَعِبْرَةً","لَعِظَةً."],[1,11,1,"فَرْثٍ","مَا فِي الكَرِشِ."],[1,15,1,"سَائِغًا","لَذِيذًا لَا يَغَصُّ بِهِ شَارِبُهُ."],[2,6,1,"سَكَرًا","خَمْرًا مُسْكِرًا."],[3,12,1,"يَعْرِشُونَ","يَبْنُوُن مِنَ البُيُوتِ وَالسُّقُوفِ لِلنَّحْلِ."],[4,5,1,"فَاسْلُكِي","فَادْخُلِي."],[4,6,1,"سُبُلَ","طُرُقَ."],[4,8,1,"ذُلُلًا","مُذَلَّلَةً، مُسَخَّرَةً."],[5,8,2,"أَرْذَلِ الْعُمُرِ","أَرْدَأِ أَعْمَارِكُمْ، وَهُوَ الهَرَمُ."],[7,11,1,"وَحَفَدَةً","أَوْلَادَ الأَوْلَادِ."]]