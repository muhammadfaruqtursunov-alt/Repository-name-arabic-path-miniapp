[[1,2,1,"تَقَلُّبُ","سَعَةُ عَيْشٍ، وَكَثْرَةُ تَنَقُّلٍ وَتَصَرُّفٍ."],[2,6,1,"الْمِهَادُ","الفِرَاشُ."],[3,12,1,"نُزُلًا","ضِيَافَةً، وَمَنْزِلًا."],[5,3,1,"وَصَابِرُوا","غَالِبُوا الأَعْدَاءَ بِالصَّبْرِ حَتَّى تَكُونُوا أَكْثَرَ صَبْرًا مِنْهُمْ."],[5,5,1,"وَرَابِطُوا","أَقِيمُوا عَلَى جِهَادِ عَدُوِّكُمْ."]]