[[3,3,1,"يَبُثُّ","يَنْشُرُ، وَيُفَرِّقُ."],[4,15,2,"وَتَصْرِيفِ الرِّيَاحِ","تَقْلِيبِهَا فيِ مَهَابِّهَا لِمَنْفَعَتِكُمْ."],[6,0,1,"وَيْلٌ","هَلَاكٌ، وَدَمَارٌ."],[6,2,1,"أَفَّاكٍ","كَذَّابٍ."],[6,3,1,"أَثِيمٍ","كَثِيرِ الإِثْمِ."],[8,6,1,"هُزُوًا","سُخْرِيَةً."],[11,6,1,"الْفُلْكُ","السُّفُنُ."]]