[[0,4,1,"غِسْلِينٍ","صَدِيدِ أَهْلِ النَّارِ."],[1,3,1,"الْخَاطِئُونَ","المُذْنِبُونَ، المُصِرُّونَ عَلَى الكُفْرِ."],[2,0,2,"فَلَا أُقْسِمُ","أُقْسِمُ، وَ (لَا): لِتَاكِيدِ القَسَمِ."],[6,1,2,"بِقَوْلِ كَاهِنٍ","بِسَجْعٍ كَسَجَعِ الكُهَّانِ الَّذِينَ يَدَّعُونَ عِلْمَ المُغَيَّبَاتِ."],[8,1,1,"تَقَوَّلَ","اخْتَلَقَ، وَافْتَرى عَلَيْنَا."],[10,3,1,"الْوَتِينَ","نِيَاطَ القَلْبِ، وَهُوَ: عِرْقٌ مُتَّصِلٌ بِهِ إِذَا قُطِعَ مَاتَ صَاحِبُهُ."],[11,5,1,"حَاجِزِينَ","مَانِعِينَ الهَلَاكَ وَالعِقَابَ عَنْهُ."],[14,1,1,"لَحَسْرَةٌ","لَنَدَامَةٌ عَظِيمَةٌ."],[16,0,3,"فَسَبِّحْ بِاسْمِ رَبِّكَ","فَنَزِّهْ رَبَّكَ عَمَّا لَا يَلِيقُ بِهِ ذَاكِرًا اسْمَهُ."],[17,0,2,"سَأَلَ سَائِلٌ","دَعَا دَاعٍ."],[17,2,2,"بِعَذَابٍ وَاقِعٍ","بِوُقُوعِ العَذَابِ عَلَيْهِمْ."],[19,2,2,"ذِي الْمَعَارِجِ","صَاحِبِ العُلُوِّ وَالجَلَالِ."],[20,0,1,"تَعْرُجُ","تَصْعَدُ."],[20,2,1,"وَالرُّوحُ","جِبْرِيلُ - عليه السلام -."],[21,1,2,"صَبْرًا جَمِيلًا","لَا جَزَعَ فِيهِ، وَلَا شَكْوَى مِنْهُ لِغَيْرِ اللهِ."],[24,3,1,"كَالْمُهْلِ","مِثْلَ حُثَالَةِ الزَّيْتِ."],[25,2,1,"كَالْعِهْنِ","كَالصُّوفِ المَصْبُوغِ المَنْفُوشِ الَّذِي ذَرَتْهُ الرِّيحُ."],[26,2,1,"حَمِيمٌ","قَرِيبٌ."]]