[[1,4,4,"لَّا قِبَلَ لَهُم بِهَا","لَا طَاقَةَ لَهُمْ بِمُقَاوَمَةِ الجُنُودِ."],[1,12,1,"صَاغِرُونَ","مُهَانُونَ."],[2,2,1,"المَلَأُ","مَنْ سَخَّرَهُمُ اللهُ لَهُ مِنَ الجِنِّ وَالإِنْسِ."],[3,1,1,"عِفْريتٌ","مَارِدٌ قَوِيٌّ شَدِيدٌ."],[3,11,1,"مَّقَامِكَ","مَجْلِسِكَ."],[4,11,3,"يَرْتَدَّ إِلَيْكَ طَرْفُكَ","قَبْلَ ارْتِدَادِ أَجْفَانِكَ إِذَا نَظَرْتَ إِلَى شَيْءٍ."],[4,16,2,"مُسْتَقِرًّا عِندَهُ","حَاضِرًا لَدَيْهِ ثَابِتًا عِنْدَهُ."],[5,1,1,"نَكِّرُوا","غَيِّرُوا."],[8,3,1,"الصَّرْحَ","القَصْرَ، وَكَانَ صَحْنُهُ مِنْ زُجَاجٍ تَحْتَهُ مَاءٌ."],[8,6,2,"حَسِبَتْهُ لُجَّةً","ظَنَّتْهُ مَاءً غَزِيرًا."],[8,14,1,"مُّمَرَّدٌ","مُمَلَّسٌ مُسَوًّى."],[8,15,2,"مِّن قَوَارِيرَ","مِنْ زُجَاجٍ صَافٍ."]]