[[0,4,1,"فَأَوْرَدَهُمُ","فَأَدْخَلَهُمْ."],[0,7,1,"الْوِرْدُ","المَدْخَلُ."],[0,8,1,"الْمَوْرُودُ","المَدْخُولُ فِيهِ، وَهُوَ هُنَا النَّارُ."],[1,7,1,"الرِّفْدُ","العَوْنُ، وَالعَطَاءُ."],[1,8,1,"الْمَرْفُودُ","المُعْطَى لَهُمْ."],[2,7,1,"قَائِمٌ","آثَارُهُ بَاقِيَةٌ كَمَدَائِنِ صَالِح."],[2,8,1,"وَحَصِيدٌ","مَحْصُودٌ قَدْ مُحِيَتْ آثَارُهُ، وَلَمْ يَبْقَ مِنْهُ شَيْءٌ."],[3,6,1,"أَغْنَتْ","نَفَعَتْ."],[3,23,1,"تَتْبِيبٍ","تَدْمِيرٍ، وَإِهْلَاكٍ، وَخُسْرَانٍ."],[8,7,1,"زَفِيرٌ","صَوْتٌ شَنِيعٌ، يُسْمَعُ عِنْدَ إِخْرَاجِ النَّفَسِ."],[8,8,1,"وَشَهِيقٌ","صَوْتٌ شَنِيعٌ، يُسْمَعُ عِنْدَ إِدْخَالِ النَّفَسِ."],[10,17,1,"مَجْذُوذٍ","مَقْطُوعٍ."]]