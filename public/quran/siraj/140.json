[[0,2,2,"فَالِقُ الْحَبِّ","الَّذِي يَشُقُّ الْحَبَّ، فَيَخْرُجُ الزَّرْعُ مِنْهُ."],[0,16,1,"تُؤْفَكُونَ","تُصْرَفُونَ عَنِ الْحَقِّ."],[1,0,2,"فَالِقُ الإِصْبَاحِ","الَّذِي يَشُقُّ ضِيَاءَ الصُّبْحِ."],[1,7,1,"حُسْبَانًا","بِحِسَابٍ مُقَدَّرٍ."],[3,6,1,"فَمُسْتَقَرٌّ","رَحِمُ المَرْأَةِ، تَسْتَقِرُّ فِيهِ النُّطْفَةُ."],[3,7,1,"وَمُسْتَوْدَعٌ","صُلْبُ الرَّجُلِ، تُحْفَظُ فِيهِ النُّطْفَةُ."],[4,13,1,"خَضِرًا","زَرْعًا، وَشَجَرًا أَخْضَرَ."],[4,17,1,"مُّتَرَاكِبًا","يَرْكَبُ بَعْضُهُ فَوْقَ بَعْضٍ."],[4,21,1,"طَلْعِهَا","مَا تَنْشَأُ فِيهِ عُذُوقُ الرُّطَبِ."],[4,22,2,"قِنْوَانٌ دَانِيَةٌ","عُذُوقٌ قَرِيبَةُ التَّنَاوُلِ."],[4,37,1,"وَيَنْعِهِ","نُضْجِهِ، وَبُلُوغِهِ حِينَ يَبْلُغُ."],[5,5,1,"وَخَرَقُوا","اخْتَلَقُوا وَافْتَرَوْا لَهُ سُبْحَانَهُ."],[6,0,1,"بَدِيعُ","خَالِقُ، وَمُبْدِعُ."]]