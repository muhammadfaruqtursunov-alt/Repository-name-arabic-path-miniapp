[[1,11,1,"مَلُومًا","يَلُومُكَ النَّاسُ، وَيَذُمُّونَكَ."],[1,12,1,"مَّحْسُورًا","فَارغَ اليَدِ نَادِمًا، عَلَى تَبْذِيرِكَ."],[2,6,1,"وَيَقْدِرُ","يُضَيِّقُ."],[3,4,1,"إِمْلاقٍ","فَقْرٍ."],[3,11,1,"خِطْئًا","ذَنْبًا."],[4,7,1,"سَبِيلًا","طَرِيقًا."],[5,5,1,"لِوَلِيِّهِ","مَنْ تَوَلَّى أَمْرَ القَتِيلِ مِنْ وَارِثٍ، أَوْ حَاكِمٍ."],[5,14,1,"سُلْطَانًا","حُجَّةً."],[6,3,1,"الْيَتِيمِ","مَنْ مَاتَ أَبُوهُ قَبْلَ البُلُوغِ."],[7,5,2,"بِالقِسْطَاسِ الْمُسْتَقِيمِ","بِالمِيزَانِ السَّوِيِّ."],[7,10,1,"تَاوِيلًا","عَاقِبَةً عِنْدَ اللهِ فِي الآخِرَةِ."],[8,0,2,"وَلَا تَقْفُ","لَا تَتْبَعْ."],[9,4,1,"مَرَحًا","مُخْتالًا، مُتَكَبِّرًا."]]