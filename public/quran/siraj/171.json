[[0,0,1,"وَقَطَّعْنَاهُمُ","فَرَّقْنَاهُمْ."],[0,3,1,"أَسْبَاطًا","قَبِيلَةً بِعَدَدِ الأَسْبَاطِ، وَهُمْ أَبْنَاءُ يَعْقُوبَ - عليه السلام - الاِثْنَا عَشَرَ."],[0,15,1,"فَانبَجَسَتْ","فَانْفَجَرَتْ، والاِنْبِجَاسُ أَوَّلُ الاِنْفِجَارِ."],[0,27,1,"الْغَمَامَ","السَّحَابَ."],[0,30,1,"الْمَنَّ","شَيْئًا يُشْبِهُ الصَّمْغَ طَعْمُهُ كَالْعَسَلِ."],[0,31,1,"وَالسَّلْوَى","طَائِرًا يُشْبِهُ السُّمَانَى."],[1,5,1,"الْقَرْيَةَ","بَيْتَ الْمَقْدِسِ."],[1,11,1,"حِطَّةٌ","حُطَّ عَنَّا ذُنُوبَنَا."],[2,11,1,"رِجْزًا","عَذَابًا."],[3,5,2,"حَاضِرَةَ الْبَحْرِ","عَلَى سَاحِلِ الْبَحْرِ الأَحْمَرِ."],[3,8,3,"يَعْدُونَ فِي السَّبْتِ","يَعْتَدُونَ بِالصَّيْدِ فِي يَوْمِ السَّبْتِ، وَهُوَ مُحَرَّمٌ عَلَيْهِمْ."],[3,16,1,"شُرَّعًا","ظَاهِرَةً عَلَى وَجْهِ الْمَاءِ."],[3,18,2,"لَا يَسْبِتُونَ","فِي غَيْرِ يَوْمِ السَّبْتِ."]]