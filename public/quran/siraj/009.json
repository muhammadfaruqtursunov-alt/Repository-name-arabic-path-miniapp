[[0,13,2,"وَقُولُوا حِطَّةٌ","أَيْ: قُولُوا احْطُطْ، وَضَعْ عَنَّا ذُنُوبَنَا."],[1,12,1,"رِجْزًا","عَذَابًا."],[2,23,2,"وَلَا تَعْثَوْا","لَا تَسْعَوْا."],[3,17,1,"بَقْلِهَا","الْبُقُولِ وَالْخُضَرِ كَالنَّعْنَاعِ."],[3,18,1,"وَقِثَّائِهَا","الخَيَارِ."],[3,19,1,"وَفُومِهَا","الحِنْطَةِ، وَالحُبُوبِ الَّتِي تُؤْكَلُ."],[3,31,1,"مِصْرًا","بَلَدًا."],[3,39,1,"وَالْمَسْكَنَةُ","فَقْرُ النَّفْسِ."],[3,40,1,"وَبَاؤُوْا","رَجَعُوا."]]