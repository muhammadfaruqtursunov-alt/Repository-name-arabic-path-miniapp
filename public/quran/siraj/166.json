[[0,2,1,"الْحَسَنَةُ","الْخَصْبُ، وَالرِّزْقُ."],[0,8,1,"سَيِّئَةٌ","قَحْطٌ، وَجَدْبٌ."],[0,9,1,"يَطَّيَّرُوا","يَتَشَاءَمُوا."],[0,15,3,"طَائِرُهُمْ عِندَ اللهِ","مَا أَصَابَهُمْ مِنَ الْقَحْطِ بِقَدَرِ اللهِ."],[2,2,1,"الطُّوفَانَ","السَّيْلَ الْجَارِفَ الَّذِي أَغْرَقَ زُرُوعَهُمْ."],[2,3,1,"وَالْجَرَادَ","الَّذِي أَكَلَ زَرْعَهُمْ، وَأَشْيَاءَهُمْ."],[2,4,1,"وَالْقُمَّلَ","الَّذِي يُفْسِدُ الثِّمَارَ، وَيَقْضِي عَلَى الْحَيَوَانِ وَالنَّبَاتِ."],[2,5,1,"وَالضَّفَادِعَ","الَّتِي مَلَأَتْ آنِيَتَهُمْ، وَمَضَاجِعَهُمْ."],[2,6,1,"وَالدَّمَ","الَّذِي اخْتَلَطَ بِمِيَاهِهِمْ."],[2,8,1,"مُّفَصَّلَاتٍ","مُبَيَّنَاتٍ."],[3,3,1,"الرِّجْزُ","الْعَذَابُ."],[3,10,1,"عَهِدَ","أَوْحَى."],[4,10,1,"يَنكُثُونَ","يَنقُضُونَ عَهْدَهُمْ."],[5,4,1,"الْيَمِّ","الْبَحْرِ."],[6,5,3,"مَشَارِقَ الأَرْضِ وَمَغَارِبَهَا","بِلَادَ الشَّامِ."],[6,28,1,"يَعْرِشُونَ","يَرْفَعُونَ مِنَ الْبِنَاءِ."]]