[[0,8,2,"يَرْجُو اللَّهَ","يَطْمَعُ فِي الخَيْرِ مِنَ اللهِ."],[0,13,1,"يَتَوَلَّ","يُعْرِضْ عَنِ الاِقْتِدَاءِ بِالأَنْبِيَاءِ، وَيُوَالِ أَعْدَاءَ اللهِ."],[0,18,1,"الْحَمِيدُ","المَحْمُودُ فِي ذَاتِهِ، وَصِفَاتِهِ، وَأَفْعَالِهِ."],[1,9,1,"مَّوَدَّةً","مَحَبَّةً."],[2,14,1,"تَبَرُّوهُمْ","تُكْرِمُوهُمْ."],[2,15,1,"وَتُقْسِطُوا","تَعْدِلُوا فِيهِمْ."],[2,20,1,"الْمُقْسِطِينَ","العَادِلِينَ."],[3,11,1,"وَظَاهَرُوا","عَاوَنُوا."],[3,14,2,"أَن تَوَلَّوْهُمْ","أَنْ تَنْصُرُوهُمْ، وَتَوَدُّوهُمْ."],[4,7,1,"فَامْتَحِنُوهُنَّ","فَاخْتَبِرُوهُنَّ؛ لِتَعْلَمُوا صِدْقَ إِيمَانِهِنَّ."],[4,26,3,"وَآتُوهُم مَّا أَنفَقُوا","وَأَعْطُوا أَزْوَاجَ اللَّاتِي أَسْلَمْنَ مِثْلَ مَا أَنْفَقُوا عَلَيْهِنَّ مِنَ المُهُورِ."],[4,30,1,"جُنَاحَ","إِثْمَ."],[4,36,1,"أُجُورَهُنَّ","مُهُورَهُنَّ."],[4,39,2,"بِعِصَمِ الْكَوَافِرِ","بِعُقُودِ نِكَاحِ زَوْجَاتِكُمُ الكَافِرَاتِ."],[4,41,3,"وَاسْأَلُوا مَا أَنفَقْتُمْ","وَاطْلُبُوا مِنَ المُشْرِكِينَ مُهُورَ نِسَائِكُمُ المُرْتَدَّاتِ اللَّوَاتِي لَحِقْنَ بِهِمْ."],[5,0,5,"وَإِن فَاتَكُمْ شَيْءٌ مِّنْ أَزْوَاجِكُمْ","انْفَلَتَتْ وَاحِدَةٌ بِرِدَّةٍ."],[5,7,1,"فَعَاقَبْتُمْ","فَظَفِرْتُمْ بِالكُفَّارِ، وَغَنِمْتُمْ مِنْهُمْ."]]