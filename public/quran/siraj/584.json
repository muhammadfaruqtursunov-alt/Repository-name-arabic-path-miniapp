[[1,5,1,"تَزَكَّى","تَتَطَهَّرَ مِنَ الكُفْرِ، وَتَتَحَلَّى بِالإِيمَانِ."],[2,0,1,"وَأَهْدِيَكَ","أُرْشِدَكَ."],[3,1,2,"الْآيَةَ الْكُبْرَى","مُعْجِزَةَ العَصَا، وَاليَدَ البَيْضَاءَ."],[5,2,1,"يَسْعَى","يَجْتَهِدُ فِي مُعَارَضَةِ مُوسَى - عليه السلام -."],[6,0,1,"فَحَشَرَ","جَمَعَ أَهْلَ مَمْلَكَتِهِ."],[8,2,1,"نَكَالَ","عُقُوبَةَ."],[11,0,2,"رَفَعَ سَمْكَهَا","أَعْلَى سَقْفَهَا."],[12,0,2,"وَأَغْطَشَ لَيْلَهَا","أَظْلَمَ لَيْلَهَا بِغُرُوبِ شَمْسِهَا."],[12,2,2,"وَأَخْرَجَ ضُحَاهَا","أَبْرَزَ نَهَارَهَا بِشُرُوقِ شَمْسِهَا."],[13,3,1,"دَحَاهَا","بَسَطَهَا، وَأَوْدَعَ فِيهَا مَنَافِعَهَا."],[14,3,1,"وَمَرْعَاهَا","مَا يُرْعَى مِنَ النَّبَاتِ."],[15,1,1,"أَرْسَاهَا","أَثْبَتَهَا عَلَى الأَرْضِ؛ كَالْأَوْتَادِ."],[17,2,1,"الطَّامَّةُ","القِيَامَةُ، وَهِيَ النَّفْخَةُ الثَّانِيَةُ."],[19,0,1,"وَبُرِّزَتِ","أُظْهِرَتْ إِظْهَارًا بَيِّنًا."],[22,3,1,"الْمَاوَى","المَصِيرُ."],[23,3,2,"مَقَامَ رَبِّهِ","القِيَامَ بَيْنَ يَدَيْ رَبِّهِ لِلْحِسَابِ."],[25,3,2,"أَيَّانَ مُرْسَاهَا","مَتَى وَقْتُ حُلُولِهَا؟"],[26,0,4,"فِيمَ أَنتَ مِن ذِكْرَاهَا","لَيْسَ عِنْدَكَ عِلْمُهَا؛ حَتَّى تَذْكُرَهَا."],[29,6,1,"عَشِيَّةً","مَا بَيْنَ الظُّهْرِ إِلَى غُرُوبِ الشَّمْسِ."],[29,8,1,"ضُحَاهَا","مَا بَيْنَ طُلُوعِ الشَّمْسِ إِلَى نِصْفِ النَّهَارِ."]]