[[0,4,1,"وَالْمُؤْتَفِكَاتُ","أَهْلُ قُرَى قَوْمِ لُوطٍ الَّذِينَ انْقَلَبَتْ بِهِمْ دِيَارُهُمْ."],[0,5,1,"بِالْخَاطِئَةِ","بِالفَعَلَاتِ ذَاتِ الخَطَإِ الجَسِيمِ."],[1,5,1,"رَّابِيَةً","بَالِغَةً فِي الشِّدَّةِ."],[2,2,2,"طَغَى الْمَاءُ","جَاوَزَ المَاءُ حَدَّهُ، وَارْتَفَعَ فَوْقَ كُلِّ شَيْءٍ."],[2,6,1,"الْجَارِيَةِ","السَّفِينَةِ الَّتِي صَنَعَهَا نُوحٌ - عليه السلام -، تَجْرِي فِي المَاءِ."],[3,3,1,"وَتَعِيَهَا","تَحْفَظَهَا."],[4,3,1,"الصُّورِ","القَرْنِ الَّذِي يَنْفُخُ فِيهِ إِسْرَافِيلُ - عليه السلام -."],[4,4,2,"نَفْخَةٌ وَاحِدَةٌ","هِيَ: النَّفْخَةُ الأُولَى الَّتِي يَكُونُ بِهَا هَلَاكُ العَالَمِ."],[5,0,1,"وَحُمِلَتِ","رُفِعَتْ مِنْ أَمَاكِنِهَا."],[5,3,1,"فَدُكَّتَا","دُقَّتَا، وَكُسِّرَتَا."],[6,1,2,"وَقَعَتِ الْوَاقِعَةُ","قَامَتِ القِيَامَةُ."],[7,4,1,"وَاهِيَةٌ","ضَعِيفَةٌ، مُسْتَرْخِيَةٌ."],[8,0,1,"وَالْمَلَكُ","المَلَائِكَةُ."],[8,2,1,"أَرْجَائِهَا","جَوَانِبِهَا، وَأَطْرَافِهَا."],[9,1,1,"تُعْرَضُونَ","عَلَى اللهِ لِلْجَزَاءِ وَالحِسَابِ."],[10,6,1,"هَاؤُمُ","خُذُوا."],[11,1,1,"ظَنَنتُ","أَيْقَنْتُ."],[12,3,1,"رَّاضِيَةٍ","هَنِيْئَةٍ مَرْضِيَّةٍ."],[14,0,1,"قُطُوفُهَا","ثِمَارُهَا."],[14,1,1,"دَانِيَةٌ","قَرِيبَةٌ يَتَنَاوَلُهَا القَاعِدُ وَالمُضْطَجِعُ."],[15,2,1,"هَنِيئًا","غَيْرَ مُنْغَّصٍ، وَلَا مُكَدَّرٍ."],[15,4,1,"أَسْلَفْتُمْ","قَدَّمْتُمْ."],[17,2,2,"مَا حِسَابِيهْ","مَا جَزَائِي؟"],[18,1,2,"كَانَتِ الْقَاضِيَةَ","المَوْتَةَ القَاطِعَةَ لِأَمْرِي، وَلَمْ أُبْعَثْ."],[19,0,2,"مَا أَغْنَى","مَا نَفَعَنِي."],[20,0,2,"هَلَكَ عَنِّي","ذَهَبَ عَنِّي."],[20,2,1,"سُلْطَانِيهْ","حُجَّتِي، وَقُوَّتِي."],[21,1,1,"فَغُلُّوهُ","اجْمَعُوا يَدَيْهِ إِلَى عُنُقِهِ بِالأَغْلَالِ."],[22,2,1,"صَلُّوهُ","أَدْخِلُوهُ، وَأَحْرِقُوهُ بِهَا."],[23,3,1,"ذَرْعُهَا","طُولُهَا بِذِرَاعِ المَلَكِ."],[23,6,1,"فَاسْلُكُوهُ","فَأَدْخِلُوهُ فِيهَا."],[26,4,1,"حَمِيمٌ","قَرِيبٌ يَحْمِيهِ مِنَ العَذَابِ."]]