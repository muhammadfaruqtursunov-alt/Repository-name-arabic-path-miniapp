[[0,8,1,"وُدًّا","مَحَبَّةً فِي قُلُوبِ عِبَادِهِ."],[1,9,1,"لُّدًّا","شَدِيدِي الخُصُومَةِ بِالبَاطِلِ."],[2,4,1,"قَرْنٍ","أُمَّةٍ."],[2,6,1,"تُحِسُّ","تَرَى، وَتَجِدُ."],[2,13,1,"رِكْزًا","صَوْتًا خَفِيًّا."],[7,3,1,"اسْتَوَى","ارْتَفَعَ، وَعَلَا عَلى الْعَرْشِ، اسْتِوَاءً يَلِيقُ بِجَلَالِهِ وَعَظَمَتِهِ."],[8,11,1,"الثَّرَى","التُّرَابِ النَّدِيِّ؛ وَالمُرَادُ: الأَرَضُونَ السَّبْعُ؛ لِأَنَّهَا تَحْتَهُ."],[12,7,1,"آنَسْتُ","أَبْصَرْتُ."],[12,12,1,"بِقَبَسٍ","بِشُعْلَةٍ تَسْتَدْفِئُونَ بِهَا."],[12,17,1,"هُدًى","هَادِيًا يَدُلُّنَا الطَّرِيقَ."],[14,7,1,"الْمُقَدَّسِ","المُبَارَكِ المُطَهَّرِ."]]