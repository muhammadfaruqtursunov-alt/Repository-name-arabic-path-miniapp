[[0,1,2,"أَحْصَنَتْ فَرْجَهَا","حَفِظَتْهُ مِنَ الفَوَاحِشِ."],[0,3,1,"فَنَفَخْنَا","نَفَخَ جِبْرِيلُ - عليه السلام - فيِ جَيْبِ قَمِيصِهَا، فَوَصَلَتِ النَّفْخَةُ إِلَى رَحِمِهَا."],[0,5,2,"مِن رُّوحِنَا","مِنْ جِهَةِ رُوحِنَا، وَهُوَ: جِبْرِيلُ - عليه السلام -."],[0,4,1,"آيَةً","عَلَامَةً عَلَى قُدْرَةِ اللهِ."],[1,2,3,"أُمَّتُكُمْ أُمَّةً وَاحِدَةً","مِلَّتُكُمْ مِلَّةً وَاحِدَةً، وَهِيَ: الإِسْلَامُ."],[2,0,2,"وَتَقَطَّعُوا أَمْرَهُم","اخْتَلَفُوا عَلَى رُسُلِهِمْ، وَتَفَرَّقُوا."],[3,6,3,"فَلَا كُفْرَانَ لِسَعْيِهِ","فَلَا جُحُودَ لِعَمَلِهِ."],[4,0,1,"وَحَرَامٌ","مُمْتَنِعٌ."],[4,5,2,"لَا يَرْجِعُونَ","أَيْ: إِلَى الدُّنْيَا؛ لِيَسْتَدْرِكُوا مَا فَرَّطُوا فِيهِ."],[5,2,2,"فُتِحَتْ يَاجُوجُ","أَيْ: سَدُّ يَاجُوجَ."],[5,8,1,"حَدَبٍ","مُرْتَفِعٍ مِنَ الأَرْضِ."],[5,9,1,"يَنسِلُونَ","يُسْرِعُونَ."],[6,1,2,"الْوَعْدُ الْحَقُّ","يَوْمُ القِيَامَةِ."],[6,5,1,"شَاخِصَةٌ","مَفْتُوحَةٌ لَا تَكَادُ تَطْرِفُ."],[7,6,2,"حَصَبُ جَهَنَّمَ","وَقُودُهَا، وَحَطَبُهَا."],[7,10,1,"وَارِدُونَ","دَاخِلُونَ."],[9,2,1,"زَفِيرٌ","تَنَفُّسٌ شَدِيدٌ تَنْتَفِخُ مِنْهُ الضُّلُوعُ يَدُلُّ عَلَى شِدَّةِ عَذَابِهِمْ."]]