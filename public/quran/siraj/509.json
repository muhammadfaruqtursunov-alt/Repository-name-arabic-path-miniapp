[[0,17,1,"مَّرَضٌ","شَكٌّ، وَنِفَاقٌ."],[0,21,2,"الْمَغْشِيِّ عَلَيْهِ","المُغْمَى عَلَيْهِ مِنْ شِدَّةِ الخَوْفِ."],[1,4,2,"عَزَمَ الْأَمْرُ","وَجَبَ القِتَالُ."],[2,0,2,"فَهَلْ عَسَيْتُمْ","لَعَلَّكُمْ."],[2,3,1,"تَوَلَّيْتُمْ","أَعْرَضْتُمْ عَنِ الإِيمَانِ."],[4,3,1,"أَمْ","بَلْ."],[4,6,1,"أَقْفَالُهَا","مُغْلَقَةٌ؛ فَلَا تَفْهَمُ القُرْآنَ."],[5,2,3,"ارْتَدُّوا عَلَى أَدْبَارِهِم","رَجَعُوا كُفَّارًا."],[5,12,2,"سَوَّلَ لَهُمْ","زَيَّنَ لَهُمْ خَطَايَاهُمْ."],[5,14,2,"وَأَمْلَى لَهُمْ","مَدَّ لَهُمْ فِي الأَمِلِ."],[6,3,2,"لِلَّذِينَ كَرِهُوا","هُمُ اليَهُودُ."],[6,14,1,"إِسْرَارَهُمْ","مَا يُخْفُونَهُ، وَيُسِرُّونَهُ."],[8,8,2,"فَأَحْبَطَ أَعْمَالَهُمْ","أَبْطَلَ ثَوَابَ أَعْمَالِهِمْ."],[9,0,2,"أَمْ حَسِبَ","بَلْ ظَنَّ."],[9,5,1,"مَّرَضٌ","نِفَاقٌ، وَشَكٌّ."],[9,10,1,"أَضْغَانَهُمْ","أَحْقَادَهُمْ."]]