[[2,1,1,"حِجَابٌ","حَاجِزٌ، وَهُوَ سُورٌ بَيْنَهُمَا، يُقَالُ لَهٌ: (الأَعْرَافُ)."],[2,7,1,"بِسِيمَاهُمْ","بِعَلَامَاتِهِمْ."],[2,17,1,"يَطْمَعُونَ","يَرْجُونَ دُخُولَهَا."],[3,3,1,"تِلْقَاءَ","جِهَةَ."],[4,1,2,"أَصْحَابُ الأَعْرَافِ","مَنِ اسْتَوَتْ حَسَنَاتُهُمْ وَسَيِّئَاتُهُمْ."],[7,5,1,"وَغَرَّتْهُمُ","خَدَعَتْهُمْ."]]