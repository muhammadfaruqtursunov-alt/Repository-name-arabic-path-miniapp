[[0,6,1,"بَاطِلًا","عَبَثًا وَلَهْوًا."],[0,11,1,"فَوَيْلٌ","فَهَلَاكٌ."],[3,6,1,"أَوَّابٌ","كَثِيرُ الرُّجُوعِ إِلَى اللِه بِالتَّوْبَةِ، وَالطَّاعَةِ."],[4,3,1,"بِالْعَشِيِّ","عَصْرًا."],[4,4,1,"الصَّافِنَاتُ","الخُيُولُ الوَاقِفَةُ عَلَى ثَلَاثِ قَوَائِمَ، وَتَرْفَعُ الرَّابِعَةَ؛ لِنَجَابَتِهَا وَخِفَّتِهَا."],[4,5,1,"الْجِيَادُ","الخُيُولُ الأَصِيلَةُ السَّرِيعَةُ."],[5,2,3,"أَحْبَبْتُ حُبَّ الْخَيْرِ","آثَرْتُ حُبَّ المَالِ."],[5,9,2,"تَوَارَتْ بِالْحِجَابِ","غَابَتِ الشَّمْسُ، أَوْ غَابَتِ الخَيْلُ عَنْ عَيْنِهِ."],[6,2,1,"فَطَفِقَ","شَرَعَ."],[6,3,3,"مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ","يَمْسَحُ سِيقَانَهَا وَأَعْنَاقَهَا، أَوْ يَقْطَعُهَا بِالسَّيْفِ تَقَرُّبًا إِلَى اللهِ."],[7,1,1,"فَتَنَّا","ابْتَلَيْنَا."],[7,6,1,"جَسَدًا","شِقَّ إِنْسَانٍ وُلِدَ لَهُ."],[7,8,1,"أَنَابَ","رَجَعَ إِلَى اللهِ بِالتَّوْبَةِ."],[9,5,1,"رُخَاءً","لَيِّنَةً طَيِّعَةً."],[9,6,2,"حَيْثُ أَصَابَ","حَيْثُ أَرَادَ."],[11,1,1,"مُقَرَّنِينَ","مُوثَقِينَ."],[11,3,1,"الْأَصْفَادِ","الأَغْلَالِ."],[12,2,1,"فَامْنُنْ","أَعْطِ مَنْ شَئْتَ."],[13,3,1,"لَزُلْفَى","لَقُرْبَى وَكَرَامَةً."],[13,4,2,"وَحُسْنَ مَآبٍ","حُسْنَ مَرْجِعٍ فِي الآخِرَةِ."],[14,9,1,"بِنُصْبٍ","مَشَقَّةٍ، وَتَعَبٍ."],[14,10,1,"وَعَذَابٍ","أَلَمٍ فِي جَسَدِيِ، وَمَالِي، وَأَهْلِي."],[15,0,2,"ارْكُضْ بِرِجْلِكَ","اضْرِبْ بِرِجْلِكَ الأَرْضَ لِيَنْبُعَ لَكَ المَاءُ."],[15,3,2,"مُغْتَسَلٌ بَارِدٌ","مَاءٌ تَغْتَسِلُ بِهِ، فِيهِ شِفَاؤُكَ."]]