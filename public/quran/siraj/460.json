[[5,3,3,"ظُلَلٌ مِّنَ النَّارِ","أَطْبَاقٌ مِنْ عَذَابِ النَّارِ كَهَيْئَةِ الظُّلَلِ المَبْنِيَّةِ."],[6,2,1,"الطَّاغُوتَ","المُعْبُودَاتِ مِنْ دُونِ اللهِ؛ مِنَ الأَوْثَانِ وَالشَّيَاطِينِ."],[6,5,1,"وَأَنَابُوا","رَجَعُوا إِلَى اللهِ بِالتَّوْبَةِ، وَالطَّاعَةِ."],[6,9,1,"الْبُشْرَى","الذِّكْرُ الحَسَنُ، وَالتَّوْفِيقُ فيِ الدُّنْيَا، وَالجَنَّةُ فيِ الآخِرَةِ."],[7,11,2,"أُوْلُوا الْأَلْبَابِ","أَصْحَابُ العُقُولِ السَّدِيدَةِ."],[8,1,2,"حَقَّ عَلَيْهِ","وَجَبَ عَلَيْهِ."],[9,5,1,"غُرَفٌ","مَنَازِلُ رَفِيعَةٌ عَالِيَةٌ فِي الجَنَّةِ."],[10,8,2,"فَسَلَكَهُ يَنَابِيعَ","أَدْخَلَهُ فِي عُيُونٍ وَمَجَارٍ."],[10,19,1,"يَهِيجُ","يَيْبَسُ."],[10,24,1,"حُطَامًا","مُتَكَسِّرًا مُتَفَتِّتًا."],[10,29,2,"لِأُوْلِي الْأَلْبَابِ","لِأَصْحَابِ العُقُولِ السَّلِيمَةِ."]]