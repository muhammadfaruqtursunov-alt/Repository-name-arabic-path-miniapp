[[1,5,1,"شِيَعًا","فِرَقًا، وَأَحْزَابًا."],[3,8,1,"قِيَمًا","قَائِمًا بِأَمْرِ الدُّنْيَا وَالآخِرَةِ."],[3,11,1,"حَنِيفًا","مَائِلًا عَنِ الشِّرْكِ إِلَى التَّوْحِيدِ."],[4,3,1,"وَنُسُكِي","ذَبْحِي."],[6,10,1,"تَكْسِبُ","تَعْمَلُ سَيِّئًا."],[6,15,2,"وَلَا تَزِرُ","لَا تَحْمِلُ."],[6,17,1,"وَازِرَةٌ","نَفْسٌ آثِمَةٌ."],[6,18,1,"وِزْرَ","إِثْمَ."],[7,3,2,"خَلَائِفَ الأَرْضِ","تُخْلُفُونَ مَنْ سَبَقَكُمْ."],[7,10,1,"لِّيَبْلُوَكُمْ","لِيْخْتَبِركُمْ."]]