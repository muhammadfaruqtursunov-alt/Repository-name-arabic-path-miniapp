[[0,0,1,"فَتَعَالَى","فَتَنَزَّهَ، وَارْتَفَعَ، وَتَقَدَّسَ عَنْ كُلِّ نَقْصٍ."],[1,1,1,"عَهِدْنَا","وَصَّيْنَا."],[1,10,1,"عَزْمًا","حِفْظًا لِمَا أُمِرَ بِهِ."],[4,5,2,"وَلَا تَعْرَى","لَا يُصِيبُكَ العُرْيُ."],[5,4,2,"وَلَا تَضْحَى","لَا يُصِيبُكَ حَرُّ الشَّمْسِ."],[6,11,2,"لَّا يَبْلَى","لَا يَنْقَضِي، وَلَا يَنْقَطِعُ."],[7,4,1,"سَوْآتُهُمَا","عَوْرَاتُهُمَا."],[7,5,1,"وَطَفِقَا","أَخَذَا."],[7,6,1,"يَخْصِفَانِ","يُلْصِقَانِ."],[8,1,1,"اجْتَبَاهُ","اصْطَفَاهُ."],[10,7,1,"ضَنْكًا","ضَيِّقَةً شَاقَّةً."]]