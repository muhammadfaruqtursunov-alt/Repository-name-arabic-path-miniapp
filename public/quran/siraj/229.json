[[0,2,1,"أَرَأَيْتُمْ","أَخْبِرُونِي."],[0,21,1,"تَخْسِيرٍ","تَضْلِيلٍ، وَإِبْعَادٍ عَنِ الخَيْرِ."],[1,5,1,"آيَةً","عَلَامَةً عَلَى صِدْقِي."],[1,13,1,"بِسُوءٍ","بِنَحْرٍ أَوْ ضَرْبٍ."],[2,0,1,"فَعَقَرُوهَا","فَنَحَرُوهَا."],[2,2,3,"تَمَتَّعُوا فِي دَارِكُمْ","اسْتَمْتِعُوا بِحَيَاتِكُمْ فِي بَلَدِكُمْ."],[3,11,2,"خِزْيِ يَوْمِئِذٍ","هَوَانِ ذَلِكَ اليَوْمِ، وَذِلَّتِهِ."],[4,3,1,"الصَّيْحَةُ","صَوْتٌ عَظِيمٌ مُهْلِكٌ مِنَ السَّمَاءِ."],[4,7,1,"جَاثِمِينَ","هَامِدِينَ، سَاقِطِينَ عَلَى وُجُوهِهِمْ."],[5,1,2,"لَّمْ يَغْنَوْا","لَمْ يَعِيشُوا، وَيُقِيمُوا."],[5,10,1,"بُعْدًا","هَلَاكًا، وَطَرْدًا."],[6,14,1,"حَنِيذٍ","مَشْوِيٍّ بِالحِجَارَةِ المُحْمَاةِ."],[7,6,1,"نَكِرَهُمْ","أَنْكَرَ ذَلِكَ مِنْهُمْ."],[7,7,3,"وَأَوْجَسَ مِنْهُمْ خِيفَةً","أَحَسَّ فيِ نَفْسِهِ خَوْفًا مِنْهُمْ."],[8,5,2,"وَمِن وَرَاءِ","وَمِنْ بَعْدِ."]]