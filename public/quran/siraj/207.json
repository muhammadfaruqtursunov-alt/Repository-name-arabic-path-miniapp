[[0,4,2,"الَّذِينَ يَلُونَكُم","القَرِيبِينَ مِنْكُمْ."],[2,4,1,"مَّرَضٌ","شِكٌّ، وَنِفَاقٌ."],[2,6,1,"رِجْسًا","نِفَاقًا وَشَكًّا."],[3,3,1,"يُفْتَنُونَ","يُبْتَلَوْنَ بِالقَحْطِ وَالشِّدَّةِ، وَإِظْهَارِ مَا يُبْطِنُونَهُ مِنَ النِّفَاقِ."],[5,5,1,"عَزِيزٌ","صَعْبٌ، وَشَاقٌّ عَلَيْهِ."],[5,7,2,"مَا عَنِتُّمْ","عَنَتُكُمْ، وَمَشَقَّتُكُمْ."],[6,3,1,"حَسْبِيَ","كَافِيَّ."]]