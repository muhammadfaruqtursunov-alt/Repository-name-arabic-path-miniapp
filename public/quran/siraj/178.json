[[0,10,1,"مُرْدِفِينَ","يَتْبَعُ بَعْضُهُمْ بَعْضًا."],[2,1,1,"يُغَشِّيكُمُ","يُلْقِي النُّعَاسَ عَلَيْكُمْ؛ كَالْغِطَاءِ."],[2,3,1,"أَمَنَةً","أَمَانًا."],[2,14,2,"رِجْزَ الشَّيْطَانِ","وَسَاوِسَهُ وَتَخْوِيفَاتِهِ."],[2,16,1,"وَلِيَرْبِطَ","لِيَشُدَّ."],[3,22,1,"بَنَانٍ","طَرَفٍ، وَمِفْصَلٍ."],[6,7,1,"زَحْفًا","مُتَقَارِبِينَ مِنْكُمْ، مُجْتَمِعِينَ؛ كَأَنَّهُمْ لِكَثْرَتِهِمْ يَزْحَفُونَ."],[6,10,1,"الأَدْبَارَ","الظُّهُورَ."],[7,5,2,"مُتَحَرِّفًا لِّقِتَالٍ","مُظْهِرًا الْفِرَارَ؛ خِدْعَةً، ثُمَّ يَكُرُّ."],[7,8,3,"مُتَحَيِّزًا إِلَى فِئَةٍ","مُنْحَازًا إِلَى جَمَاعَةِ المُسْلِمِينَ؛ سَوَاءٌ كَانُوا سَرِيَّةً فَانْحَازُوا لِلجَيْشِ أَوِ انْحَازُوا لِلإِمَامِ الأَعْظَمِ."],[7,12,1,"بَاءَ","رَجَعَ."],[7,19,1,"الْمَصِيرُ","الْمَرْجِعُ، وَالْمَآلُ."]]