[[1,6,1,"لَمَدِينُونَ","لَمَجْزِيُّونَ، وَمُحَاسَبُونَ."],[4,2,2,"إِنْ كِدتَّ","إِنَّكَ قَارَبْتَ."],[4,4,1,"لَتُرْدِينِ","لَتُهْلِكُنِي بِضَلَالِكَ، وَإِغْوَائِكَ."],[5,5,1,"الْمُحْضَرِينَ","مَنْ أُحْضِرُوا فِي العَذَابِ مَعَكَ."],[10,2,1,"نُّزُلًا","ضِيَافَةً."],[10,4,2,"شَجَرَةُ الزَّقُّومِ","شَجَرَةٌ خَبِيثَةٌ، مَلْعُونَةٌ، مِنْ طَعَامِ أَهْلِ النَّارِ."],[11,2,1,"فِتْنَةً","ابْتِلَاءً لَهُمْ؛ حَيْثُ كَذَّبُوا بِوُجُودِ شَجَرَةٍ فيِ النَّارِ."],[12,4,2,"أَصْلِ الْجَحِيمِ","قَعْرِ جَهَنَّمَ."],[13,0,1,"طَلْعُهَا","ثَمَرُهَا."],[15,4,1,"لَشَوْبًا","لَخَلْطًا، وَمِزَاجًا."],[15,6,1,"حَمِيمٍ","مِنْ مَاءٍ حَارٍّ بَالِغِ الحَرَارَةِ."],[17,1,1,"أَلْفَوْا","وَجَدُوا."],[18,3,1,"يُهْرَعُونَ","يُسْرِعُونَ فِي مُتَابَعَتِهِمْ عَلَى الضَّلَالِ."]]