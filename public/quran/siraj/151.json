[[1,7,1,"حَرَجٌ","شَكٌّ، وَضِيقٌ مِنْ تَبْلِيغِهِ."],[3,5,1,"بَاسُنَا","عَذَابُنَا."],[3,6,1,"بَيَاتًا","نَائِمِينَ لَيْلًا."],[3,9,1,"قَائِلُونَ","نَائِمُونَ فِي نِصْفِ النَّهَارِ."],[7,0,1,"وَالْوَزْنُ","وَزْنُ أَعْمَالِ العِبَادِ."],[7,2,1,"الْحَقُّ","العَدْلُ."],[9,1,1,"مَكَّنَّاكُمْ","مَكَّنَّا لَكُمْ فِيهَا، وَجَعَلْنَاهَا لَكُمْ قَرَارًا."],[9,7,1,"مَعَايِشَ","مَا تَعِيشُونَ بِهِ."]]