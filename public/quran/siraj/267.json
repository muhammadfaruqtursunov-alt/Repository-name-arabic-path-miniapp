[[0,3,1,"عِضِينَ","أَجْزَاءَ، فَقَالَ بَعْضُهُمْ: سِحْرٌ، وَقَالَ بَعْضُهُمْ: كِهَانَةٌ، وَغَيْرَ ذَلِكَ."],[3,0,1,"فَاصْدَعْ","فَاجْهَرْ."],[7,5,1,"السَّاجِدِينَ","العَابِدِينَ، المُصَلِّينَ."],[8,4,1,"الْيَقِينُ","المَوْتُ."],[9,1,2,"أَمْرُ اللهِ","قِيَامُ السَّاعَةِ."],[10,2,1,"بِالْرُّوحِ","بِالوَحْيِ."],[12,6,1,"خَصِيمٌ","شَدِيدُ الخُصُومَةِ."],[14,4,1,"تُرِيحُونَ","تَرُدُّونَهَا إِلَى مَبَارِكِهَا وَحَظَائِرِهَا فِي المَسَاءِ."],[14,6,1,"تَسْرَحُونَ","تُخْرِجُونَهَا لِلْمَرْعَى فِي الصَّبَاحِ."]]