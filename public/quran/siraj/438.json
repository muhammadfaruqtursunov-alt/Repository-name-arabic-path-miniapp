[[0,8,3,"لِّمَا بَيْنَ يَدَيْهِ","مِنَ الكُتُبِ السَّابِقَةِ."],[1,1,1,"أَوْرَثْنَا","أَعْطَيْنَا."],[1,8,2,"ظَالِمٌ لِّنَفْسِهِ","بِفِعْلِ بَعْضِ المَعَاصِي."],[1,11,1,"مُّقْتَصِدٌ","يُؤَدِّي الوَاجِبَاتِ، ويَجْتَنِبُ المُحَرَّمَاتِ."],[1,13,2,"سَابِقٌ بِالْخَيْرَاتِ","مُجْتَهِدٌ فِي عَمَلِ الصَّالِحَاتِ: فَرْضِهَا وَنَفْلِهَا."],[2,1,1,"عَدْنٍ","إِقَامَةٍ."],[4,1,1,"أَحَلَّنَا","أَنْزَلَنَا."],[4,2,2,"دَارَ الْمُقَامَةِ","دَارَ الإِقَامَةِ الدَّائِمَةِ."],[4,9,1,"نَصَبٌ","تَعَبٌ، وَمَشَقَّةٌ."],[4,13,1,"لُغُوبٌ","إِعْيَاءٌ وَتَعَبٌ."],[6,1,1,"يَصْطَرِخُونَ","يَصِيحُونَ بِشِدَّةٍ، وَيَسْتَغِيثُونَ."],[6,19,1,"النَّذِيرُ","نَبِيُّنَا مُحَمَّدٌ - صلى الله عليه وسلم -."]]