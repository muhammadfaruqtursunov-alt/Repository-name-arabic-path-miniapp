[[0,1,1,"لِلْعُسْرَى","لِكُلِّ عُسْرٍ، وَشَقَاوَةٍ."],[1,0,2,"وَمَا يُغْنِي","لَا يَنْفَعُهُ."],[1,5,1,"تَرَدَّى","وَقَعَ فِي النَّارِ."],[2,0,3,"إِنَّ عَلَيْنَا لَلْهُدَى","عَلَيْنَا أَنْ نُبَيِّنَ طَرِيقَ الهُدَى؛ فَضْلًا مِنَّا وَرَحْمَةً."],[4,2,1,"تَلَظَّى","تَتَوَهَّجُ."],[5,0,2,"لَا يَصْلَاهَا","لَا يَدْخُلُهَا، وَيُقَاسِي حَرَّهَا."],[7,0,1,"وَسَيُجَنَّبُهَا","سَيُبْعَدُ عَنْهَا."],[9,5,1,"تُجْزَى","تُكَافَأُ؛ فَلَيْسَ إِنْفَاقُهُ مُكَافَأَةً لِمَنْ أَحْسَنَ إِلَيْهِ."],[12,0,1,"وَالضُّحَى","قَسَمٌ بِأَوَّلِ النَّهَارِ، أَوْ كُلِّهِ."],[13,2,1,"سَجَى","غَطَّى الكَوْنَ بِظَلَامِهِ، وَسَكَنَ."],[14,0,2,"مَا وَدَّعَكَ","مَا تَرَكَكَ."],[14,3,2,"وَمَا قَلَى","مَا أَبْغَضَكَ عِنْدَمَا أَبْطَأَ عَلَيْكَ الوَحْيَ."],[17,3,1,"فَآوَى","فَآوَاكَ، وَرَعَاكَ."],[18,1,1,"ضَالًّا","لَا تَدْرِي الوَحْيَ، وَلَا تَعْلَمُ القُرْآنَ."],[19,1,1,"عَائِلًا","فَقِيرًا."],[20,2,2,"فَلَا تَقْهَرْ","لَا تُسِئْ مُعَامَلَتَهُ، وَتَاخُذْ مَالَهُ."],[21,1,1,"السَّائِلَ","الفَقِيرَ الَّذِي يَسْأَلُ، وَطَالِبَ العِلْمِ."],[21,2,2,"فَلَا تَنْهَرْ","لَا تَزْجُرْ."],[23,0,2,"أَلَمْ نَشْرَحْ","قَدْ وَسَّعْنَا بِنُورِ الإِسْلَامِ بَعْدَ الحَيْرَةِ وَالضِّيقِ."],[24,0,1,"وَوَضَعْنَا","حَطَطْنَا، وَغَفَرْنَا."],[24,2,1,"وِزْرَكَ","ذَنْبَكَ."]]