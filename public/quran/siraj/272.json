[[1,1,1,"وَالزُّبُرِ","الكُتُبِ السَّمَاوِيَّةِ."],[2,2,2,"مَكَرُوا السَّيِّئَاتِ","دَبَّرُوا المَكَايِدَ."],[3,3,1,"تَقَلُّبِهِمْ","أَسْفَارِهِمْ، وَتَصَرُّفَاتِهِمْ."],[4,3,1,"تَخَوُّفٍ","حَالِ خَوْفٍ، وَنَقْصٍ فِي الأَمْوَالِ وَالأَنْفُسِ."],[5,8,1,"يَتَفَيَّأُ","يَمِيلُ."],[5,16,1,"دَاخِرُونَ","خَاضِعُونَ لِعَظَمَةِ اللهِ."],[8,11,1,"فَارْهَبُونِ","فَخَافُونِي."],[9,5,2,"وَلَهُ الدِّينُ","لَهُ العِبَادَةُ وَالطَّاعَةُ وَحْدَهُ."],[9,7,1,"وَاصِبًا","دَائِمًا."],[10,11,1,"تَجْأَرُونَ","تَضِجُّونَ بِالدُّعَاءِ."]]