[[0,1,1,"وَصَّلْنَا","فَصَّلْنَا وَبَيَّنَّا."],[3,3,1,"مَّرَّتَيْنِ","لِإِيمَانِهِمْ بِكِتَابِهِمْ وَبِالقُرْآنِ."],[3,6,1,"وَيَدْرَؤُونَ","يَدْفَعُونَ."],[4,2,1,"اللَّغْوَ","البَاطِلَ."],[4,3,2,"أَعْرَضُوا عَنْهُ","لَمْ يُصْغُوا إِلَيْهِ."],[4,10,2,"سَلَامٌ عَلَيْكُمْ","لَا تَسْمَعُونَ مِنَّا إِلَّا الخَيْرَ؛ قَدْ سَلِمْتُمْ مِنَّا."],[4,12,3,"لَا نَبْتَغِي الْجَاهِلِينَ","لَا نُرِيدُ طَرِيقَةَ الغَافِلينَ عَنِ الحَلَمَةِ وَالحِلْمِ."],[6,5,1,"نُتَخَطَّفْ","نُنْتَزَعْ بِسُرْعَةٍ بِالقَتْلِ، وَالأَسْرِ."],[6,13,1,"يُجْبَى","يُجْلَبُ إِلَيْهِ."],[7,0,1,"وَكَمْ","كَثِيرًا!"],[7,4,2,"بَطِرَتْ مَعِيشَتَهَا","طَغَتْ وَتَمَرَّدَتْ فِي حَيَاتِهَا."],[8,8,1,"أُمِّهَا","أَعْظَمِهَا، وَهِيَ مَكَّةُ."]]