[[0,3,3,"لَّا رَيْبَ فِيهَا","لَا شَكَّ فِيهَا."],[1,12,1,"دَاخِرِينَ","صَاغِرِينَ، حَقِيرِينَ."],[2,5,1,"لِتَسْكُنُوا","لِتَرْتَاحُوا."],[2,8,1,"مُبْصِرًا","مُضِيئًا."],[2,-1,0,"فَأَنَّى تُؤْفَكُونَ","كَيْفَ تُصْرَفُونَ عَنِ الإِيمَانِ بِهِ؟!"],[4,1,1,"يُؤْفَكُ","يُصْرَفُ."],[5,17,1,"فَتَبَارَكَ","تَكَاثَرَ خَيْرُهُ وَفَضْلُهُ."],[7,16,2,"أَنْ أُسْلِمَ","أَنْ أَخْضَعَ وَأَنْقَادَ بِالطَّاعَةِ."]]