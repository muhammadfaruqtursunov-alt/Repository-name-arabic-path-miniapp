[[1,6,1,"الْقَيُّومُ","القَائِمُ عَلَى كُلِّ شَيءٍ."],[3,15,1,"عَزِيزٌ","غَالِبٌ، قَوِيٌّ لَا يُغَالَبُ."],[6,7,1,"مُّحْكَمَاتٌ","وَاضِحَاتُ الدَّلَالَةِ."],[6,9,2,"أُمُّ الْكِتَابِ","أَصْلُ الكِتَابِ الَّذِي يُرْجَعُ إِلَيْهِ عِنْدَ الاِشْتِبَاهِ."],[6,12,1,"مُتَشَابِهَاتٌ","خَفِيَّاتٌ، لَا يَتَعَيَّنُ المُرَادُ مِنْهَا إِلَّا بِرَدِّهَا إِلَى المُحْكَمَاتِ."],[6,17,1,"زَيْغٌ","مَرَضٌ، وانْحِرَافٌ."],[6,22,1,"ابْتِغَاءَ","طَلَبَ تَفْسِيرِه عَلَى مَذَاهِبِهِمِ المُنْحَرِفَةِ."],[6,25,1,"تَاوِيلِهِ","تَفْسِيرِهِ أَوْ مَعْرِفَةِ حَقِيقَتِهِ."],[6,45,1,"الألْبَابِ","العُقُولِ السَّلِيمَةِ."]]