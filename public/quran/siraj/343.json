[[0,4,1,"بِقَدَرٍ","بِمِقْدَارِ حَاجَةِ الخَلْقِ."],[2,0,1,"وَشَجَرَةً","هِيَ شَجَرَةُ الزَّيْتُونِ."],[2,6,1,"بِالدُّهْنِ","بِالزَّيْتِ."],[2,7,1,"وَصِبْغٍ","إِدَامٍ يُغْمَسُ فِيهِ الخُبْزُ."],[4,2,1,"الْفُلْكِ","السُّفُنِ."],[7,5,1,"جِنَّةٌ","مَسٌّ مِنَ الجُنُونِ."],[9,5,1,"بِأَعْيُنِنَا","بِحِفْظِنَا وَكَلَاءَتِنَا؛ وَفِيهِ إِثْبَاتُ صِفَةِ العَيْنِ لِلهِ عَلَى الوَجْهِ اللَّائِقِ بِهِ."],[9,10,2,"وَفَارَ التَّنُّورُ","نَبَعَ المَاءُ مِنَ التَّنُّورِ المَعْرُوفِ."],[9,12,2,"فَاسْلُكْ فِيهَا","فَأَدْخِلْ فِيهَا."],[9,21,3,"سَبَقَ عَلَيْهِ الْقَوْلُ","اسْتَحَقَّ العَذَابَ."]]