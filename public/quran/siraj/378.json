[[0,5,1,"وَعُلُوًّا","تَكَبُّرًا."],[2,0,3,"وَوَرِثَ سُلَيْمَانُ دَاوُودَ","خَلَفَ سُلَيْمَانُ أَبَاهُ فِي النُّبُوَّةِ، وَالعِلْمِ، وَالمُلْكِ."],[3,0,1,"وَحُشِرَ","جُمِعَ."],[3,8,1,"يُوزَعُونَ","يُرَدُّ أَوَّلُ كُلِّ جِنْسٍ عَلَى آخِرِهِمْ لِيَقِفُوا جَمِيعًا مُنْتَظِمِينَ."],[4,12,2,"لَا يَحْطِمَنَّكُمْ","لَا يُهْلِكَنَّكُمْ."],[5,6,1,"أَوْزِعْنِي","أَلْهِمْنِي."],[7,7,2,"بِسُلْطَانٍ مُّبِينٍ","حُجَّةٍ ظَاهِرَةٍ."],[8,0,3,"فَمَكَثَ غَيْرَ بَعِيدٍ","بَقِيَ زَمَنًا غَيْرَ طَوِيلٍ."],[8,11,1,"سَبَإٍ","مَدِينَةٍ بِاليَمَنِ."],[8,12,1,"بِنَبَإٍ","خَبَرٍ خَطِيرٍ."]]