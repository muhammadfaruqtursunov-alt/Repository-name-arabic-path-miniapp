[[1,5,2,"مَدَّ الظِّلَّ","بَسَطَهُ مِنْ طُلُوعِ الفَجْرِ إِلَى طُلُوعِ الشَّمْسِ."],[1,10,1,"سَاكِنًا","ثَابِتًا مُسْتَقِرًّا."],[3,5,1,"لِبَاسًا","سَاتِرًا لَكُمْ بِظَلَامِهِ."],[3,7,1,"سُبَاتًا","رَاحَةً لِأَبْدَانِكُمْ."],[3,10,1,"نُشُورًا","وَقْتًا لِلِانْتِشَارِ وَالسَّعْيِ فيِ الأَرْضِ."],[4,4,1,"بُشْرًا","مُبَشِّرَاتٍ بِالرَّحْمَةِ، وَهِيَ المَطَرُ."],[6,1,1,"صَرَّفْنَاهُ","أَنْزَلْنَا المَطَرَ عَلَى أَرْضٍ دُونَ أُخْرَى."],[8,3,2,"وَجَاهِدْهُم بِهِ","بَلِّغْهُمُ القُرْآنَ بَاذِلًا وُسْعَكَ."],[8,5,2,"جِهَادًا كَبِيرًا","لَا يُخِالِطُهُ فُتُورٌ."],[9,2,1,"مَرَجَ","خَلَطَ."],[9,6,1,"فُرَاتٌ","شَدِيدُ العُذُوبَةِ."],[9,9,1,"أُجَاجٌ","شَدِيدُ المُلُوحَةِ."],[9,12,1,"بَرْزَخًا","حَاجِزًا يَمْنَعُ إِفْسَادَ أَحَدِهِمَا لِلآخَرِ."],[9,13,2,"وَحِجْرًا مَّحْجُورًا","سِتْرًا يَمْنَعُ وُصُولَ أَحَدِهِمَا إِلَى الآخَرِ."],[10,4,1,"الْمَاءِ","مَنِيِّ الرَّجُلِ وَالمَرْأَةِ."],[10,7,1,"نَسَبًا","قَرَابَةَ النَّسَبِ."],[10,8,1,"وَصِهْرًا","قَرَابَةَ المُصَاهَرَةِ."],[11,13,1,"ظَهِيرًا","مُعِينًا لِلشَّيْطَانِ عَلَى رَبِّهِ؛ بِالشِّرْكِ، مُظَاهِرًا لَهُ فيِ المَعْصِيَةِ."]]