[[0,4,2,"فِي شُغُلٍ","مَشْغُولُونَ بِالنَّعِيمِ عَمَّا سِوَاهُ."],[1,5,1,"الْأَرَائِكِ","الأَسِرَّةِ المُزَيَّنَةِ."],[4,0,1,"وَامْتَازُوا","تَمَيَّزُوا وَانْفَصِلُوا عَنِ المُؤْمِنِينَ."],[6,2,3,"هَذَا صِرَاطٌ مُّسْتَقِيمٌ","عِبَادَتِي وَمَعْصِيَةُ الشَّيْطَانِ طَرِيقٌ قَوِيمٌ."],[7,3,1,"جِبِلًّا","خَلْقًا."],[10,1,1,"نَخْتِمُ","نَطْبَعُ."],[11,5,2,"فَاسْتَبَقُوا الصِّرَاطَ","بَادَرُوا إِلَى الطَّرِيقِ؛ لِيَجْتَازُوهُ."],[12,2,1,"لَمَسَخْنَاهُمْ","لَغَيَّرْنَا خَلْقَهُمْ."],[12,4,1,"مَكَانَتِهِمْ","أَمَاكِنِهِمْ."],[12,7,1,"مُضِيًّا","أَنْ يَمْضُوا أَمَامَهُمْ."],[13,1,1,"نُعَمِّرْهُ","نُطِلْ عُمُرَهُ."],[13,2,3,"نُنَكِّسْهُ فِي الْخَلْقِ","نُعِدْهُ إِلَى الحَالَةِ الَّتِي ابْتَدَأَهَا؛ وَهِيَ الضَّعْفُ."]]