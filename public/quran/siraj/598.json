[[0,3,1,"وَتَوَلَّى","أَعْرَضَ عَنِ الإِيمَانِ."],[2,4,1,"لَنَسْفَعًا","لَنَاخُذَنْهُ أَخْذًا عَنِيفًا فَنَطْرَحُهُ فِي النَّارِ."],[2,5,1,"بِالنَّاصِيَةِ","بِمُقَدَّمِ رَاسِهِ."],[3,2,1,"خَاطِئَةٍ","آثِمَةٍ."],[4,0,1,"فَلْيَدْعُ","فَلْيُحْضِرْ، وَلْيُنَادِ."],[4,1,1,"نَادِيَه","أَهْلَ مَجْلِسِهِ مِنْ قَوْمِهِ، وَعَشِيرَتِهِ."],[5,1,1,"الزَّبَانِيَةَ","مَلَائِكَةَ العَذَابِ."],[6,0,1,"كَلَّا","لَيْسَ الأَمْرُ عَلَى مَا يَظُنُّ أَبُو جَهْلٍ."],[6,4,1,"وَاقْتَرِبْ","ادْنُ مِنْهُ بِالطَّاعَةِ."],[7,1,1,"أَنزَلْنَاهُ","أَنْزَلْنَا القَرْآنَ جُمْلَةً وَاحِدَةً مِنَ اللَّوْحِ المَحْفُوظِ إِلَى بَيْتِ العِزَّةِ فِي السَّمَاءِ الدُّنْيَا."],[7,3,2,"لَيْلَةِ الْقَدْرِ","لَيْلَةِ الشَّرَفِ، وَالعَظَمَةِ، وَكِتَابِ المَقَادِيرِ."],[10,2,1,"وَالرُّوحُ","جِبْرِيلُ - عليه السلام -."],[10,8,1,"أَمْرٍ","قَضَاءٍ قَدَّرَهُ اللهُ فِي تِلْكَ السَّنَةِ."],[11,0,1,"سَلَامٌ","أَمْنٌ، وَسَلَامَةٌ، وَتَسْلِيمٌ مِنَ المَلَائِكَةِ."],[12,8,1,"مُنفَكِّينَ","تَارِكِينَ كُفْرَهُمْ."],[12,11,1,"الْبَيِّنَةُ","العَلَامَةُ الَّتِي وُعِدُوا بِهَا فِي الكُتُبِ السَّابِقَةِ."],[13,0,3,"رَسُولٌ مِّنَ اللَّهِ","أَيْ: وَالبَيِّنَةُ رَسُولٌ مِنَ اللهِ."],[13,3,1,"يَتْلُو","يَقْرَأُ."],[14,-1,0,"مُّطَهَّرَةً","مُنَزَّهَةً مِنَ البَاطِلِ، مَحْفُوظَةً مِنَ الشَّيَاطِينِ."],[14,1,2,"كُتُبٌ قَيِّمَةٌ","أَخْبَارٌ صَادِقَةٌ، وَأَوَامِرُ عَادِلَةٌ."],[15,1,1,"تَفَرَّقَ","اخْتَلَفَ."],[15,3,2,"أُوتُوا الْكِتَابَ","اليَهُودُ وَالنَّصَارَى."],[15,10,1,"الْبَيِّنَةُ","مِنْ بَعْدِ مَا تَبَيَّنُوا أَنَّهُ نَبِيٌّ حَقًّا، تَفَرَّقُوا، وَكَانُوا مُجْتَمِعِينَ عَلَى صِحَّةِ نُبُوَّتِهِ قَبْلَ ذَلِكَ."],[16,5,1,"مُخْلِصِينَ","قَاصِدِينَ وَجْهَ اللهِ وَحْدَهُ."],[16,8,1,"حُنَفَاءَ","مَائِلِينَ عَنِ الشِّرْكِ إِلَى الإِيمَانِ."],[16,15,1,"الْقَيِّمَةِ","الاِسْتِقَامَةِ."]]