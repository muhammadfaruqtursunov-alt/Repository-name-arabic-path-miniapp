[[0,6,1,"جَرَحْتُم","اكْتَسَبْتُمْ."],[1,15,2,"لَا يُفَرِّطُونَ","لَا يُضَيِّعُونَ، وَلَا يُقَصِّرُونَ."],[3,8,1,"تَضَرُّعًا","مُظْهِرِينَ الضَّرَاعَةَ؛ وَهِيَ شِدَّةُ الفَقْرِ إِلَى الشَّيْءِ وَالحَاجَةِ."],[3,9,1,"وَخُفْيَةً","مُسِرِّينَ بِالدُّعَاءِ."],[5,15,2,"يَلْبِسَكُمْ شِيَعًا","يَخْلِطَكُمْ فِرَقًا مُتَنَاحِرَةً."],[5,23,1,"نُصَرِّفُ","نُنَوِّعُ."],[7,2,1,"مُّسْتَقَرٌّ","نِهَايَةٌ يعْرَفُ بِهَا أَحَقٌّ، أَمْ بَاطِلٌ."],[8,3,1,"يَخُوضُونَ","يَتَكَلَّمُونَ مَسْتَهْزِئِينَ."]]