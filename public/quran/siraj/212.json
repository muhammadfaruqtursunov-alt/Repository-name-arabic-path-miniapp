[[0,2,1,"الْحُسْنَى","الجَنَّةُ."],[0,3,1,"وَزِيَادَةٌ","زَائِدَةٌ عَلَى الجَنَّةِ وَهِيَ: النَّظَرُ إِلَى وَجْهِ اللهِ الكَرِيمِ."],[0,5,1,"يَرْهَقُ","يَغْشَى."],[0,7,1,"قَتَرٌ","غُبَارٌ."],[1,13,1,"عَاصِمٍ","مَانِع يَمْنَعُ عَذَابَ اللهِ."],[1,15,1,"أُغْشِيَتْ","أُلْبِسَتْ."],[2,7,1,"مَكَانَكُمْ","الْزَمُوا مَكَانَكُمْ."],[2,10,1,"فَزَيَّلْنَا","فَرَّقْنَا."],[4,1,1,"تَبْلُو","تُعَايِنُ، وَتَتَفَقَّدُ."],[4,10,1,"الْحَقُّ","اللهُ الَّذِي لَا رَيْبَ فِي رُبُوبِيَّتِهِ وَأُلُوهِيَّتِهِ."],[7,1,1,"حَقَّتْ","ثَبَتَتْ، وَوَجَبَتْ."]]