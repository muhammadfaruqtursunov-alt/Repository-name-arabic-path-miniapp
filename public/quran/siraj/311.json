[[0,0,1,"أَفَرَأَيْتَ","أَعَلِمْتَ؟"],[2,4,2,"وَنَمُدُّ لَهُ","نَزِيدُ لَهُ."],[4,7,1,"عِزًّا","شُفَعَاءَ، وَأَنْصَارًا."],[6,7,2,"تَؤُزُّهُمْ أَزًّا","تَدْفَعُهُمْ عَنِ الطَّاعَةِ، وَتُغْرِيهِمْ بِالمَعْصِيَةِ."],[8,1,1,"نَحْشُرُ","نَجْمَعُ."],[8,5,1,"وَفْدًا","وُفُودًا مُكْرَمِينَ عَلَى الرِّكَابِ وَالرَّوَاحِلِ."],[9,4,1,"وِرْدًا","مُشِاةً عِطَاشًا."],[12,3,1,"إِدًّا","شَيْئًا عَظِيمًا مُنْكَرًا."],[13,2,1,"يَتَفَطَّرْنَ","يَتَشَقَّقْنَ."],[13,6,3,"وَتَخِرُّ الْجِبَالُ هَدًّا","تَسْقُطُ سُقُوطًا شَدِيدًا."],[15,0,2,"وَمَا يَنبَغِي","مَا يَلِيقُ، وَمَا يَصْلُحُ."]]