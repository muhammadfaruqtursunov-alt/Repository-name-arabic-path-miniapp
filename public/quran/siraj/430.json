[[0,2,1,"لِسَبَإٍ","قَبِيلَةٍ بِاليَمَنِ سُمُّوا بِاسْمِ جَدِّهِمْ."],[0,5,1,"آيَةٌ","دَلَالَةٌ عَلَى قُدْرَتِنَا."],[0,6,1,"جَنَّتَانِ","بُسْتَانَانِ."],[0,16,2,"بَلْدَةٌ طَيِّبَةٌ","كَرِيمَةُ التُّرْبَةِ، طَيِّبَةُ الهَوَاءِ."],[1,3,2,"سَيْلَ الْعَرِمِ","السَّيْلَ الجَارِفَ الشَّدِيدَ الَّذِي خَرَّبَ السَّدَّ، وَأَغْرَقَ البَسَاتِينَ."],[1,8,1,"ذَوَاتَى","صَاحِبَتَيْ."],[1,9,2,"أُكُلٍ خَمْطٍ","ثَمَرٍ مُرٍّ، كَرِيهِ الطَّعْمِ."],[1,11,1,"وَأَثْلٍ","شَجَرٍ مَعْرُوفٍ شَبِيهٍ بِالطَّرْفَاءِ، لَا ثَمَرَ لَهُ."],[1,14,1,"سِدْرٍ","شَجَرِ النَّبَقِ، كَثِيرِ الشَّوْكِ."],[3,3,3,"الْقُرَى الَّتِي بَارَكْنَا","قُرَى الشَّامِ."],[3,7,2,"قُرًى ظَاهِرَةً","مُدُنًا مُتَّصِلَةً يُرَى بَعْضُهَا مِنْ بَعْضٍ."],[3,9,3,"وَقَدَّرْنَا فِيهَا السَّيْرَ","جَعَلْنَا السَّيْرَ بَيْنَهَا عَلَى مَرَاحِلَ مُتَقَارِبَةٍ."],[4,7,2,"فَجَعَلْنَاهُمْ أَحَادِيثَ","جَعَلْنَاهُمْ عِبَرًا وَأَحَادِيثَ لِمَنْ يَاتِي بَعْدَهُمْ."],[4,9,1,"وَمَزَّقْنَاهُمْ","فَرَّقْنَاهُمْ فيِ البِلَادِ."],[5,1,2,"صَدَّقَ عَلَيْهِمْ","حَقَّقَ عَلَيْهِمْ."],[6,5,1,"سُلْطَانٍ","قَهْرٍ عَلَى الكُفْرِ."],[7,9,2,"مِثْقَالَ ذَرَّةٍ","وَزْنَ نَمْلَةٍ صَغِيرَةٍ."],[7,20,1,"شِرْكٍ","شَرَاكَةٍ فِي الخَلْقِ."],[7,25,1,"ظَهِيرٍ","مُعِينٍ."]]