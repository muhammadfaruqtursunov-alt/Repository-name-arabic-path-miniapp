[[0,0,1,"تُرْجِي","تُؤَخِّرُ القَسْمَ فيِ المَبِيتِ، عَمَّنْ شِئْتَ مِنْ زَوْجَاتِكَ."],[0,2,1,"وَتُؤْوِي","تَضُمُّ فِي المَبِيتِ."],[0,9,1,"ابْتَغَيْتَ","طَلَبْتَ المَبِيتَ عِنْدَهَا."],[0,11,1,"عَزَلْتَ","أَخَّرْتَ قِسْمَهَا."],[0,16,1,"أَدْنَى","أَقْرَبُ."],[0,17,3,"أَن تَقَرَّ أَعْيُنُهُنَّ","أَنْ يَفْرَحْنَ."],[1,6,3,"وَلَا أَنْ تَبَدَّلَ","وَلَا أَنْ تُطَلِّقَ إِحْدَاهُنَّ لِتَسْتَبْدِلَ بِهَا غَيْرَها."],[1,24,1,"رَّقِيبًا","مُطَّلِعًا لَا يَغِيبُ عَنْ عِلْمِهِ شَيْءٌ."],[2,14,2,"نَاظِرِينَ إِنَاهُ","مُنْتَظِرِينَ نُضْجَهُ."],[2,40,1,"مَتَاعًا","حَاجَةً مِنْ أَوَانِي البَيْتِ، وَنَحْوِهَا."]]