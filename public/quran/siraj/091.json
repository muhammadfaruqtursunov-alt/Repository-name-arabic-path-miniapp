[[0,11,1,"حَفِيظًا","حَافِظًا، رَقِيبًا."],[1,6,2,"بَيَّتَ طَائِفَةٌ","دَبَّرَتْ بِلَيْلٍ."],[3,7,2,"أَذَاعُوا بِهِ","أَفْشَوْهُ."],[4,21,1,"تَنكِيلًا","عُقُوبَةً."],[5,14,1,"كِفْلٌ","نَصِيبٌ مِنْ وِزْرِهَا."],[5,21,1,"مُّقِيتًا","شَاهِدًا، وَحَفِيظًا."],[6,14,1,"حَسِيبًا","مُجَازِيًا، وَمُحَاسِبًا."]]