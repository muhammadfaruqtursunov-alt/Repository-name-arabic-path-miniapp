[[0,3,1,"الْغَرْبِيِّ","الجَبَلِ الغَرْبِيِّ مِنْ مُوسَى - عليه السلام -."],[0,5,1,"قَضَيْنَا","عَهِدْنَا."],[1,1,1,"أَنشَانَا","خَلَقْنَا."],[1,2,1,"قُرُونًا","أُمَمًا."],[1,3,3,"فَتَطَاوَلَ عَلَيْهِمُ الْعُمُرُ","فَمَكَثُوا زَمَنًا طَوِيلًا."],[1,8,1,"ثَاوِيًا","مُقِيمًا."],[1,10,2,"أَهْلِ مَدْيَنَ","هُمْ قُوْمُ شُعَيْبٍ - عليه السلام -."],[2,3,1,"الطُّورِ","جَبَلٍ بِسَيْنَاءَ كَلَّمَ اللهُ مُوسَى - عليه السلام - بِجَانِبِهِ."],[3,2,2,"تُصِيبَهُم مُّصِيبَةٌ","يَنْزِلَ بِهِمْ عَذَابٌ."],[4,20,2,"سِحْرَانِ تَظَاهَرَا","تَعَاوَنَا، يَقْصِدُونَ التَّوْرَاةَ وَالقُرْآنَ."]]