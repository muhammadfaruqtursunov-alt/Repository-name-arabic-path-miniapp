[[1,8,1,"مَرَدُوا","لَجُّوا فِيهِ، وَاسْتَمَرُّوا عَلَيْهِ، وَدَرَبُوا."],[3,5,2,"وَتُزَكِّيهِم بِهَا","تُرَفِّعُهُمْ بِهَا عَنْ مَنَازِلِ المُنَافِقِينَ."],[3,7,2,"وَصَلِّ عَلَيْهِمْ","ادْعُ لَهُمْ بِالمَغْفِرَةِ."],[3,11,2,"سَكَنٌ لَّهُمْ","رَحْمَةٌ، وَطُمَانِينَةٌ لَهُمْ."],[6,1,1,"مُرْجَوْنَ","مُؤَخَّرُونَ."]]