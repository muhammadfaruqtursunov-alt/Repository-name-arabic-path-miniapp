[[0,3,1,"بِالْإِفْكِ","أَشْنَعِ الكَذِبِ، وَهُوَ رَمْيُ أُمِّ المُؤْمِنِينَ عَائِشَةَ رَضِيَ اللهُ عَنْهَا بِالزِّنَى."],[0,4,2,"عُصْبَةٌ مِّنكُمْ","جَمَاعَةٌ مِنْكُمْ."],[0,22,2,"تَوَلَّى كِبْرَهُ","تَحَمَّلَ مُعْظَمَهُ."],[3,11,2,"أَفَضْتُمْ فِيهِ","خُضْتُمْ فِيهِ مِنْ حَدِيثِ الإِفْكِ."],[4,1,1,"تَلَقَّوْنَهُ","تَتَلَقَّفُونَهُ، وَتَنْقُلُونَهُ."],[5,12,1,"بُهْتَانٌ","كَذِبٌ."],[6,0,1,"يَعِظُكُمُ","يَنْهَاكُمْ."]]