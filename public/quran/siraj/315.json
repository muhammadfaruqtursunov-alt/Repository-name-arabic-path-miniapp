[[1,4,1,"مَهْدًا","مُيَسَّرَةً لِلِانْتِفَاعِ بِهَا."],[1,8,1,"سُبُلًا","طُرُقًا."],[1,15,1,"أَزْوَاجًا","أَنْوَاعًا مُخْتَلِفَةً."],[2,7,2,"لِّأُوْلِي النُّهَى","لِذَوِي العُقُولِ السَّلِيمَةِ."],[6,13,1,"سُوًى","مُسْتَوِيًا مُعْتَدِلًا."],[7,2,2,"يَوْمُ الزِّينَةِ","يَوْمُ العِيدِ."],[7,5,1,"يُحْشَرَ","يُجْمَعَ."],[8,3,1,"كَيْدَهُ","المُرَادُ: سَحَرَتُهُ الَّذِينَ يَكِيدُ بِهِمْ."],[9,4,2,"لَا تَفْتَرُوا","لَا تَخْتَلِقُوا."],[9,9,1,"فَيُسْحِتَكُمْ","فَيَسْتَاصِلَكُمْ."],[11,11,2,"بِطَرِيقَتِكُمُ الْمُثْلَى","طَرِيقَةِ السِّحْرِ العَظِيمَةِ."],[12,0,2,"فَأَجْمِعُوا كَيْدَكُمْ","فأَحْكِمُوا كَيْدَكُمْ، وَاعْزِمُوا عَلَيْهِ، وَلَا تَخْتَلِفُوا."]]