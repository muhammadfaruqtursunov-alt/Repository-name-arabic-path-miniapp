[[0,6,2,"بِالْغَدَاةِ وَالْعَشِيِّ","فِي الصَّبَاحِ وَالمَسَاءِ."],[0,10,3,"وَلَا تَعْدُ عَيْنَاكَ","لَا تَصْرِفْ نَظَرَكَ."],[0,29,1,"فُرُطًا","هَلَاكًا، وَضَيَاعًا."],[1,16,1,"سُرَادِقُهَا","سُورُهَا."],[1,21,1,"كَالْمُهْلِ","كَالزَّيْتِ العَكِرِ."],[1,26,2,"وَسَاءتْ مُرْتَفَقًا","قَبُحَتْ مَنْزِلًا وَمَقَامًا."],[3,3,1,"عَدْنٍ","إِقَامَةٍ."],[3,18,1,"سُندُسٍ","رَقِيقِ الحَرِيرِ."],[3,19,1,"وَإِسْتَبْرَقٍ","غَلِيظِ الحَرِيرِ."],[3,23,1,"الْأَرَائِكِ","الأَسِرَّةِ المُزَيَّنَةِ بِالسُّتُورِ الجَمِيلَةِ."],[4,6,1,"جَنَّتَيْنِ","حَدِيقَتَيْنِ."],[4,9,1,"وَحَفَفْنَاهُمَا","أَحَطْنَاهُمَا."],[5,2,2,"آتَتْ أُكُلَهَا","أَثْمَرَتْ ثَمَرَهَا."],[5,5,1,"تَظْلِمْ","تَنْقُصْ."],[5,9,1,"خِلَالَهُمَا","بَيْنَهُمَا."],[6,2,1,"ثَمَرٌ","ثِمَارٌ، وَأَمْوَالٌ أُخْرَى كَثِيرَةً."],[6,12,1,"نَفَرًا","أَنْصَارًا، وَأَعْوَانًا."]]