[[0,1,2,"لَا يَجْرِمَنَّكُمْ","لَا يَحْمِلَنَّكُمْ."],[0,3,1,"شِقَاقِي","عَدَاوَتِي."],[2,10,1,"ضَعِيفًا","لَسْتَ مِنَ الكُبَرَاءِ، وَلَا الرُّؤَسَاءِ."],[2,12,1,"رَهْطُكَ","عَشِيرَتُكَ."],[2,17,1,"بِعَزِيزٍ","بِصَاحِبِ قَدْرٍ وَمَنْزِلَةٍ."],[3,8,2,"وَرَاءَكُمْ ظِهْرِيًّا","مَنْبُوذًا خَلْفَ ظُهُورِكُمْ."],[4,3,1,"مَكَانَتِكُمْ","طَرِيقَتِكُمْ وَحَالَتِكُمْ."],[5,17,1,"جَاثِمِينَ","بَارِكِينَ عَلَى رُكَبِهِمْ مَيِّتِينَ."],[6,1,2,"لَّمْ يَغْنَوْا","لَمْ يُقِيمُوا."],[6,5,1,"بُعْدًا","هَلَاكًا، وإِبْعادًا."],[7,4,2,"وَسُلْطَانٍ مُّبِينٍ","حُجَّةٍ تَظْهَرُ لِمَنْ عَايَنَهَا."]]