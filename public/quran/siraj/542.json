[[0,5,1,"تُجَادِلُكَ","تُرَاجِعُكَ، وَهِيَ: خَوْلَةُ بِنْتُ ثَعْلَبَةَ."],[0,7,1,"زَوْجِهَا","أَوْسِ بْنِ الصَّامِتِ."],[1,1,1,"يُظَاهِرُونَ","يَقُولُ الرَّجُلُ لِامْرَأَتِهِ: أَنْتِ عَلَيَّ كَظَهْرِ أُمِّي."],[1,8,2,"إِنْ أُمَّهَاتُهُمْ","مَا أُمَّهَاتُهُمْ."],[1,15,1,"مُنكَرًا","فَظِيعًا."],[1,18,1,"وَزُورًا","كَذِبًا."],[2,5,1,"يَعُودُونَ","يَرْجِعُونَ عَنْ قَوْلِهِمْ، وَيَعْزِمُونَ عَلَى وَطْءِ نِسَائِهِمْ."],[2,8,2,"فَتَحْرِيرُ رَقَبَةٍ","عِتْقُ رَقَبَةٍ مُؤْمِنَةٍ؛ عَبْدٍ، أَوْ أَمَةٍ."],[2,13,1,"يَتَمَاسَّا","يَسْتَمْتِعَا بِالجِمَاعِ."],[4,2,1,"يُحَادُّونَ","يُشَاقُّونَ وَيُخَالِفُونَ."],[4,5,1,"كُبِتُوا","خُذِلُوا، وَأُهِينُوا."]]