[[1,12,1,"الصَّاغِرِينَ","الْحَقِيرِينَ، الذَّلِيلِينَ."],[2,1,1,"أَنظِرْنِي","أَمْهِلْنِي."],[4,3,1,"لأَقْعُدَنَّ","لَأَتَرَصَّدَنَّهُمْ، وَأَصُدَّنَّهُمْ."],[6,3,1,"مَذْؤُومًا","مَمْقُوتًا، مَذْمُومًا."],[6,4,1,"مَّدْحُورًا","مَطْرُودًا."],[8,5,2,"مَا وُورِيَ","مَا سُتِرَ، وَأُخْفِيَ."],[8,9,1,"سَوْءَاتِهِمَا","عَوْرَاتِهِمَا."],[9,0,1,"وَقَاسَمَهُمَا","أَقْسَمَ وَحَلَفَ لَهُمَا."],[10,0,1,"فَدَلَّاهُمَا","فَجَرَّأَهُمَا، وَغَرَّهُمَا."],[10,8,1,"وَطَفِقَا","شَرَعَا، وَأَخَذَا."],[10,9,1,"يَخْصِفَانِ","يَلْزِقَانِ."]]