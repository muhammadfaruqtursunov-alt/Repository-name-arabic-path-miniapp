[[0,1,2,"لَعِلْمٌ لِّلسَّاعَةِ","إِنَّ نُزُولَ عِيسَى - عليه السلام - لَدَلِيلٌ عَلَى قُرْبِ وُقُوعِ السَّاعَةِ."],[0,3,2,"فَلَا تَمْتَرُنَّ","لَا تَشُكُّوا."],[0,8,2,"صِرَاطٌ مُّسْتَقِيمٌ","طَرِيقٌ قَوِيمٌ إِلَى الجَنَّةِ لَا عِوَجَ فِيهِ."],[2,7,1,"بِالْحِكْمَةِ","بِالنُّبُوَّةِ."],[4,1,1,"الْأَحْزَابُ","الفِرَقُ."],[4,4,1,"فَوَيْلٌ","هَلَاكٌ، وَدَمَارٌ."],[5,1,1,"يَنظُرُونَ","يَنْتَظِرُونَ."],[5,6,1,"بَغْتَةً","فَجْأَةً."],[6,0,1,"الْأَخِلَّاءُ","الأَصْدِقَاءُ، وَالأَحْبَابُ."],[9,4,1,"تُحْبَرُونَ","تُنْعَّمُونَ، وَتُسَرُّونَ."],[10,2,1,"بِصِحَافٍ","بِأَوَانٍ."]]