[[0,0,1,"سُبْحَانَ","تَنْزِيهًا للِه، وَتَعَجُّبَا مِنْ قُدْرَتِهِ."],[1,11,1,"وَكِيلًا","مَعْبُودًا تُفَوِّضُونَ أُمُورَكُمْ إِلَيْهِ."],[3,0,1,"وَقَضَيْنَا","أَخْبَرْنَا، وَأَوْحَيْنَا."],[4,8,2,"أُوْلِي بَاسٍ","ذَوِي شَجَاعَةٍ وَقُوَّةٍ."],[4,11,1,"فَجَاسُوا","فَطَافُوا."],[4,12,2,"خِلَالَ الدِّيَارِ","وَسَطَهَا."],[5,3,1,"الْكَرَّةَ","الغَلَبَةَ وَالظُّهُورَ."],[5,10,1,"نَفِيرًا","عَدَدًا."],[6,9,2,"وَعْدُ الآخِرَةِ","مَوْعِدُ الإِفْسَادِ الثَّانِي."],[6,11,1,"لِيَسُوؤُوا","لِيُذِلُّوا، وَيُهِينُوا."],[6,14,1,"الْمَسْجِدَ","بَيْتَ المَقْدِسِ."],[6,19,1,"وَلِيُتَبِّرُوا","لِيُدَمِّرُوا."],[6,20,2,"مَا عَلَوْا","مَا وَقَعَ تَحْتَ أَيْدِيهِمْ."],[6,22,1,"تَتْبِيرًا","تَدْمِيرًا كَامِلًا."]]