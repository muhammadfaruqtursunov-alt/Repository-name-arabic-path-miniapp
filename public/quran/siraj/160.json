[[0,7,1,"وَبَوَّأَكُمْ","أَسْكَنَكُمْ وَمَكَّنَ لَكُمْ."],[0,20,2,"وَلَا تَعْثَوْا","لَا تَسْعَوْا."],[3,0,1,"فَعَقَرُوا","فَقَتَلُوا."],[3,2,1,"وَعَتَوْا","اسْتَكْبَرُوا."],[4,1,1,"الرَّجْفَةُ","الزَّلْزَلَةُ الشَّدِيدَةُ."],[4,5,1,"جَاثِمِينَ","هَالِكِينَ، لَاصِقِينَ بِالأَرْضِ عَلَى رُكَبِهِمْ، وَوُجُوهِهِمْ."]]