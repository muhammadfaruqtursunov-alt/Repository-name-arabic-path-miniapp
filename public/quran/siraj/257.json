[[3,7,1,"مَقَامِي","مَوْقِفَهُ بَيْنَ يَدَيَّ لِلْحِسَابِ."],[4,0,1,"وَاسْتَفْتَحُوا","اسْتَنْصَرَ الرُّسُلُ بِاللهِ عَلَى الظَّالِمِينَ."],[4,1,1,"وَخَابَ","هَلَكَ، وَخَسِرَ."],[5,1,1,"وَرَائِهِ","أَمَامِهِ."],[5,6,1,"صَدِيدٍ","القَيْحِ وَالدَّمِ الَّذِي يَسِيلُ مِنْ أَجْسَادِ أَهْلِ النَّارِ."],[6,0,1,"يَتَجَرَّعُهُ","يُحَاوِلُ ابْتِلَاعَهُ."],[6,1,3,"وَلَا يَكَادُ يُسِيغُهُ","لَا يَسْتَطِيعُ ابْتِلَاعَهُ؛ لِحَرَارَتِهِ وَقَذَارَتِهِ."],[6,12,2,"وَمِن وَرَائِهِ","مِنْ بَعْدِهِ."],[7,10,2,"يَوْمٍ عَاصِفٍ","شَدِيدِ هُبُوبِ الرِّيحِ."]]