[[0,27,2,"قُضِيَ بِالْحَقِّ","حُكِمَ بِالعَدْلِ بَيْنَ الرُّسُلِ، وَمُكَذِّبِيهِمْ."],[2,5,3,"حَاجَةً فِي صُدُورِكُمْ","أَمْرًا ذَا بَالٍ تَهْتَمُّونَ بِهِ."],[4,19,3,"فَمَا أَغْنَى عَنْهُم","فَمَا دَفَعَ عَنْهُمْ."],[5,7,2,"مِّنَ الْعِلْمِ","العِلْمِ بِالدُّنْيَا، وَبِمَا عِنْدَهُمْ مِنَ الأَبَاطِيلِ الَّتِي يّظُنُّونَهَا عِلْمًا."],[5,9,1,"وَحَاقَ","نَزَلَ وَأَحَاطَ."],[6,2,1,"بَاسَنَا","عَذَابَنَا."],[7,1,1,"يَكُ","يَكُنْ."],[7,7,2,"سُنَّتَ اللَّهِ","طَرِيَقَتَهُ فِي عَدَمِ قَبُولِ تَوْبَةِ مَنْ عَايَنَ العَذَابَ."],[7,11,1,"خَلَتْ","مَضَتْ."]]