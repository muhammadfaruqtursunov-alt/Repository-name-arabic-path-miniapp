[[0,13,2,"وَتَزْهَقَ أَنفُسُهُمْ","تَخْرُجَ أَرْوَاحُهُمْ."],[1,9,1,"يَفْرَقُونَ","يَخَافُونَ."],[2,2,1,"مَلْجَأً","مَامَنًا، وَحِصْنًا."],[2,4,1,"مَغَارَاتٍ","كُهُوفًا فِي الجِبَالِ."],[2,6,1,"مُدَّخَلًا","نَفَقًا."],[2,10,1,"يَجْمَحُونَ","يُسْرِعُونَ."],[3,2,1,"يَلْمِزُكَ","يَعِيبُكَ."],[4,8,2,"حَسْبُنَا اللهُ","كَافِينَا اللهُ."],[5,2,1,"لِلْفُقَرَاءِ","لِلَّذِينَ لَا يَمْلِكُونَ شَيْئًا."],[5,3,1,"وَالْمَسَاكِينِ","الَّذِينَ يَمْلِكُونَ دُونَ كِفَايَتِهِمْ."],[5,4,2,"وَالْعَامِلِينَ عَلَيْهَا","السُّعَاةِ الَّذِينَ يَجْمَعُونَ الزَّكَاةَ."],[5,6,2,"وَالْمُؤَلَّفَةِ قُلُوبُهُمْ","مَنْ يُرْجَى إِسْلَامُهُمْ، أَوْ دَفْعُ شَرِّهِمْ."],[5,9,1,"الرِّقَابِ","عِتْقِ الأَرِقَّاءِ، وَفَكَاكِ الأَسْرَى."],[5,10,1,"وَالْغَارِمِينَ","المَدِينِينَ، وَمَنْ غَرِمُوا لِإِصْلَاحِ ذَاتِ البَيْنِ."],[5,11,3,"وَفِي سَبِيلِ اللهِ","فِي الِجهَادِ."],[5,14,2,"وَابْنِ السَّبِيلِ","المُسَافِرِ، المُنْقَطِعِ."],[6,6,1,"أُذُنٌ","يَسْتَمِعُ لِكُلِّ مَا يُقَالُ لَهُ، فَيُصَدِّقُهُ."],[6,13,2,"وَيُؤْمِنُ لِلْمُؤْمِنِينَ","يُصَدِّقُ المُؤْمِنِينَ فِيمَا يُخْبِرُونَهُ."]]