[[0,2,1,"الْجَوَارِ","السُّفُنُ الجَارِيَةُ."],[0,5,1,"كَالْأَعْلَامِ","كَالجِبَالِ فِي عِظَمِهَا."],[1,4,1,"فَيَظْلَلْنَ","يَصِرْنَ وَيَبْقَيْنَ."],[1,5,1,"رَوَاكِدَ","ثَوَابِتَ لَا تَجْرِي."],[2,1,1,"يُوبِقْهُنَّ","يُهْلِكِ السُّفُنَ بِالغَرَقِ."],[3,8,1,"مَّحِيصٍ","مَهْرَبٍ، وَمَلْجَأٍ."],[5,4,1,"وَالْفَوَاحِشَ","مَا عَظُمَ قُبْحُهُ مِنَ المَعَاصِي."],[7,3,1,"الْبَغْيُ","الظُّلْمُ، وَالعُدْوَانُ."],[7,5,1,"يَنتَصِرُونَ","يَنْتَقِمُونَ مِمَّنْ بَغَى عَلَيْهِمْ؛ لِشَجَاعَتِهِمْ، وَلَا يَعْتَدُونَ."],[8,6,1,"وَأَصْلَحَ","وَضَعَ عَفْوَهُ فِيمَنْ يُصْلِحُهُ العَفْوُ."],[9,8,1,"سَبِيلٍ","مُؤَاخَذَةٍ."],[10,1,1,"السَّبِيلُ","المُؤَاخَذَةُ."],[10,6,1,"وَيَبْغُونَ","يَعْتَدُونَ."],[11,6,2,"عَزْمِ الْأُمُورِ","الأَفْعَالِ الحَمِيدَةِ، وَالخِصَالِ المَشْكُورَةِ."],[12,1,2,"يُضْلِلِ اللَّهُ","يَصْرِفْهُ عَنِ الهُدَى."],[12,17,1,"مَرَدٍّ","مَرْجِعٍ إِلَى الدُّنْيَا."],[12,19,1,"سَبِيلٍ","طَرِيقٍ."]]