[[0,7,2,"صِرَاطِ الْحَمِيدِ","طَرِيقِ الإِسْلَامِ المَحْمُودِ."],[1,13,2,"الْعَاكِفُ فِيهِ","المُقِيمُ فِيهِ."],[1,15,1,"وَالْبَادِ","القَادِمُ إِلَيْهِ."],[1,17,1,"يُرِدْ","يَهُمَّ."],[1,19,2,"بِإِلْحَادٍ بِظُلْمٍ","بِمَيْلٍ عَنِ الحَقِّ ظُلْمًا."],[2,1,1,"بَوَّانَا","هَيَّانَا، وَبَيَّنَّا."],[3,0,1,"وَأَذِّنْ","نادِ وَأَعْلِمْ رَافِعًا صَوْتَكَ."],[3,5,1,"رِجَالًا","يَمْشُونَ عَلَى أَقْدَامِهِمْ؛ جَمْعُ رَاجِلٍ."],[3,8,1,"ضَامِرٍ","البَعِيرِ خَفِيفِ اللَّحْمِ مِنَ الأَعْمَالِ لَا مِنَ الهُزَالِ."],[3,12,2,"فَجٍّ عَمِيقٍ","طَرِيقٍ بَعِيدٍ."],[4,7,2,"أَيَّامٍ مَّعْلُومَاتٍ","هِيَ: عَشْرُ ذِي الحِجَّةِ، وَثَلَاثَةُ أَيَّامٍ بَعْدَهُ."],[4,18,2,"الْبَائِسَ الْفَقِيرَ","الَّذِي اشْتَدَّ فَقْرُهُ."],[5,1,2,"لْيَقْضُوا تَفَثَهُمْ","لِيُكْمِلُوا حَجَّهُمْ بِإِحْلَالِهِمْ مِنْ إِحْرَامِهِمْ وَإِزَالَةِ وَسَخِ أَبْدَانِهِمْ."],[5,4,1,"نُذُورَهُمْ","الحَجَّ، وَالعُمْرَةَ، وَالهَدَايَا."],[5,7,1,"الْعَتِيقِ","القَدِيمِ الَّذِي أَعْتَقَهُ اللهُ، مِنْ تَسَلُّطِ الجَبَّارِينَ عَلَيْهِ."],[6,3,2,"حُرُمَاتِ اللَّهِ","شَعَائِرَ الدِّينِ، وَمَنَاسِكَ الحَجِّ."],[6,18,3,"الرِّجْسَ مِنَ الْأَوْثَانِ","القَذَارَةَ الَّتِي هِيَ: الأَوْثَانُ."],[6,22,2,"قَوْلَ الزُّورِ","الكَذِبَ وَالاِفْتِرَاءَ عَلَى اللهِ."]]