[[1,6,1,"بِنَبَأٍ","بِخَبَرٍ."],[1,7,1,"فَتَبَيَّنُوا","فَتَثَبَّتُوا مِنْ خَبَرِهِ."],[1,8,2,"أَن تُصِيبُوا","خَشْيَةَ أَنْ تُصِيبُوا."],[2,11,1,"لَعَنِتُّمْ","لَأَدَّى إِلَى مَشَقَّتِكُمْ، وَعَنَتِكُمْ."],[4,8,1,"بَغَتْ","اعْتَدَتْ."],[4,16,1,"تَفِيءَ","تَرْجِعَ إِلَى حُكْمِ اللهِ وَرَسُولِهِ."],[4,25,1,"وَأَقْسِطُوا","اعْدِلُوا."],[4,29,1,"الْمُقْسِطِينَ","العَادِلِينَ فِي أَحْكَامِهِمْ."],[6,3,2,"لَا يَسْخَرْ","لَا يَهْزَا، وَيَنْتَقِصْ."],[6,5,1,"قَومٌ","رِجَالٌ."],[6,22,2,"وَلَا تَلْمِزُوا","لَا يَعِبْ، وَلَا يَطْعَنْ بَعْضُكُمْ بَعْضًا."],[6,25,3,"وَلَا تَنَابَزُوا بِالْأَلْقَابِ","لَا يَدْعُ بَعْضُكُمْ بَعْضًا بِمَا يَكْرَهُ مِنَ الأَلْقَابِ."],[6,28,3,"بِئْسَ الاِسْمُ الْفُسُوقُ","قَبُحَ الاِسْمُ وَالصِّفَةُ الفُسُوقُ؛ وَهُوَ: السُّخْرِيَةُ، وَاللَّمْزُ، وَالتَّنَابُزُ."],[6,31,2,"بَعْدَ الْإِيمَانِ","بَعْدَمَا دَخَلْتُمْ فِي الإِسْلَامِ."]]