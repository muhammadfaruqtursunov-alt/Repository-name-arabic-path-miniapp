[[0,1,2,"فَمَا خَطْبُكُمْ","مَا شَانُكُمْ؟"],[3,0,1,"مُسَوَّمَةً","مُعَلَّمَةً بِأَنَّهَا لِعَذَابِ المُسْرِفِينَ."],[6,1,2,"فِيهَا آيَةً","فِي قَرْيَتِهِمْ أَثَرًا مِنَ العَذَابِ بَاقِيًا؛ عَلَامَةً عَلَى قُدْرَةِ اللهِ."],[7,0,2,"وَفِي مُوسَى","فِي إِرْسَالِنَا مُوسَى - عليه السلام -: آيَةٌ لِلَّذِينَ يَخَافُونَ العَذَابَ."],[7,6,2,"بِسُلْطَانٍ مُّبِينٍ","بِآيَاتٍ، وَمُعْجِزَاتٍ ظَاهِرَةٍ."],[8,0,2,"فَتَوَلَّى بِرُكْنِهِ","أَعْرَضَ فِرْعَوْنُ؛ مُغْتَرًّا بِقُوَّتِهِ وَجَانِبِهِ."],[9,2,3,"فَنَبَذْنَاهُمْ فِي الْيَمِّ","طَرَحْنَاهُمْ فِي البَحْرِ."],[9,6,1,"مُلِيمٌ","آتٍ بِمَا يُلاُم عَلَيْهِ."],[10,6,1,"الْعَقِيمَ","الَّتِي لَا بَرَكَةَ فِيهَا، وَلَا تَاتِي بِخَيْرٍ."],[11,0,2,"مَا تَذَرُ","مَا تَدَعُ."],[11,8,1,"كَالرَّمِيمِ","كَالشَّيْءِ البَالِي."],[12,5,3,"تَمَتَّعُوا حَتَّى حِينٍ","انْتَفِعُوا بِحَيَاتِكُمْ حَتَّى تَنْتَهِيَ آجَالُكُمْ."],[13,0,1,"فَعَتَوْا","تَكَبَّرُوا، وَعَصَوْا."],[13,5,1,"الصَّاعِقَةُ","الصَّيْحَةُ المُهْلِكَةُ."],[14,2,2,"مِن قِيَامٍ","مِنْ نُهُوضٍ، وَلَا هَرَبٍ."],[16,2,1,"بِأَيْدٍ","بِقُوَّةٍ، وَقُدْرَةٍ عَظِيمَةٍ."],[17,1,1,"فَرَشْنَاهَا","مَهَّدْنَاهَا، وَبَسَطْنَاهَا."],[18,4,1,"زَوْجَيْنِ","صِنْفَيْنِ، وَنَوْعَيْنِ مُخْتَلِفَيْنِ."]]