[[0,2,1,"الْحَسْرَةِ","النَّدَامَةِ."],[2,6,1,"صِدِّيقًا","عَظِيمَ الصِّدْقِ لَا يَكْذِبُ."],[4,11,2,"صِرَاطًا سَوِيًّا","طَرِيقًا لَا عِوَجَ فِيهِ."],[6,10,1,"وَلِيًّا","قَرِينًا فِي النَّارِ."],[7,11,1,"مَلِيًّا","زَمَنًا طَوِيلًا."],[8,9,1,"حَفِيًّا","رَحِيمًا بِحَالِي يُكْرِمُنِي وَيُجِيبُنِي إِذَا دَعَوْتُهُ."],[11,6,3,"لِسَانَ صِدْقٍ عَلِيًّا","ذِكْرًا حَسَنًا، وَثَنَاءً بَاقِيًا فِي النَّاسِ."],[12,6,1,"مُخْلَصًا","مُصْطَفًى مُخْتَارًا."]]