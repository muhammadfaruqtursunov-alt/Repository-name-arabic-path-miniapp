[[0,4,1,"فَاسْتَقِيمَا","فاثْبُتَا عَلَى الدِّينِ، واسْتَمِرَّا علَى الدَّعْوَةِ."],[0,5,2,"وَلَا تَتَّبِعَانِّ","لَا تَسْلُكَانِّ."],[1,0,1,"وَجَاوَزْنَا","قَطَعْنَا."],[1,7,2,"بَغْيًا وَعَدْوًا","ظُلْمًا، وَعُدْوَانًا."],[3,1,1,"نُنَجِّيكَ","نُخْرِجُكَ مِنَ البَحْرِ، وَنَجْعَلُكَ عَلَى مُرْتَفِعٍ مِنَ الأَرْضِ."],[3,6,1,"آيَةً","عِبْرَةً."],[4,1,1,"بَوَّانَا","أَنْزَلْنَا."],[4,4,2,"مُبَوَّأَ صِدْقٍ","مَنْزِلًا صَالِحًا بِالشَّامِ وَمِصْرَ."],[5,21,1,"الْمُمْتَرِينَ","الشَّاكِّينَ."],[7,2,1,"حَقَّتْ","وَجَبَتْ."]]