ā"],["خَزَآئِنِ",1873,[],[],"(the) treasuries","сокровищницами","khazāini"],["ٱلْأَرْضِ ۖ",78,[1],[],"(of) the land","земли","l-arḍi"],["إِنِّى",46,[],[23],"Indeed, I","поистине, я –","innī"],["حَفِيظٌ",1586,[],[],"(will be) a guardian","хранитель","ḥafīẓun"],["عَلِيمٌۭ",209,[],[],"knowing","знающий","ʿalīmun"]]},{"k":"12:56","w":[["وَكَذَٰلِكَ",24,[3,14],[],"And thus","И таким образом","wakadhālika"],["مَكَّنَّا",1834,[],[4],"We established","утвердили Мы","makkannā"],["لِيُوسُفَ",1916,[2],[],"[to] Yusuf","для Йусуфа","liyūsufa"],["فِى",27,[],[],"in","на","fī"],["ٱلْأَرْضِ",78,[1],[],"the land","земле","l-arḍi"],["يَتَبَوَّأُ",2480,[],[],"to settle","поселяясь","yatabawwa-u"],["مِنْهَا",34,[],[20],"therein","на ней","min'hā"],["حَيْثُ",235,[],[],"where ever","где","ḥaythu"],["يَشَآءُ ۚ",137,[],[],"he willed","пожелает","yashāu"],["نُصِيبُ",667,[],[],"We bestow","Одариваем Мы","nuṣību"],["بِرَحْمَتِنَا",385,[0],[4],"Our Mercy","Своей милостью","biraḥmatinā"],["مَن",61,[],[],"(on) whom","кого","man"],["نَّشَآءُ ۖ",137,[],[],"We will","пожелаем","nashāu"],["وَلَا",21,[3],[],"And not","и не","walā"],["نُضِيعُ",647,[],[],"We let go waste","губим Мы","nuḍīʿu"],["أَجْرَ",378,[],[],"(the) reward","награды","ajra"],["ٱلْمُحْسِنِينَ",338,[1],[],"(of) the good-doers","добродеющих","l-muḥ'sinīna"]]},{"k":"12:57","w":[["وَلَأَجْرُ",378,[3,17],[],"And surely (the) reward","И, однозначно, награда","wala-ajru"],["ٱلْـَٔاخِرَةِ",41,[1],[],"(of) the Hereafter","Последней жизни","l-ākhirati"],["خَيْرٌۭ",320,[],[],"(is) better","лучше","khayrun"],["لِّلَّذِينَ",16,[2],[],"for those who","для тех, которые","lilladhīna"],["ءَامَنُوا۟",30,[],[6],"believe","уверовали","āmanū"],["وَكَانُوا۟",73,[3],[6],"and are","и были","wakānū"],["يَتَّقُونَ",144,[],[6],"God conscious","остерегающимися (наказания Аллаха","yattaqūna"]]},{"k":"12:58","w":[["وَجَآءَ",418,[3],[],"And came","И пришли","wajāa"],["إِخْوَةُ",1463,[],[],"(the) brothers","братья","ikh'watu"],["يُوسُفَ",1916,[],[],"(of) Yusuf",