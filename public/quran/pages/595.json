{"p":595,"juz":30,"hizb":60,"a":[{"k":"90:19","w":[["وَٱلَّذِينَ",16,[3],[],"But those who","А те, которые","wa-alladhīna"],["كَفَرُوا۟",47,[],[6],"disbelieve","стали неверующими","kafarū"],["بِـَٔايَـٰتِنَا",256,[0],[4],"in Our Verses","в Наши знамения","biāyātinā"],["هُمْ",42,[],[],"they","они –","hum"],["أَصْحَـٰبُ",257,[],[],"(are the) companions","обладатели","aṣḥābu"],["ٱلْمَشْـَٔمَةِ",4271,[1],[],"(of) the left (hand)","злополучия","l-mashamati"]]},{"k":"90:20","w":[["عَلَيْهِمْ",18,[],[6],"Over them","над ними –","ʿalayhim"],["نَارٌۭ",103,[],[],"(will be the) Fire","огонь","nārun"],["مُّؤْصَدَةٌۢ",4719,[],[],"closed in","сведённый [сомкнутый]","mu'ṣadatun"]]},{"k":"91:1","w":[["وَٱلشَّمْسِ",1029,[35,1],[],"By the sun","Клянусь солнцем","wal-shamsi"],["وَضُحَىٰهَا",2127,[3],[20],"and its brightness","и его сиянием","waḍuḥāhā"]]},{"k":"91:2","w":[["وَٱلْقَمَرِ",1911,[3,1],[],"And the moon","и луной","wal-qamari"],["إِذَا",75,[],[],"when","когда","idhā"],["تَلَىٰهَا",276,[],[20],"it follows it","она следует за ним","talāhā"]]},{"k":"91:3","w":[["وَٱلنَّهَارِ",685,[3,1],[],"And the day","и днем","wal-nahāri"],["إِذَا",75,[],[],"when","когда","idhā"],["جَلَّىٰهَا",2209,[],[20],"it displays it","он являет его","jallāhā"]]},{"k":"91:4","w":[["وَٱلَّيْلِ",684,[3,1],[],"And the night","и ночью","wa-al-layli"],["إِذَا",75,[],[],"when","когда","idhā"],["يَغْشَىٰهَا",1368,[],[20],"it covers it","она покрывает его","yaghshāhā"]]},{"k":"91:5","w":[["وَٱلسَّمَآءِ",119,[3,1],[],"And the heaven","и небом","wal-samāi"],["وَمَا",37,[3],[],"and (He) Who","и Тем","wamā"],["بَنَىٰهَا",2408,[],[20],"constructed it","Кто его построил","banāhā"]]},{"k":"91:6","w":[["وَٱلْأَرْضِ",78,[3,1],[],"And the earth","и землей","wal-arḍi"],["وَمَا",37,[3],[],"and by (He) Who","и Тем","wamā"],["طَحَىٰهَا",4720,[],[20],"spread it","Кто распростер ее","ṭaḥāhā"]]},{"k":"91:7","w":[["وَنَفْسٍۢ",68,[3],[],"And (the) soul","и всякой душой","wanafsin"],["وَمَا",37,[3],[],"and (He) Who","и Тем","wamā"],["سَوَّىٰهَا",207,[],[20],"proportioned it","Кто её устроил","sawwāhā"]]},{"k":"91:8","w":[["فَأَلْهَمَهَا",4721,[16],[20],"And He inspired it","и внушил [разъяснил] ей","fa-alhamahā"],["فُجُورَهَا",4722,[],[20],"(to distinguish) its wickedness","её грехолюбие (порочность, распущенность","fujūrahā"],["وَتَقْوَىٰهَا",818,[3],[20],"and its righteousness","и её остережение (от грехов","wataqwāhā"]]},{"k":"91:9","w":[["قَدْ",350,[],[],"Indeed","Действительно","qad"],["أَفْلَحَ",783,[],[],"he succeeds","преуспел","aflaḥa"],["مَن",61,[],[],"who","тот, кто","man"],["زَكَّىٰهَا",619,[],[20],"purifies it","очистил ее","zakkāhā"]]},{"k":"91:10","w":[["وَقَدْ",350,[3],[],"And indeed","и действительно","waqad"],["خَابَ",2758,[],[],"he fails","понес урон","khāba"],["مَن",61,[],[],"who","тот, кто","man"],["دَسَّىٰهَا",4723,[],[20],"buries it","утаил ее","dassāhā"]]},{"k":"91:11","w":[["كَذَّبَتْ",255,[],[],"Denied","Сочли лжецом","kadhabat"],["ثَمُودُ",2102,[],[],"Thamud","самудиты","thamūdu"],["بِطَغْوَىٰهَآ",4724,[0],[20],"by their transgression","из-за своего беззакония","biṭaghwāhā"]]},{"k":"91:12","w":[["إِذِ",210,[],[],"When","Вот","idhi"],["ٱنۢبَعَثَ",4725,[],[],"(was) sent forth","вызвался","inbaʿatha"],["أَشْقَىٰهَا",4677,[],[20],"(the) most wicked of them","несчастнейший из них","ashqāhā"]]},{"k":"91:13","w":[["فَقَالَ",62,[11],[],"But said","и сказал","faqāla"],["لَهُمْ",76,[2],[],"to them","им","lahum"],["رَسُولُ",478,[],[],"(the) Messenger","посланник","rasūlu"],["ٱللَّهِ",1,[],[],"(of) Allah","Аллаха","l-lahi"],["نَاقَةَ",2103,[],[],"(It is the) she-camel","Оставьте) верблюдицу","nāqata"],["ٱللَّهِ",1,[],[],"(of) Allah","Аллаха","l-lahi"],["وَسُقْيَـٰهَا",4726,[3],[20],"and her drink","и питьё её","wasuq'yāhā"]]},{"k":"91:14","w":[["فَكَذَّبُوهُ",255,[11],[6,7],"But they denied him","И сочли они его лжецом","fakadhabūhu"],["فَعَقَرُوهَا",2108,[16],[6,20],"and they hamstrung her","и подрезали ее","faʿaqarūhā"],["فَدَمْدَمَ",4727,[25],[],"So destroyed","и истребил","fadamdama"],["عَلَيْهِمْ",18,[],[6],"them","их","ʿalayhim"],["رَبُّهُم",5,[],[6],"their Lord","Господь их","rabbuhum"],["بِذَنۢبِهِمْ",1159,[0],[6],"for their sin","за их грех","bidhanbihim"],["فَسَوَّىٰهَا",207,[16],[20],"and leveled them","и сделал его одинаковым (для всех","fasawwāhā"]]},{"k":"91:15","w":[["وَلَا",21,[3],[],"And not","и не","walā"],["يَخَافُ",742,[],[],"He fears","боясь","yakhāfu"],["عُقْبَـٰهَا",2742,[],[20],"its consequences","последствий этого","ʿuq'bāhā"]]},{"k":"92:1","w":[["وَٱلَّيْلِ",684,[35,1],[],"By the night","Клянусь ночью","wa-al-layli"],["إِذَا",75,[],[],"when","когда","idhā"],["يَغْشَىٰ",1368,[],[],"it covers","она покрывает","yaghshā"]]},{"k":"92:2","w":[["وَٱلنَّهَارِ",685,[3,1],[],"And the day","и днём","wal-nahāri"],["إِذَا",75,[],[],"when","когда","idhā"],["تَجَلَّىٰ",2160,[],[],"it shines in brightness","он озаряется светом","tajallā"]]},{"k":"92:3","w":[["وَمَا",37,[3],[],"And He Who","и (клянусь) тем, Кто","wamā"],["خَلَقَ",142,[],[],"created","создал","khalaqa"],["ٱلذَّكَرَ",1200,[1],[],"the male","мужской пол","l-dhakara"],["وَٱلْأُنثَىٰٓ",733,[3,1],[],"and the female","и женский, –","wal-unthā"]]},{"k":"92:4","w":[["إِنَّ",46,[],[],"Indeed","Поистине","inna"],["سَعْيَكُمْ",1048,[],[12],"your efforts","стремления [деяния] ваши","saʿyakum"],["لَشَتَّىٰ",3236,[17],[],"(are) surely diverse","однозначно, различны","lashattā"]]},{"k":"92:5","w":[["فَأَمَّا",184,[11],[],"Then as for","Что же касается","fa-ammā"],["مَنْ",61,[],[],"(him) who","того, кто","man"],["أَعْطَىٰ",2325,[],[],"gives","давал","aʿṭā"],["وَٱتَّقَىٰ",144,[3],[],"and fears","и остерегался","wa-ittaqā"]]},{"k":"92:6","w":[["وَصَدَّقَ",3662,[3],[],"And believes","и признал истинность","waṣaddaqa"],["بِٱلْحُسْنَىٰ",1615,[0,1],[],"in the best","наилучшего, –","bil-ḥus'nā"]]},{"k":"92:7","w":[["فَسَنُيَسِّرُهُۥ",3205,[19,29],[7],"Then We will ease him","тому Мы облегчим","fasanuyassiruhu"],["لِلْيُسْرَىٰ",4675,[2,1],[],"towards [the] ease","к легчайшему","lil'yus'rā"]]},{"k":"92:8","w":[["وَأَمَّا",184,[3],[],"But as for","А что касается","wa-ammā"],["مَنۢ",61,[],[],"(him) who","того, кто","man"],["بَخِلَ",1403,[],[],"withholds","скупился","bakhila"],["وَٱسْتَغْنَىٰ",4363,[3],[],"and considers himself free from need","и считал себя ни в чём не нуждающимся","wa-is'taghnā"]]},{"k":"92:9","w":[["وَكَذَّبَ",255,[3],[],"And denies","и считал ложью","wakadhaba"],["بِٱلْحُسْنَىٰ",1615,[0,1],[],"the best","прекраснейшее, –","bil-ḥus'nā"]]}]}