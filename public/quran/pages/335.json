еты","ḥurumāti"],["ٱللَّهِ",1,[],[],"(of) Allah","Аллаха –","l-lahi"],["فَهُوَ",115,[11],[],"then it","то это","fahuwa"],["خَيْرٌۭ",320,[],[],"(is) best","лучше","khayrun"],["لَّهُۥ",76,[2],[],"for him","для него","lahu"],["عِندَ",321,[],[],"near","пред","ʿinda"],["رَبِّهِۦ ۗ",5,[],[7],"his Lord","его Господом","rabbihi"],["وَأُحِلَّتْ",766,[3],[],"And are made lawful","И разрешены","wa-uḥillat"],["لَكُمُ",76,[2],[],"to you","вам","lakumu"],["ٱلْأَنْعَـٰمُ",1171,[1],[],"the cattle","скоты","l-anʿāmu"],["إِلَّا",67,[],[],"except","кроме","illā"],["مَا",37,[],[],"what","того, о чем","mā"],["يُتْلَىٰ",276,[],[],"is recited","читается","yut'lā"],["عَلَيْكُمْ ۖ",18,[],[12],"to you","вам","ʿalaykum"],["فَٱجْتَنِبُوا۟",1507,[11],[12],"So avoid","Отстраняйтесь же от","fa-ij'tanibū"],["ٱلرِّجْسَ",1807,[1],[],"the abomination","мерзости","l-rij'sa"],["مِنَ",34,[],[],"of","из","mina"],["ٱلْأَوْثَـٰنِ",3379,[1],[],"the idols","идолов","l-awthāni"],["وَٱجْتَنِبُوا۟",1507,[3],[12],"and avoid","и отстраняйтесь","wa-ij'tanibū"],["قَوْلَ",340,[],[],"(the) word","от речей","qawla"],["ٱلزُّورِ",3380,[1],[],"false","лжи","l-zūri"]]}]}